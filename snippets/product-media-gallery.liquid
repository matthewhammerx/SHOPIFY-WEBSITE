  <script>
    (() => {
      const sectionId = "{{ section.id }}";
      const galleryId = `MediaGallery-${sectionId}`;

      function initHerbansGallery() {
        const root = document.getElementById(galleryId);
        if (!root || root.dataset.herbansReady === "true") return;

        const slider = root.querySelector(`#Slider-Gallery-${sectionId}`);
        if (!slider) return;

        root.dataset.herbansReady = "true";

        function visibleSlides() {
          return Array.from(root.querySelectorAll(".product__media-item")).filter((slide) => {
            return !slide.classList.contains("hidden") && slide.offsetParent !== null;
          });
        }

        function getClosestIndex() {
          const slides = visibleSlides();
          if (!slides.length) return 0;

          let closestIndex = 0;
          let smallestDistance = Infinity;

          slides.forEach((slide, index) => {
            const distance = Math.abs(slider.scrollLeft - slide.offsetLeft);
            if (distance < smallestDistance) {
              smallestDistance = distance;
              closestIndex = index;
            }
          });

          return closestIndex;
        }

        function updateThumbs(activeSlide) {
          const mediaId = activeSlide ? activeSlide.dataset.mediaId : null;
          const thumbs = Array.from(root.querySelectorAll(".thumbnail"));

          thumbs.forEach((thumb) => {
            const item = thumb.closest("[data-target]");
            const target = item ? item.dataset.target : null;

            if (target && mediaId && target === mediaId) {
              thumb.setAttribute("aria-current", "true");
              thumb.classList.add("active");
            } else {
              thumb.removeAttribute("aria-current");
              thumb.classList.remove("active");
            }
          });
        }

        function scrollToSlide(slide, behavior = "smooth") {
          if (!slide) return;

          slider.scrollTo({
            left: slide.offsetLeft,
            behavior
          });

          updateThumbs(slide);
        }

        function scrollToIndex(index, behavior = "smooth") {
          const slides = visibleSlides();
          if (!slides.length) return;

          const cleanIndex = Math.max(0, Math.min(slides.length - 1, index));
          scrollToSlide(slides[cleanIndex], behavior);
        }

        root.querySelectorAll(".thumbnail").forEach((thumb) => {
          thumb.addEventListener("click", () => {
            const item = thumb.closest("[data-target]");
            if (!item) return;

            const target = item.dataset.target;
            const slide = root.querySelector(`.product__media-item[data-media-id="${target}"]`);

            setTimeout(() => {
              scrollToSlide(slide);
            }, 20);
          });
        });

        let scrollSettleTimer = null;

        slider.addEventListener("scroll", () => {
          if (scrollSettleTimer) clearTimeout(scrollSettleTimer);
          scrollSettleTimer = setTimeout(() => {
            const slides = visibleSlides();
            updateThumbs(slides[getClosestIndex()]);
          }, 100);
        }, { passive: true });

        window.addEventListener("resize", () => {
          scrollToIndex(getClosestIndex(), "auto");
        });

        scrollToIndex(0, "auto");
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHerbansGallery);
      } else {
        initHerbansGallery();
      }

      document.addEventListener("shopify:section:load", (event) => {
        if (event.detail && event.detail.sectionId === sectionId) {
          const root = document.getElementById(galleryId);
          if (root) root.dataset.herbansReady = "false";
          setTimeout(initHerbansGallery, 80);
        }
      });
    })();
  </script>
