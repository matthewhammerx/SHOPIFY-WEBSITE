{%- comment -%}
  Customer videos carousel (one block, up to 8 slots).
  Params: block – the "ugc_videos" block of lw-main-product
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign vis = ''
  unless s.show_desktop
    assign vis = vis | append: ' lw-hide-desktop'
  endunless
  unless s.show_mobile
    assign vis = vis | append: ' lw-hide-mobile'
  endunless
-%}
{%- if s.show_desktop or s.show_mobile -%}
<div class="lw-ugc{{ vis }}" style="--lw-ugc-cols: {{ s.columns_desktop }}; --lw-ugc-col-m: {{ 100 | divided_by: s.columns_mobile | minus: 4 }}%;" {{ block.shopify_attributes }}>
  {%- if s.heading != blank -%}<h3 class="lw-h lw-h--sm">{{ s.heading }}</h3>{%- endif -%}
  <div class="lw-slider" data-lw-slider style="--lw-cols: var(--lw-ugc-cols); --lw-cols-t: var(--lw-ugc-cols); --lw-col-m: var(--lw-ugc-col-m); --lw-gap: 10px;">
    <div class="lw-slider__track">
      {%- for i in (1..8) -%}
        {%- liquid
          assign k_video = 'video_' | append: i
          assign k_image = 'image_' | append: i
          assign k_caption = 'caption_' | append: i
          assign k_show = 'show_' | append: i
          assign video = s[k_video]
          assign image = s[k_image]
          assign caption = s[k_caption]
        -%}
        {%- unless s[k_show] -%}{%- continue -%}{%- endunless -%}
        <div class="lw-vid" data-lw-video>
          {%- if video != blank -%}
            {{ video | video_tag: playsinline: true, loop: true, muted: true, preload: 'metadata', image_size: '500x' }}
            <span class="lw-vid__play">{% render 'lw-icon', icon: 'play' %}</span>
          {%- elsif image != blank -%}
            {{ image | image_url: width: 500 | image_tag: loading: 'lazy' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'lw-placeholder' }}
          {%- endif -%}
          {%- if caption != blank -%}<span class="lw-vid__cap">{{ caption }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="lw-slider__nav"><div class="lw-slider__dots"{% unless s.show_dots %} hidden{% endunless %}></div>{%- if s.show_arrows -%}<div class="lw-slider__arrows">
      <button type="button" data-lw-prev aria-label="Previous">{% render 'lw-icon', icon: 'arrow-left' %}</button>
      <button type="button" data-lw-next aria-label="Next">{% render 'lw-icon', icon: 'arrow-right' %}</button>
    </div>{%- endif -%}</div>
  </div>
</div>
{%- endif -%}
