{% comment %}
  Meowgical - How It Works
  Day-by-day milestone breakdown (icon + title + bullet list) paired with a product image.
  Image sits on top on mobile, left column on desktop (position is a setting, defaults to left).
{% endcomment %}

{%- if section.settings.image_position == 'right' -%}
  {%- assign image_direction = 'row-reverse' -%}
{%- else -%}
  {%- assign image_direction = 'row' -%}
{%- endif -%}

<section id="how-it-works-{{ section.id }}" class="hiw-feature">
  <div class="hiw-inner">

    {% if section.settings.image != blank %}
      <div class="hiw-image">
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 860px) 600px, 100vw"
          alt="{{ section.settings.image.alt | escape }}"
          loading="eager"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      </div>
    {% endif %}

    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="hiw-header">
        {% if section.settings.heading != blank %}
          <h2 class="hiw-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="hiw-subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="hiw-content">

      {% if section.blocks.size > 0 %}
          <div class="hiw-milestones">
            {% for block in section.blocks %}
              {% assign icon_index = forloop.index0 | modulo: 3 %}
              <div class="hiw-milestone" {{ block.shopify_attributes }}>
                <div class="hiw-milestone-head">
                  <span class="hiw-milestone-icon">
                    {% if block.settings.icon != blank %}
                      <img src="{{ block.settings.icon | image_url: width: 60 }}" alt="" loading="lazy" width="26" height="26">
                    {% elsif icon_index == 0 %}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    {% elsif icon_index == 1 %}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 17l6-6 4 4 8-8M21 7v6M21 7h-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="6" cy="9" r="1.8" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="6" r="1.8" stroke="currentColor" stroke-width="1.4"/><circle cx="18" cy="9" r="1.8" stroke="currentColor" stroke-width="1.4"/><path d="M12 21c-3 0-5-1.8-5-4.2 0-2 1.6-3.3 2.6-4.4.8-.9 1.3-1.6 2.4-1.6s1.6.7 2.4 1.6c1 1.1 2.6 2.4 2.6 4.4 0 2.4-2 4.2-5 4.2z" stroke="currentColor" stroke-width="1.4"/></svg>
                    {% endif %}
                  </span>
                  {% if block.settings.day_label != blank %}
                    <h3 class="hiw-milestone-day">{{ block.settings.day_label }}</h3>
                  {% endif %}
                </div>
                {% if block.settings.bullets != blank %}
                  <div class="hiw-bullets">{{ block.settings.bullets }}</div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <div class="hiw-cta-wrap">
            <a href="{{ section.settings.button_link | default: '#product-form' }}" class="hiw-cta">
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}

        {% if section.settings.disclaimer != blank %}
          <div class="hiw-disclaimer">{{ section.settings.disclaimer }}</div>
        {% endif %}

    </div>
  </div>
</section>

<style>
  #how-it-works-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding:
      {{ section.settings.padding_top_mobile }}px
      {{ section.settings.padding_side_mobile }}px
      {{ section.settings.padding_bottom_mobile }}px;
  }

  #how-it-works-{{ section.id }} * {
    box-sizing: border-box;
  }

  #how-it-works-{{ section.id }} .hiw-inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: "image" "header" "content";
    row-gap: {{ section.settings.image_gap_mobile }}px;
  }

  #how-it-works-{{ section.id }} .hiw-image {
    grid-area: image;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
  }

  #how-it-works-{{ section.id }} .hiw-image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  #how-it-works-{{ section.id }} .hiw-header {
    grid-area: header;
    text-align: center;
  }

  #how-it-works-{{ section.id }} .hiw-content {
    grid-area: content;
    min-width: 0;
  }

  #how-it-works-{{ section.id }} .hiw-heading {
    margin: 0 0 {{ section.settings.heading_gap_mobile }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -.01em;
    overflow-wrap: break-word;
  }

  #how-it-works-{{ section.id }} .hiw-heading strong,
  #how-it-works-{{ section.id }} .hiw-heading em {
    color: {{ section.settings.heading_accent }};
    font-weight: inherit;
    font-style: italic;
  }

  #how-it-works-{{ section.id }} .hiw-subheading,
  #how-it-works-{{ section.id }} .hiw-subheading p {
    margin: 0 0 {{ section.settings.subheading_gap_mobile }}px;
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size_mobile }}px;
    line-height: 1.45;
    font-weight: 500;
  }

  #how-it-works-{{ section.id }} .hiw-milestones {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.milestone_gap_mobile }}px;
    margin-bottom: {{ section.settings.cta_gap_mobile }}px;
  }

  #how-it-works-{{ section.id }} .hiw-milestone {
    min-width: 0;
  }

  #how-it-works-{{ section.id }} .hiw-milestone-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  #how-it-works-{{ section.id }} .hiw-milestone-icon {
    flex: 0 0 auto;
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
  }

  #how-it-works-{{ section.id }} .hiw-milestone-icon svg,
  #how-it-works-{{ section.id }} .hiw-milestone-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #how-it-works-{{ section.id }} .hiw-milestone-day {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    color: {{ section.settings.milestone_day_color }};
    font-size: {{ section.settings.milestone_day_size_mobile }}px;
    font-weight: 800;
    letter-spacing: -.01em;
    overflow-wrap: break-word;
  }

  #how-it-works-{{ section.id }} .hiw-bullets {
    margin-left: {{ section.settings.icon_size_mobile | plus: 10 }}px;
  }

  #how-it-works-{{ section.id }} .hiw-bullets ul,
  #how-it-works-{{ section.id }} .hiw-bullets ol {
    margin: 0;
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #how-it-works-{{ section.id }} .hiw-bullets li,
  #how-it-works-{{ section.id }} .hiw-bullets p {
    margin: 0;
    color: {{ section.settings.bullet_text_color }};
    font-size: {{ section.settings.bullet_text_size_mobile }}px;
    line-height: 1.45;
    overflow-wrap: break-word;
  }

  #how-it-works-{{ section.id }} .hiw-bullets strong {
    font-weight: 700;
  }

  #how-it-works-{{ section.id }} .hiw-cta-wrap {
    margin-bottom: {{ section.settings.disclaimer_gap_mobile }}px;
    text-align: center;
  }

  #how-it-works-{{ section.id }} .hiw-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, {{ section.settings.button_width_mobile }}px);
    min-height: {{ section.settings.button_height_mobile }}px;
    padding: 14px 28px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: 999px;
    {% if section.settings.button_use_gradient %}
      background: linear-gradient(
        135deg,
        {{ section.settings.button_gradient_1 }},
        {{ section.settings.button_gradient_2 }}
      );
    {% else %}
      background: {{ section.settings.button_bg }};
    {% endif %}
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.button_text_size_mobile }}px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: .01em;
    box-shadow: {{ section.settings.button_shadow }};
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #how-it-works-{{ section.id }} .hiw-cta:hover {
    transform: translateY(-1px);
  }

  #how-it-works-{{ section.id }} .hiw-disclaimer,
  #how-it-works-{{ section.id }} .hiw-disclaimer p {
    margin: 0;
    color: {{ section.settings.disclaimer_color }};
    font-size: {{ section.settings.disclaimer_size_mobile }}px;
    line-height: 1.4;
    font-style: italic;
    text-align: center;
  }

  @media screen and (min-width: 860px) {
    #how-it-works-{{ section.id }} {
      padding:
        {{ section.settings.padding_top_desktop }}px
        {{ section.settings.padding_side_desktop }}px
        {{ section.settings.padding_bottom_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-header {
      text-align: center;
      margin-bottom: {{ section.settings.header_gap_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-subheading,
    #how-it-works-{{ section.id }} .hiw-subheading p {
      max-width: 62ch;
      margin-left: auto;
      margin-right: auto;
    }

    #how-it-works-{{ section.id }} .hiw-inner {
      {% if section.settings.image_position == 'right' %}
        grid-template-columns: 1fr {{ section.settings.image_width_desktop }}%;
        grid-template-areas: "header header" "content image";
      {% else %}
        grid-template-columns: {{ section.settings.image_width_desktop }}% 1fr;
        grid-template-areas: "header header" "image content";
      {% endif %}
      column-gap: {{ section.settings.column_gap_desktop }}px;
      row-gap: 0;
      align-items: center;
    }

    #how-it-works-{{ section.id }} .hiw-heading {
      margin-bottom: {{ section.settings.heading_gap_desktop }}px;
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-subheading,
    #how-it-works-{{ section.id }} .hiw-subheading p {
      margin-bottom: 0;
      font-size: {{ section.settings.subheading_size_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-milestones {
      gap: {{ section.settings.milestone_gap_desktop }}px;
      margin-bottom: {{ section.settings.cta_gap_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-milestone-icon {
      width: {{ section.settings.icon_size_desktop }}px;
      height: {{ section.settings.icon_size_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-milestone-day {
      font-size: {{ section.settings.milestone_day_size_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-bullets {
      margin-left: {{ section.settings.icon_size_desktop | plus: 10 }}px;
    }

    #how-it-works-{{ section.id }} .hiw-bullets li,
    #how-it-works-{{ section.id }} .hiw-bullets p {
      font-size: {{ section.settings.bullet_text_size_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-cta-wrap {
      margin-bottom: {{ section.settings.disclaimer_gap_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-cta {
      width: min(100%, {{ section.settings.button_width_desktop }}px);
      min-height: {{ section.settings.button_height_desktop }}px;
      font-size: {{ section.settings.button_text_size_desktop }}px;
    }

    #how-it-works-{{ section.id }} .hiw-disclaimer,
    #how-it-works-{{ section.id }} .hiw-disclaimer p {
      font-size: {{ section.settings.disclaimer_size_desktop }}px;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>How Does <em>SuperTaurine</em> Work?</p>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>With consistent daily use, SuperTaurine supports the systems behind your cat's energy, alertness, heart function and vision.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shows above the content on mobile, and beside it on desktop."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Image width (desktop)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "image_gap_mobile",
      "label": "Space between image and text (mobile)",
      "min": 8,
      "max": 64,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "label": "Space between image and text (desktop)",
      "min": 16,
      "max": 160,
      "step": 4,
      "default": 64
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start Their Daily Routine →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>Individual results may vary. Consistent daily use recommended.</p>"
    },

    {
      "type": "header",
      "content": "Main sizing"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 400,
      "max": 1300,
      "step": 20,
      "default": 1100
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 20,
      "max": 44,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 24,
      "max": 54,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_gap_mobile",
      "label": "Heading gap mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_gap_desktop",
      "label": "Heading gap desktop",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading size desktop",
      "min": 13,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_gap_mobile",
      "label": "Subheading gap mobile",
      "min": 12,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_gap_desktop",
      "label": "Subheading gap desktop",
      "min": 12,
      "max": 56,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "header_gap_desktop",
      "label": "Space below header, above image/milestones (desktop)",
      "min": 16,
      "max": 96,
      "step": 4,
      "default": 48
    },

    {
      "type": "header",
      "content": "Milestones"
    },
    {
      "type": "range",
      "id": "milestone_gap_mobile",
      "label": "Milestone spacing mobile",
      "min": 16,
      "max": 56,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "milestone_gap_desktop",
      "label": "Milestone spacing desktop",
      "min": 16,
      "max": 64,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size mobile",
      "min": 18,
      "max": 40,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "Icon size desktop",
      "min": 20,
      "max": 44,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "milestone_day_size_mobile",
      "label": "Day title size mobile",
      "min": 15,
      "max": 26,
      "step": 1,
      "default": 19
    },
    {
      "type": "range",
      "id": "milestone_day_size_desktop",
      "label": "Day title size desktop",
      "min": 16,
      "max": 28,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "bullet_text_size_mobile",
      "label": "Bullet text size mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "bullet_text_size_desktop",
      "label": "Bullet text size desktop",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 16
    },

    {
      "type": "header",
      "content": "CTA sizing"
    },
    {
      "type": "range",
      "id": "cta_gap_mobile",
      "label": "Space above button mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "cta_gap_desktop",
      "label": "Space above button desktop",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "button_width_mobile",
      "label": "Button width mobile",
      "min": 220,
      "max": 480,
      "step": 10,
      "default": 340
    },
    {
      "type": "range",
      "id": "button_width_desktop",
      "label": "Button width desktop",
      "min": 200,
      "max": 480,
      "step": 10,
      "default": 320
    },
    {
      "type": "range",
      "id": "button_height_mobile",
      "label": "Button height mobile",
      "min": 44,
      "max": 76,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "button_height_desktop",
      "label": "Button height desktop",
      "min": 48,
      "max": 84,
      "step": 2,
      "default": 58
    },
    {
      "type": "range",
      "id": "button_text_size_mobile",
      "label": "Button text size mobile",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "button_text_size_desktop",
      "label": "Button text size desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "disclaimer_gap_mobile",
      "label": "Space above disclaimer mobile",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "disclaimer_gap_desktop",
      "label": "Space above disclaimer desktop",
      "min": 4,
      "max": 34,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "disclaimer_size_mobile",
      "label": "Disclaimer text size mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "disclaimer_size_desktop",
      "label": "Disclaimer text size desktop",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 13
    },

    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 20,
      "max": 140,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 20,
      "max": 140,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_side_mobile",
      "label": "Side padding mobile",
      "min": 10,
      "max": 30,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 40,
      "max": 180,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 40,
      "max": 180,
      "step": 4,
