        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Optional. A checkmark is used if left empty."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Trust text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offer card",
      "blocks": [
        { "type": "feature", "settings": { "text": "Formulated for dogs of all ages and sizes" } },
        { "type": "feature", "settings": { "text": "Targets the root causes of joint discomfort" } },
        { "type": "feature", "settings": { "text": "90% of dogs love the taste" } },
        { "type": "trust", "settings": { "text": "Better Mobility in 90 Days or Your Money Back" } },
        { "type": "trust", "settings": { "text": "FREE and FAST SHIPPING" } }
