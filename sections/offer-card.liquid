      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "outer_bg",
      "label": "Outer background",
      "default": "#1E3D2C"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image box background",
      "default": "#EFEFEF"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Corner badge background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Corner badge text",
      "default": "#1A1A17"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1A1A17"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#1A1A17"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#8BC34A"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Feature icon background",
      "default": "#1E3D2C"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Feature icon mark",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "trust_icon_color",
      "label": "Trust bullet icon",
      "default": "#1A1A17"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#BFE94A"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#14210E"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Button border",
      "default": "#14210E"
    },
    {
      "type": "color",
      "id": "ribbon_bg",
      "label": "Ribbon background",
      "default": "#BFE94A"
    },
    {
      "type": "color",
      "id": "ribbon_text_color",
      "label": "Ribbon text",
      "default": "#14210E"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature bullet",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Optional. A checkmark is used if left empty."
        },
        {
