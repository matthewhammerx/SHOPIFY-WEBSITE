<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>

{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width
  assign lazy = section.settings.lazy

  assign heading = section.settings.heading
  assign heading_size = section.settings.heading_size
  assign heading_size_mobile = section.settings.heading_size_mobile
  assign heading_color = section.settings.heading_color
  assign heading_custom = section.settings.heading_custom
  assign heading_font = section.settings.heading_font
  assign heading_height = section.settings.heading_height
  assign heading_align = section.settings.heading_align
  assign heading_align_mobile = section.settings.heading_align_mobile

  assign sub_heading = section.settings.sub_heading
  assign sub_heading_size = section.settings.sub_heading_size
  assign sub_heading_size_mobile = section.settings.sub_heading_size_mobile
  assign sub_heading_color = section.settings.sub_heading_color
  assign sub_heading_custom = section.settings.sub_heading_custom
  assign sub_heading_font = section.settings.sub_heading_font
  assign sub_heading_height = section.settings.sub_heading_height
  assign sub_heading_align = section.settings.sub_heading_align
  assign sub_heading_align_mobile = section.settings.sub_heading_align_mobile
  assign sub_heading_mt = section.settings.sub_heading_mt

  assign slider_view = section.settings.slider_view
  assign slider_view_mobile = section.settings.slider_view_mobile
  assign slider_gap = section.settings.slider_gap
  assign slider_gap_mobile = section.settings.slider_gap_mobile
  assign slider_mt = section.settings.slider_mt
  assign autoplay = section.settings.autoplay
  assign autoplay_delay = section.settings.autoplay_delay

  assign card_padding_vertical = section.settings.card_padding_vertical
  assign card_padding_vertical_mobile = section.settings.card_padding_vertical_mobile
  assign card_padding_horizontal = section.settings.card_padding_horizontal
  assign card_padding_horizontal_mobile = section.settings.card_padding_horizontal_mobile
  assign card_radius = section.settings.card_radius
  assign card_bg_color = section.settings.card_bg_color

  assign media_radius = section.settings.media_radius
  assign media_ratio = section.settings.media_ratio
  assign media_ratio_mobile = section.settings.media_ratio_mobile

  assign stars_icon = section.settings.stars_icon
  assign stars_size = section.settings.stars_size
  assign stars_color = section.settings.stars_color
  assign stars_align_mobile = section.settings.stars_align_mobile
  assign stars_align = section.settings.stars_align
  assign stars_mt = section.settings.stars_mt

  assign content_padding_vertical = section.settings.content_padding_vertical
  assign content_padding_vertical_mobile = section.settings.content_padding_vertical_mobile
  assign content_padding_horizontal = section.settings.content_padding_horizontal
  assign content_padding_horizontal_mobile = section.settings.content_padding_horizontal_mobile
  assign hide_content = section.settings.hide_content

  assign text_size = section.settings.text_size
  assign text_size_mobile = section.settings.text_size_mobile
  assign text_color = section.settings.text_color
  assign text_custom = section.settings.text_custom
  assign text_font = section.settings.text_font
  assign text_height = section.settings.text_height
  assign text_mt = section.settings.text_mt
  assign text_align_mobile = section.settings.text_align_mobile
  assign text_align = section.settings.text_align

  assign author_size = section.settings.author_size
  assign author_size_mobile = section.settings.author_size_mobile
  assign author_color = section.settings.author_color
  assign author_custom = section.settings.author_custom
  assign author_font = section.settings.author_font
  assign author_height = section.settings.author_height
  assign author_mt = section.settings.author_mt
  assign author_align_mobile = section.settings.author_align_mobile
  assign author_align = section.settings.author_align

  assign dots_size = section.settings.dots_size
  assign dots_size_mobile = section.settings.dots_size_mobile

  assign show_filters = section.settings.show_filters
  assign filter_position = section.settings.filter_position
  assign concerns_raw = section.settings.concerns | default: ''
  assign pill_list = concerns_raw | split: ','
  assign default_pill = section.settings.default_concern | default: pill_list.first
  assign default_slug = default_pill | handleize

  assign pill_font_size = section.settings.pill_font_size
  assign pill_font_size_mobile = section.settings.pill_font_size_mobile
  assign pill_pad_v = section.settings.pill_pad_v
  assign pill_pad_h = section.settings.pill_pad_h
  assign pill_pad_v_mobile = section.settings.pill_pad_v_mobile
  assign pill_pad_h_mobile = section.settings.pill_pad_h_mobile
  assign pill_radius = section.settings.pill_radius
  assign pill_gap = section.settings.pill_gap

  assign gap_below_stars = section.settings.gap_below_stars
  assign gap_below_stars_mobile = section.settings.gap_below_stars_mobile

  assign stars_above_image = section.settings.stars_above_image
  assign topbar_align = section.settings.topbar_align
  assign topbar_align_mobile = section.settings.topbar_align_mobile
  assign topbar_gap = section.settings.topbar_gap
  assign topbar_gap_mobile = section.settings.topbar_gap_mobile
  assign topbar_inner_gap = section.settings.topbar_inner_gap
  assign topbar_inner_gap_mobile = section.settings.topbar_inner_gap_mobile
-%}

{%- capture pills_markup -%}
  {% if show_filters and pill_list.size > 0 %}
    <div class="rr-pills-{{ section.id }}" role="tablist" aria-label="Skin concerns">
      {% for pill in pill_list %}
        {% assign pill_label = pill | strip %}
        {% assign slug = pill_label | handleize %}
        <button
          class="rr-pill-{{ section.id }}{% if slug == default_slug %} is-active{% endif %}"
          data-concern="{{ slug }}"
          role="tab"
          aria-selected="{% if slug == default_slug %}true{% else %}false{% endif %}">
          {{ pill_label }}
        </button>
      {% endfor %}
    </div>
  {% endif %}
{%- endcapture -%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ sub_heading_font | font_face: font_display: 'swap' }}
  {{ text_font | font_face: font_display: 'swap' }}
  {{ author_font | font_face: font_display: 'swap' }}

  .section-{{ section.id }}{ border:0 !important; background:transparent !important; margin-top:{{ margin_top | times:0.75 | round:0 }}px; margin-bottom:{{ margin_bottom | times:0.75 | round:0 }}px; }
  .section-{{ section.id }}-settings{ margin:0 auto; padding-top:{{ padding_top | times:0.75 | round:0 }}px; padding-bottom:{{ padding_bottom | times:0.75 | round:0 }}px; padding-left:{{ padding_horizontal_mobile }}rem; padding-right:{{ padding_horizontal_mobile }}rem; }

  .testimonials-heading-{{ section.id }}{ text-align:{{ heading_align_mobile }}; }
  .testimonials-heading-{{ section.id }} *{ margin:0; font-size:{{ heading_size_mobile }}px; color:{{ heading_color }}; line-height:{{ heading_height }}%; }
  .testimonials-subheading-{{ section.id }}{ margin-top:{{ sub_heading_mt | times:0.75 | round:0 }}px; text-align:{{ sub_heading_align_mobile }}; }
  .testimonials-subheading-{{ section.id }} *{ margin:0; font-size:{{ sub_heading_size_mobile }}px; color:{{ sub_heading_color }}; line-height:{{ sub_heading_height }}%; }

  .rr-pills-{{ section.id }}{ display:flex; flex-wrap:wrap; gap:{{ pill_gap | times:0.75 | round:0 }}px; justify-content:center; margin:16px 0; }
  .rr-pill-{{ section.id }}{
    border:1px solid #e6e6e6 !important; background:#ffffff !important; color:#111111 !important;
    border-radius:{{ pill_radius }}px; padding:{{ pill_pad_v_mobile }}px {{ pill_pad_h_mobile }}px; font-size:{{ pill_font_size_mobile }}px;
    cursor:pointer; transition:background .15s,color .15s,border-color .15s,box-shadow .15s;
  }
  .rr-pill-{{ section.id }}.is-active{ background:#111111 !important; color:#ffffff !important; border-color:#111111 !important; box-shadow:0 6px 18px rgba(0,0,0,.08); }

  .testimonials-slider-{{ section.id }}{
    margin-top:{{ slider_mt | times:0.75 | round:0 }}px !important;
    margin-left:-{{ padding_horizontal_mobile }}rem !important; margin-right:-{{ padding_horizontal_mobile }}rem !important;
    padding-left:{{ padding_horizontal_mobile }}rem !important; padding-right:{{ padding_horizontal_mobile }}rem !important;
  }
  .testimonials-slider-{{ section.id }} .swiper-wrapper{ align-items:stretch !important; }

  .testimonials-slide-{{ section.id }}{
    display:flex !important; flex-direction:column; justify-content:flex-start;
    padding:{{ card_padding_vertical_mobile }}px {{ card_padding_horizontal_mobile }}px;
    border-radius:{{ card_radius }}px; background-color:{{ card_bg_color }};
    box-sizing:border-box !important; overflow:hidden; border:none !important;
  }

  /* TOP BAR: stars + author above the image */
  .rr-topbar-{{ section.id }}{
    display:flex; flex-direction:column; gap:{{ topbar_inner_gap_mobile }}px;
    margin-bottom:{{ topbar_gap_mobile }}px;
  }
  {% if topbar_align_mobile == 'start' %}
    .rr-topbar-{{ section.id }}{ align-items:flex-start; text-align:left; }
  {% elsif topbar_align_mobile == 'end' %}
    .rr-topbar-{{ section.id }}{ align-items:flex-end; text-align:right; }
  {% else %}
    .rr-topbar-{{ section.id }}{ align-items:center; text-align:center; }
  {% endif %}

  .testimonials-media-{{ section.id }}{ border-radius:{{ media_radius }}px; overflow:hidden; position:relative; border:none !important; }
  .testimonials-media-{{ section.id }} img, .testimonials-media-{{ section.id }} video, .testimonials-media-{{ section.id }} iframe{ display:block; width:100%; height:100%; object-fit:cover; border:0; }

  .testimonials-content-{{ section.id }}{ padding:{{ content_padding_vertical_mobile }}px {{ content_padding_horizontal_mobile }}px; display:flex !important; flex-direction:column; }
  .testimonials-stars-{{ section.id }}{ margin-top:{{ stars_mt | times:0.75 | round:0 }}px; display:flex; align-items:center; justify-content:{{ stars_align_mobile }}; gap:2px; }
  .testimonials-stars-{{ section.id }} svg, .testimonials-stars-{{ section.id }} img{ width:{{ stars_size }}px; height:{{ stars_size }}px; display:block; }

  /* gap between stars and text (when stars are in content) */
  .testimonials-text-{{ section.id }}{ margin-top: {{ gap_below_stars_mobile }}px; text-align: {{ text_align_mobile }}; }
  .testimonials-text-{{ section.id }} *{ margin:0; font-size:{{ text_size_mobile }}px; color:{{ text_color }}; line-height:{{ text_height }}%; }
  .testimonials-author-{{ section.id }}{ margin-top:{{ author_mt | times:0.75 | round:0 }}px; text-align:{{ author_align_mobile }}; }
  .testimonials-author-{{ section.id }} *{ margin:0; font-size:{{ author_size_mobile }}px; color:{{ author_color }}; line-height:{{ author_height }}%; }

  .testimonials-pagination-{{ section.id }}{
    position:static !important; width:auto; display:flex; gap:8px; justify-content:center; align-items:center; margin:20px auto 0;
  }
  .testimonials-pagination-{{ section.id }} .swiper-pagination-bullet{
    flex:0 0 {{ dots_size_mobile }}px; width:{{ dots_size_mobile }}px; height:{{ dots_size_mobile }}px; background:rgba(0,0,0,.18) !important; border:0 !important; opacity:1 !important;
  }
  .testimonials-pagination-{{ section.id }} .swiper-pagination-bullet-active{ background:rgba(0,0,0,.6) !important; }
  .section-{{ section.id }} .swiper-button-next, .section-{{ section.id }} .swiper-button-prev{ display:none !important; }

  {% if media_ratio_mobile == "portrait" %}
    .testimonials-media-{{ section.id }}{ aspect-ratio:9.6/12; }
  {% elsif media_ratio_mobile == "big_portrait" %}
    .testimonials-media-{{ section.id }}{ aspect-ratio:9.6/16; }
  {% elsif media_ratio_mobile == "landscape" %}
    .testimonials-media-{{ section.id }}{ aspect-ratio:12/9; }
  {% elsif media_ratio_mobile == "square" %}
    .testimonials-media-{{ section.id }}{ aspect-ratio:12/12; }
  {% else %}
    .testimonials-media-{{ section.id }}{ aspect-ratio:auto; }
  {% endif %}

  @media(min-width:1024px){
    .section-{{ section.id }}{ margin-top:{{ margin_top }}px; margin-bottom:{{ margin_bottom }}px; }
    .section-{{ section.id }}-settings{ padding:0 5rem; padding-top:{{ padding_top }}px; padding-bottom:{{ padding_bottom }}px; padding-left:{{ padding_horizontal }}rem; padding-right:{{ padding_horizontal }}rem; }

    .testimonials-heading-{{ section.id }}{ text-align:{{ heading_align }}; }
    .testimonials-heading-{{ section.id }} *{ font-size:{{ heading_size }}px; }
    .testimonials-subheading-{{ section.id }}{ margin-top:{{ sub_heading_mt }}px; text-align:{{ sub_heading_align }}; }
    .testimonials-subheading-{{ section.id }} *{ font-size:{{ sub_heading_size }}px; }

    .rr-pills-{{ section.id }}{ gap:{{ pill_gap }}px; }
    .rr-pill-{{ section.id }}{ padding:{{ pill_pad_v }}px {{ pill_pad_h }}px; font-size:{{ pill_font_size }}px; }

    .testimonials-slider-{{ section.id }}{ margin-top:{{ slider_mt }}px !important; margin-left:-{{ padding_horizontal }}rem !important; margin-right:-{{ padding_horizontal }}rem !important; padding-left:{{ padding_horizontal }}rem !important; padding-right:{{ padding_horizontal }}rem !important; }
    .testimonials-slide-{{ section.id }}{ padding:{{ card_padding_vertical }}px {{ card_padding_horizontal }}px; }

    .rr-topbar-{{ section.id }}{ gap:{{ topbar_inner_gap }}px; margin-bottom:{{ topbar_gap }}px; }
    {% if topbar_align == 'start' %}
      .rr-topbar-{{ section.id }}{ align-items:flex-start; text-align:left; }
    {% elsif topbar_align == 'end' %}
      .rr-topbar-{{ section.id }}{ align-items:flex-end; text-align:right; }
    {% else %}
      .rr-topbar-{{ section.id }}{ align-items:center; text-align:center; }
    {% endif %}

    .testimonials-content-{{ section.id }}{ padding:{{ content_padding_vertical }}px {{ content_padding_horizontal }}px; }
    .testimonials-stars-{{ section.id }}{ margin-top:{{ stars_mt }}px; justify-content:{{ stars_align }}; }
    .testimonials-text-{{ section.id }}{ margin-top: {{ gap_below_stars }}px; text-align: {{ text_align }}; }
    .testimonials-text-{{ section.id }} *{ font-size:{{ text_size }}px; }
    .testimonials-author-{{ section.id }}{ margin-top:{{ author_mt }}px; text-align:{{ author_align }}; }
    .testimonials-author-{{ section.id }} *{ font-size:{{ author_size }}px; }
    .testimonials-pagination-{{ section.id }} .swiper-pagination-bullet{ width:{{ dots_size }}px; height:{{ dots_size }}px; flex:0 0 {{ dots_size }}px; }

    {% if media_ratio == "portrait" %}
      .testimonials-media-{{ section.id }}{ aspect-ratio:9.6/12; }
    {% elsif media_ratio == "big_portrait" %}
      .testimonials-media-{{ section.id }}{ aspect-ratio:9.6/16; }
    {% elsif media_ratio == "landscape" %}
      .testimonials-media-{{ section.id }}{ aspect-ratio:12/9; }
    {% elsif media_ratio == "square" %}
      .testimonials-media-{{ section.id }}{ aspect-ratio:12/12; }
    {% else %}
      .testimonials-media-{{ section.id }}{ aspect-ratio:auto; }
    {% endif %}
  }
  /* FORCE smaller quote text inside testimonial cards */
.section-{{ section.id }} .testimonials-text-{{ section.id }} p,
.section-{{ section.id }} .testimonials-text-{{ section.id }} span,
.section-{{ section.id }} .testimonials-text-{{ section.id }} div {
  font-size: 15px !important;
  line-height: 145% !important;
  letter-spacing: 0.1px;
}

/* Author name slightly smaller + tighter */
.section-{{ section.id }} .testimonials-author-{{ section.id }} *{
  font-size: 18px !important;
  line-height: 130% !important;
}

{%- endstyle -%}

{% unless full_width %}<style>.section-{{ section.id }}-settings{ max-width:{{ content_width }}rem; }</style>{% endunless %}
{% if heading_custom %}<style>.testimonials-heading-{{ section.id }} *{ font-family:{{ heading_font.family }}, {{ heading_font.fallback_families }}; font-weight:{{ heading_font.weight }}; font-style:{{ heading_font.style }}; }</style>{% endif %}
{% if sub_heading_custom %}<style>.testimonials-subheading-{{ section.id }} *{ font-family:{{ sub_heading_font.family }}, {{ sub_heading_font.fallback_families }}; font-weight:{{ sub_heading_font.weight }}; font-style:{{ sub_heading_font.style }}; }</style>{% endif %}
{% if text_custom %}<style>.testimonials-text-{{ section.id }} *{ font-family:{{ text_font.family }}, {{ text_font.fallback_families }}; font-weight:{{ text_font.weight }}; font-style:{{ text_font.style }}; }</style>{% endif %}
{% if author_custom %}<style>.testimonials-author-{{ section.id }} *{ font-family:{{ author_font.family }}, {{ author_font.fallback_families }}; font-weight:{{ author_font.weight }}; font-style:{{ author_font.style }}; }</style>{% endif %}

<style>
  .testimonials-slider-{{ section.id }}.preview .swiper-wrapper{ display:flex; align-items:center; justify-content:space-between; overflow:hidden; }
  .testimonials-slider-{{ section.id }}.preview .testimonials-slide-{{ section.id }}{ width:100%; }
  .testimonials-slider-{{ section.id }}.preview .testimonials-slide-{{ section.id }}:not(:first-child){ margin-left:{{ slider_gap_mobile }}px; }
  @media(min-width:1024px){
    .testimonials-slider-{{ section.id }}.preview .testimonials-slide-{{ section.id }}:not(:first-child){ margin-left:{{ slider_gap }}px; }
    .testimonials-slider-{{ section.id }}.preview .testimonials-slide-{{ section.id }}{ width:18%; }
  }
</style>

<div class="section-{{ section.id }} testimonials-{{ section.id }}">
  <div class="section-{{ section.id }}-settings">

    {% if filter_position == 'above_title' %}{{ pills_markup }}{% endif %}

    {% if heading != blank %}<div class="testimonials-heading-{{ section.id }}">{{ heading }}</div>{% endif %}
    {% if sub_heading != blank %}<div class="testimonials-subheading-{{ section.id }}">{{ sub_heading }}</div>{% endif %}

    {% if filter_position == 'below_title' %}{{ pills_markup }}{% endif %}
    {% if filter_position == 'above_slider' %}{{ pills_markup }}{% endif %}

    <div class="testimonials-slider-{{ section.id }} swiper preview">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% assign concern_slug = block.settings.concern | strip | handleize %}
          <div class="testimonials-slide-{{ section.id }} swiper-slide" data-concern="{{ concern_slug }}" {{ block.shopify_attributes }}>

            {% if stars_above_image %}
              <div class="rr-topbar-{{ section.id }}">
                {% if block.settings.stars_count != 0 %}
                  <div class="testimonials-stars-{{ section.id }}" style="margin-top:0; justify-content:flex-start;">
                    {% if stars_icon != blank %}
                      {% for i in (1..block.settings.stars_count) %}
                        <img src="{{ stars_icon | image_url }}" alt="star" {% if lazy %}loading="lazy"{% endif %}>
                      {% endfor %}
                    {% else %}
                      {% assign sc = block.settings.stars_count | times:10 | round:0 | divided_by:10.0 %}
                      {% for i in (1..5) %}
                        {% assign diff = sc | minus: forloop.index0 %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="{{ stars_size }}" height="{{ stars_size }}" viewBox="0 0 20 19" fill="none" aria-hidden="true">
                          {% if diff > 0 and diff < 1 %}
                            <defs><linearGradient id="tb{{ section.id }}{{ forloop.index }}"><stop offset="0%" stop-color="{{ stars_color }}"/><stop offset="50%" stop-color="{{ stars_color }}"/><stop offset="50%" stop-color="white"/><stop offset="100%" stop-color="white"/></linearGradient></defs>
                          {% endif %}
                          <path {% if diff > 0 and diff < 1 %}stroke="{{ stars_color }}"{% endif %} d="M10 0L12.94 5.955 19.51 6.91 14.755 11.545 15.878 18.09 10 15 4.122 18.09 5.245 11.545.489 6.91l6.572-.955L10 0Z"
                                fill="{% if diff > 0 and diff < 1 %}url(#tb{{ section.id }}{{ forloop.index }}){% elsif diff >= 1 %}{{ stars_color }}{% else %}transparent{% endif %}"/>
                        </svg>
                      {% endfor %}
                    {% endif %}
                  </div>
                {% endif %}
                {% if block.settings.author != blank %}
                  <div class="testimonials-author-{{ section.id }}" style="margin-top:0;">{{ block.settings.author }}</div>
                {% endif %}
              </div>
            {% endif %}

            {% unless block.settings.media_style == "none" %}
              <div class="testimonials-media-{{ section.id }}">
                {% if block.settings.media_style == "image" %}
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" {% if lazy %}loading="lazy"{% endif %}>
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                {% elsif block.settings.media_style == "video" %}
                  {% assign video_id = block.settings.video.id | default: block.settings.video_url.id %}
                  {% if block.settings.poster != blank %}
                    <img src="{{ block.settings.poster | image_url }}" alt="{{ block.settings.poster.alt }}" {% if lazy %}loading="lazy"{% endif %}>
                  {% endif %}
                  {% if block.settings.video == null and block.settings.video_url != null %}
                    {% assign loop = '&loop=1&playlist=' | append: video_id %}
                    {% if block.settings.video_url.type == 'youtube' %}
                      <iframe data-src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1{{ loop }}" class="lazy" allow="autoplay; encrypted-media" allowfullscreen {% if lazy %}loading="lazy"{% endif %} title="Video"></iframe>
                    {% else %}
                      <iframe data-src="https://player.vimeo.com/video/{{ video_id }}{{ loop }}" class="lazy" allow="autoplay; encrypted-media" allowfullscreen {% if lazy %}loading="lazy"{% endif %} title="Video"></iframe>
                    {% endif %}
                  {% else %}
                    <video data-src="{{ block.settings.video.sources[1].url }}" {% if block.settings.controls %}controls{% endif %} playsinline preload="none" loop class="lazy"></video>
                  {% endif %}
                {% endif %}
              </div>
            {% endunless %}

            {% unless hide_content %}
              <div class="testimonials-content-{{ section.id }}">
                {% unless stars_above_image %}
                  {% if block.settings.stars_count != 0 %}
                    <div class="testimonials-stars-{{ section.id }}">
                      {% if stars_icon != blank %}
                        {% for i in (1..block.settings.stars_count) %}
                          <img src="{{ stars_icon | image_url }}" alt="star" {% if lazy %}loading="lazy"{% endif %}>
                        {% endfor %}
                      {% else %}
                        {% assign sc2 = block.settings.stars_count | times:10 | round:0 | divided_by:10.0 %}
                        {% for i in (1..5) %}
                          {% assign diff2 = sc2 | minus: forloop.index0 %}
                          <svg xmlns="http://www.w3.org/2000/svg" width="{{ stars_size }}" height="{{ stars_size }}" viewBox="0 0 20 19" fill="none" aria-hidden="true">
                            {% if diff2 > 0 and diff2 < 1 %}
                              <defs><linearGradient id="g{{ section.id }}{{ forloop.index }}"><stop offset="0%" stop-color="{{ stars_color }}"/><stop offset="50%" stop-color="{{ stars_color }}"/><stop offset="50%" stop-color="white"/><stop offset="100%" stop-color="white"/></linearGradient></defs>
                            {% endif %}
                            <path {% if diff2 > 0 and diff2 < 1 %}stroke="{{ stars_color }}"{% endif %} d="M10 0L12.94 5.955 19.51 6.91 14.755 11.545 15.878 18.09 10 15 4.122 18.09 5.245 11.545.489 6.91l6.572-.955L10 0Z"
                                  fill="{% if diff2 > 0 and diff2 < 1 %}url(#g{{ section.id }}{{ forloop.index }}){% elsif diff2 >= 1 %}{{ stars_color }}{% else %}transparent{% endif %}"/>
                          </svg>
                        {% endfor %}
                      {% endif %}
                    </div>
                  {% endif %}
                {% endunless %}

                {% if block.settings.text != blank %}
                  <div class="testimonials-text-{{ section.id }}">{{ block.settings.text }}</div>
                {% endif %}

                {% if block.settings.author != blank and stars_above_image == false %}
                  <div class="testimonials-author-{{ section.id }}">{{ block.settings.author }}</div>
                {% endif %}
              </div>
            {% endunless %}
          </div>
        {% endfor %}
      </div>
      <div class="testimonials-pagination-{{ section.id }} swiper-pagination"></div>
    </div>

    {% if filter_position == 'below_slider' %}{{ pills_markup }}{% endif %}
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanilla-lazyload@19.1.3/dist/lazyload.min.js"></script>

<script>
  function initCustomTestimonial{{ section.id | replace: '-', '' }}(){
    const root = document.querySelector('.testimonials-{{ section.id }}');
    const sliderEl = root && root.querySelector('.testimonials-slider-{{ section.id }}');
    if (!sliderEl) return;
    sliderEl.classList.remove('preview');

    const slider = new Swiper(".testimonials-slider-{{ section.id }}",{
      speed:300,
      spaceBetween:20,
      loop:false,
      centeredSlides:false,
      {% if autoplay %}autoplay:{ delay: {{ autoplay_delay }}000 },{% endif %}
      pagination:{ el:'.testimonials-pagination-{{ section.id }}', type:'bullets', clickable:true },
      breakpoints:{
        320:{ spaceBetween: {{ slider_gap_mobile }}, slidesPerView: {{ slider_view_mobile }} },
        768:{ spaceBetween: {{ slider_gap_mobile }}, slidesPerView: {{ slider_view | times: 0.5 | round: 0 }} },
        1024:{ spaceBetween: {{ slider_gap }}, slidesPerView: {{ slider_view }} }
      }
    });

    const wrapper = slider.el.querySelector('.swiper-wrapper');
    const ORIGINAL_HTML = Array.from(wrapper.children).map(el => el.outerHTML);

    const pills = Array.from(root.querySelectorAll('.rr-pill-{{ section.id }}'));
    function setActive(slug){
      pills.forEach(p => {
        const isOn = p.dataset.concern === slug;
        p.classList.toggle('is-active', isOn);
        p.setAttribute('aria-selected', isOn ? 'true' : 'false');
      });
    }
    function clearSlides(){ const idx = Array.from({length: slider.slides.length}, (_,i) => i); if (idx.length) slider.removeSlide(idx); }
    function rebuild(slug){
      const temp = document.createElement('div');
      temp.innerHTML = ORIGINAL_HTML.join('');
      const chosen = Array.from(temp.children).filter(node => {
        const raw = (node.getAttribute('data-concern') || '').toLowerCase();
        const list = raw.split(',').map(s => s.trim()).filter(Boolean);
        if (!slug) return true;
        return list.includes(slug);
      }).map(n => n.outerHTML);

      clearSlides();
      slider.appendSlide(chosen.length ? chosen : ORIGINAL_HTML);
      slider.update(); slider.pagination.render(); slider.pagination.update(); slider.slideTo(0, 0);
    }

    const startSlug = '{{ default_slug }}'; setActive(startSlug); rebuild(startSlug);
    pills.forEach(btn => btn.addEventListener('click', () => { const slug = btn.dataset.concern; setActive(slug); rebuild(slug); }));

    var lazyLoadInstance = new LazyLoad();
    window.addEventListener("LazyLoad::Initialized", e => { window.lazyLoadInstance = e.detail.instance; }, false);
  }

  document.addEventListener('DOMContentLoaded', initCustomTestimonial{{ section.id | replace: '-', '' }});
  if (Shopify.designMode){
    document.addEventListener('shopify:section:unload', initCustomTestimonial{{ section.id | replace: '-', '' }});
    document.addEventListener('shopify:section:load', initCustomTestimonial{{ section.id | replace: '-', '' }});
  }
</script>

