{% comment %}
  Listicle Hero V2
  Image hero + review pill + bold accent heading + editable checkmark benefits
{% endcomment %}

<section id="listicle-hero-v2-{{ section.id }}" class="listicle-hero-v2">
  <style>
    {% if section.settings.hide_header %}
      header,
      #shopify-section-header,
      #shopify-section-header-classic,
      .main_nav,
      .main-nav,
      .navbar,
      #mobile-header-sticky-wrapper,
      .nav,
      .header-wrapper,
      [data-site-header],
      #shopify-section-static-header,
      #header,
      .main-header,
      #site-header,
      .shopify-section-group-header-group {
        display: none !important;
      }

      .main-content,
      #MainContent {
        padding-top: 0 !important;
        margin-top: 0 !important;
      }
    {% endif %}

    #listicle-hero-v2-{{ section.id }} {
      --hero-bg: {{ section.settings.background_color }};
      --hero-image-bg: {{ section.settings.image_background_color }};
      --hero-glow: {{ section.settings.glow_color }};

      --review-bg: {{ section.settings.review_pill_bg }};
      --review-border: {{ section.settings.review_pill_border }};
      --review-star: {{ section.settings.review_star_color }};
      --review-text: {{ section.settings.review_text_color }};

      --heading-color: {{ section.settings.heading_color }};
      --heading-accent: {{ section.settings.heading_accent_color }};
      --subheading-color: {{ section.settings.subheading_color }};

      --benefit-bg: {{ section.settings.benefit_bg }};
      --benefit-text: {{ section.settings.benefit_text_color }};
      --benefit-check-bg: {{ section.settings.benefit_check_bg }};
      --benefit-check-color: {{ section.settings.benefit_check_color }};

      --button-bg: {{ section.settings.button_bg }};
      --button-hover-bg: {{ section.settings.button_hover_bg }};
      --button-text: {{ section.settings.button_text_color }};

      --floating-badge-bg: {{ section.settings.floating_badge_bg }};
      --floating-badge-text: {{ section.settings.floating_badge_text_color }};

      --risk-text: {{ section.settings.risk_text_color }};
      --risk-check-bg: {{ section.settings.risk_check_bg }};
      --risk-check-color: {{ section.settings.risk_check_color }};

      --top-badge-bg: {{ section.settings.top_badge_bg }};
      --top-badge-text: {{ section.settings.top_badge_text_color }};

      --overlay-bg: {{ section.settings.overlay_card_bg }};
      --overlay-text: {{ section.settings.overlay_text_color }};

      position: relative;
      overflow: hidden;
      background: var(--hero-bg);
      font-family: inherit;
    }

    #listicle-hero-v2-{{ section.id }} * {
      box-sizing: border-box;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-glow {
      position: absolute;
      right: -180px;
      bottom: -180px;
      width: 720px;
      height: 720px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--hero-glow) 0%, transparent 70%);
      opacity: {{ section.settings.glow_opacity | divided_by: 100.0 }};
      pointer-events: none;
      z-index: 0;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-wrapper {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-image-side {
      position: relative;
      order: 1;
      height: {{ section.settings.mobile_image_height }}px;
      background: var(--hero-image-bg);
      overflow: hidden;
      border-radius: {{ section.settings.mobile_image_radius }}px;
      margin: {{ section.settings.mobile_image_margin_top }}px {{ section.settings.mobile_image_margin_sides }}px 0;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-main-image,
    #listicle-hero-v2-{{ section.id }} .placeholder-svg {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: {{ section.settings.image_fit }};
      object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-top-badge {
      position: absolute;
      top: {{ section.settings.top_badge_top_mobile }}px;
      left: {{ section.settings.top_badge_left_mobile }}px;
      z-index: 3;
      background: var(--top-badge-bg);
      color: var(--top-badge-text);
      border-radius: 999px;
      padding: 7px 13px;
      display: {% if section.settings.show_top_badge %}flex{% else %}none{% endif %};
      align-items: center;
      gap: 6px;
      font-size: {{ section.settings.top_badge_font_mobile }}px;
      font-weight: 800;
      line-height: 1;
      box-shadow: 0 6px 16px rgba(0,0,0,0.08);
      white-space: nowrap;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-overlay-card {
      position: absolute;
      top: {{ section.settings.overlay_top_mobile }}px;
      left: {{ section.settings.overlay_left_mobile }}px;
      z-index: 3;
      display: {% if section.settings.show_overlay_card %}block{% else %}none{% endif %};
      width: {{ section.settings.overlay_width_mobile }}px;
      background: var(--overlay-bg);
      border-radius: {{ section.settings.overlay_radius }}px;
      padding: {{ section.settings.overlay_padding_mobile }}px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-overlay-logo {
      display: block;
      max-width: {{ section.settings.overlay_logo_width_mobile }}px;
      height: auto;
      margin: 0 auto 8px;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-overlay-text {
      margin: 0;
      color: var(--overlay-text);
      font-size: {{ section.settings.overlay_text_size_mobile }}px;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-content {
      order: 2;
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_padding_bottom }}px;
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.mobile_content_gap }}px;
      color: var(--subheading-color);
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-review-pill {
      display: {% if section.settings.show_reviews %}flex{% else %}none{% endif %};
      align-items: center;
      gap: 8px;
      width: {% if section.settings.review_full_width_mobile %}100%{% else %}fit-content{% endif %};
      max-width: 100%;
      background: var(--review-bg);
      border: 1px solid var(--review-border);
      border-radius: 999px;
      padding: {{ section.settings.review_padding_y_mobile }}px {{ section.settings.review_padding_x_mobile }}px;
      overflow: hidden;
      color: var(--review-text);
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-review-image {
      height: {{ section.settings.review_image_height_mobile }}px;
      width: auto;
      display: block;
      flex-shrink: 0;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-review-row {
      display: flex;
      align-items: center;
      gap: 7px;
      min-width: 0;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-stars {
      display: {% if section.settings.show_stars %}flex{% else %}none{% endif %};
      align-items: center;
      gap: 1px;
      color: var(--review-star);
      flex-shrink: 0;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-stars svg {
      width: {{ section.settings.star_size }}px;
      height: {{ section.settings.star_size }}px;
      fill: currentColor;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-review-text {
      font-size: {{ section.settings.review_text_size_mobile }}px;
      line-height: 1.2;
      font-weight: 600;
      color: var(--review-text);
      white-space: nowrap;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-heading {
      margin: 0;
      max-width: {{ section.settings.heading_max_width }}px;
      color: var(--heading-color) !important;
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
      letter-spacing: -0.045em;
      font-weight: {{ section.settings.heading_weight }};
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-heading p,
    #listicle-hero-v2-{{ section.id }} .lhv2-heading h1,
    #listicle-hero-v2-{{ section.id }} .lhv2-heading h2,
    #listicle-hero-v2-{{ section.id }} .lhv2-heading h3 {
      margin: 0;
      color: inherit !important;
      font: inherit;
      line-height: inherit;
      letter-spacing: inherit;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-heading strong,
    #listicle-hero-v2-{{ section.id }} .lhv2-heading b {
      color: var(--heading-accent) !important;
      font-weight: inherit !important;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-subheading {
      max-width: {{ section.settings.subheading_max_width }}px;
      color: var(--subheading-color);
      font-size: {{ section.settings.mobile_subheading_size }}px;
      line-height: 1.45;
      font-weight: {{ section.settings.subheading_weight }};
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-subheading p {
      margin: 0;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-benefits-card {
      display: {% if section.settings.show_benefits %}block{% else %}none{% endif %};
      width: 100%;
      max-width: {{ section.settings.benefit_max_width }}px;
      background: var(--benefit-bg);
      border-radius: {{ section.settings.benefit_card_radius }}px;
      padding: {{ section.settings.benefit_card_padding_mobile }}px;
      margin-top: {{ section.settings.benefit_margin_top_mobile }}px;
      margin-bottom: {{ section.settings.benefit_margin_bottom_mobile }}px;
      {% if section.settings.show_benefit_shadow %}
        box-shadow: 0 10px 28px rgba(0,0,0,0.08);
      {% endif %}
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-benefits-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.benefit_gap_mobile }}px;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-benefit-item {
      display: flex;
      align-items: {{ section.settings.benefit_vertical_alignment }};
      gap: {{ section.settings.benefit_icon_gap }}px;
      color: var(--benefit-text);
      font-size: {{ section.settings.benefit_text_size_mobile }}px;
      line-height: {{ section.settings.benefit_line_height | divided_by: 100.0 }};
      font-weight: {{ section.settings.benefit_text_weight }};
      text-align: left;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-benefit-icon {
      width: {{ section.settings.benefit_icon_size_mobile }}px;
      height: {{ section.settings.benefit_icon_size_mobile }}px;
      min-width: {{ section.settings.benefit_icon_size_mobile }}px;
      border-radius: 999px;
      background: var(--benefit-check-bg);
      color: var(--benefit-check-color);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: {{ section.settings.benefit_icon_offset }}px;
      overflow: hidden;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-benefit-icon svg {
      width: {{ section.settings.benefit_check_size_mobile }}px;
      height: {{ section.settings.benefit_check_size_mobile }}px;
      display: block;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-benefit-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-benefit-text p {
      margin: 0;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-benefit-text strong,
    #listicle-hero-v2-{{ section.id }} .lhv2-benefit-text b {
      font-weight: 900;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-cta-area {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      width: 100%;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-cta-wrap {
      position: relative;
      width: 100%;
      max-width: {{ section.settings.button_max_width_mobile }}px;
      padding-top: {% if section.settings.floating_badge != blank %}10px{% else %}0{% endif %};
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-floating-badge {
      position: absolute;
      left: 50%;
      top: 0;
      transform: translate(-50%, -10%);
      display: {% if section.settings.floating_badge != blank %}block{% else %}none{% endif %};
      white-space: nowrap;
      padding: 6px 13px;
      border-radius: 999px;
      background: var(--floating-badge-bg);
      color: var(--floating-badge-text);
      font-size: {{ section.settings.floating_badge_size }}px;
      line-height: 1;
      font-weight: 800;
      z-index: 2;
      box-shadow: 0 5px 12px rgba(0,0,0,0.08);
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: {{ section.settings.button_height }}px;
      background: var(--button-bg);
      color: var(--button-text);
      border-radius: 999px;
      text-decoration: none;
      font-size: {{ section.settings.button_text_size }}px;
      font-weight: 800;
      padding: 17px 28px;
      text-align: center;
      border: {% if section.settings.button_border %}1px solid #000{% else %}0{% endif %};
      box-shadow: {% if section.settings.button_shadow_style == 'hard' %}5px 5px 0 #000{% elsif section.settings.button_shadow_style == 'soft' %}0 8px 18px rgba(0,0,0,0.14){% else %}none{% endif %};
      transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease, background-color 0.2s ease;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-button:hover {
      background: var(--button-hover-bg);
      transform: translateY(-2px);
      box-shadow: {% if section.settings.button_shadow_style == 'hard' %}2px 2px 0 #000{% elsif section.settings.button_shadow_style == 'soft' %}0 12px 25px rgba(0,0,0,0.18){% else %}none{% endif %};
      opacity: 0.96;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-risk-row {
      display: {% if section.settings.show_risk_row %}flex{% else %}none{% endif %};
      align-items: center;
      justify-content: center;
      gap: 7px;
      width: 100%;
      color: var(--risk-text);
      font-size: {{ section.settings.risk_text_size }}px;
      font-weight: 700;
      line-height: 1.2;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-risk-check {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      background: var(--risk-check-bg);
      color: var(--risk-check-color);
      border-radius: 50%;
      display: {% if section.settings.show_risk_check %}inline-flex{% else %}none{% endif %};
      align-items: center;
      justify-content: center;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-risk-check svg {
      width: 12px;
      height: 12px;
      display: block;
    }

    #listicle-hero-v2-{{ section.id }} .lhv2-risk-underline {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    @media screen and (min-width: 768px) {
      #listicle-hero-v2-{{ section.id }} .lhv2-glow {
        width: 900px;
        height: 900px;
        right: -220px;
        bottom: -240px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-wrapper {
        flex-direction: {% if section.settings.desktop_image_position == 'right' %}row{% else %}row-reverse{% endif %};
        min-height: {{ section.settings.desktop_min_height }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-content {
        order: initial;
        width: {{ section.settings.desktop_content_width }}%;
        padding: {{ section.settings.desktop_padding_top }}px {{ section.settings.desktop_padding_right }}px {{ section.settings.desktop_padding_bottom }}px {{ section.settings.desktop_padding_left }}px;
        justify-content: center;
        gap: {{ section.settings.desktop_content_gap }}px;
        text-align: {{ section.settings.desktop_text_align }};
        align-items: {% if section.settings.desktop_text_align == 'center' %}center{% else %}flex-start{% endif %};
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-image-side {
        order: initial;
        width: {{ 100 | minus: section.settings.desktop_content_width }}%;
        height: auto;
        min-height: {{ section.settings.desktop_min_height }}px;
        margin: 0;
        border-radius: {{ section.settings.desktop_image_radius }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-top-badge {
        top: {{ section.settings.top_badge_top_desktop }}px;
        left: {{ section.settings.top_badge_left_desktop }}px;
        font-size: {{ section.settings.top_badge_font_desktop }}px;
        padding: 9px 15px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-overlay-card {
        top: {{ section.settings.overlay_top_desktop }}px;
        left: {{ section.settings.overlay_left_desktop }}px;
        width: {{ section.settings.overlay_width_desktop }}px;
        padding: {{ section.settings.overlay_padding_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-overlay-logo {
        max-width: {{ section.settings.overlay_logo_width_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-overlay-text {
        font-size: {{ section.settings.overlay_text_size_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-review-pill {
        width: fit-content;
        padding: {{ section.settings.review_padding_y_desktop }}px {{ section.settings.review_padding_x_desktop }}px;
        {% if section.settings.review_pill_shadow %}
          box-shadow: 2px 4px 20px rgba(0,0,0,0.1);
        {% endif %}
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-review-image {
        height: {{ section.settings.review_image_height_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-review-text {
        font-size: {{ section.settings.review_text_size_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-heading {
        font-size: {{ section.settings.desktop_heading_size }}px;
        text-align: {{ section.settings.desktop_text_align }};
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-subheading {
        font-size: {{ section.settings.desktop_subheading_size }}px;
        text-align: {{ section.settings.desktop_text_align }};
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-benefits-card {
        padding: {{ section.settings.benefit_card_padding_desktop }}px;
        margin-top: {{ section.settings.benefit_margin_top_desktop }}px;
        margin-bottom: {{ section.settings.benefit_margin_bottom_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-benefits-list {
        gap: {{ section.settings.benefit_gap_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-benefit-item {
        font-size: {{ section.settings.benefit_text_size_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-benefit-icon {
        width: {{ section.settings.benefit_icon_size_desktop }}px;
        height: {{ section.settings.benefit_icon_size_desktop }}px;
        min-width: {{ section.settings.benefit_icon_size_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-benefit-icon svg {
        width: {{ section.settings.benefit_check_size_desktop }}px;
        height: {{ section.settings.benefit_check_size_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-cta-area {
        align-items: {% if section.settings.desktop_text_align == 'center' %}center{% else %}flex-start{% endif %};
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-cta-wrap {
        width: auto;
        max-width: none;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-button {
        width: auto;
        min-width: {{ section.settings.button_min_width_desktop }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-risk-row {
        justify-content: {% if section.settings.desktop_text_align == 'center' %}center{% else %}flex-start{% endif %};
      }
    }

    @media screen and (max-width: 390px) {
      #listicle-hero-v2-{{ section.id }} .lhv2-heading {
        font-size: {{ section.settings.mobile_heading_size | minus: 4 }}px;
      }

      #listicle-hero-v2-{{ section.id }} .lhv2-review-text {
        font-size: {{ section.settings.review_text_size_mobile | minus: 1 }}px;
      }
    }
  </style>

  {% assign button_href = section.settings.button_link | default: '#offers' %}

  {% if section.settings.show_glow %}
    <div class="lhv2-glow" aria-hidden="true"></div>
  {% endif %}

  <div class="lhv2-wrapper">
    <div class="lhv2-image-side">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 1800
          | image_tag:
            class: 'lhv2-main-image',
            loading: 'eager',
            alt: section.settings.hero_image.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lhv2-main-image placeholder-svg' }}
      {% endif %}

      <div class="lhv2-top-badge">
        <span>{{ section.settings.top_badge_icon }}</span>
        <span>{{ section.settings.top_badge_text }}</span>
      </div>

      <div class="lhv2-overlay-card">
        {% if section.settings.overlay_logo != blank %}
          {{
            section.settings.overlay_logo
            | image_url: width: 400
            | image_tag:
              class: 'lhv2-overlay-logo',
              loading: 'eager',
              alt: section.settings.overlay_logo.alt
          }}
        {% endif %}

        {% if section.settings.overlay_text != blank %}
          <p class="lhv2-overlay-text">{{ section.settings.overlay_text }}</p>
        {% endif %}
      </div>
    </div>

    <div class="lhv2-content">
      <div class="lhv2-review-pill">
        {% if section.settings.review_image != blank %}
          {{
            section.settings.review_image
            | image_url: width: 160
            | image_tag:
              class: 'lhv2-review-image',
              loading: 'eager',
              alt: section.settings.review_image.alt
          }}
        {% endif %}

        <div class="lhv2-review-row">
          <div class="lhv2-stars" aria-hidden="true">
            {% for i in (1..5) %}
              <svg viewBox="0 0 16 16">
                <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
              </svg>
            {% endfor %}
          </div>

          <span class="lhv2-review-text">{{ section.settings.review_text }}</span>
        </div>
      </div>

      {% if section.settings.heading != blank %}
        <div class="lhv2-heading">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="lhv2-subheading">
          {{ section.settings.subheading }}
        </div>
      {% endif %}

      {% if section.settings.show_benefits and section.blocks.size > 0 %}
        <div class="lhv2-benefits-card">
          <ul class="lhv2-benefits-list">
            {% for block in section.blocks %}
              {% if block.type == 'benefit' %}
                <li class="lhv2-benefit-item" {{ block.shopify_attributes }}>
                  <span class="lhv2-benefit-icon" aria-hidden="true">
                    {% if block.settings.custom_icon != blank %}
                      {{
                        block.settings.custom_icon
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', alt: ''
                      }}
                    {% else %}
                      <svg viewBox="0 0 18 18" fill="none">
                        <path d="M5 9l3 3 5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </span>

                  <span class="lhv2-benefit-text">{{ block.settings.text }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <div class="lhv2-cta-area">
        <div class="lhv2-cta-wrap">
          <span class="lhv2-floating-badge">{{ section.settings.floating_badge }}</span>

          {% if section.settings.button_text != blank %}
            <a href="{{ button_href }}" class="lhv2-button">
              {{ section.settings.button_text }}
            </a>
          {% endif %}
        </div>

        <div class="lhv2-risk-row">
          <span class="lhv2-risk-check" aria-hidden="true">
            <svg viewBox="0 0 18 18" fill="none">
              <path d="M5 9l3 3 5-5" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>

          <span>
            {{ section.settings.risk_prefix }}
            {% if section.settings.risk_underlined_text != blank %}
              <span class="lhv2-risk-underline">{{ section.settings.risk_underlined_text }}</span>
            {% endif %}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

