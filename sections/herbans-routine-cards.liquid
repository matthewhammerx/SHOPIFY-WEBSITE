{% comment %}
  Herbans - Daily Wellness Cards Section
{% endcomment %}

<section
  id="herbans-routine-{{ section.id }}"
  class="herbans-routine"
>
  <style>
    #herbans-routine-{{ section.id }} {
      --hb-bg: {{ section.settings.background_color }};
      --hb-card-bg: {{ section.settings.card_background }};
      --hb-text: {{ section.settings.text_color }};
      --hb-muted: {{ section.settings.muted_text_color }};
      --hb-accent: {{ section.settings.accent_color }};
      --hb-accent-soft: {{ section.settings.accent_soft_color }};
      --hb-border: {{ section.settings.border_color }};
      --hb-radius: {{ section.settings.card_radius }}px;
      --hb-image-radius: {{ section.settings.image_radius }}px;
      background: var(--hb-bg);
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      overflow: hidden;
    }

    #herbans-routine-{{ section.id }} * {
      box-sizing: border-box;
    }

    #herbans-routine-{{ section.id }} .hb-routine__inner {
      width: min(100% - 32px, {{ section.settings.max_width }}px);
      margin: 0 auto;
    }

    #herbans-routine-{{ section.id }} .hb-routine__eyebrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin: 0 auto 18px;
      padding: 9px 18px;
      border-radius: 999px;
      background: var(--hb-accent-soft);
      color: var(--hb-accent);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #herbans-routine-{{ section.id }} .hb-routine__header {
      text-align: center;
      margin: 0 auto 34px;
      max-width: 920px;
    }

    #herbans-routine-{{ section.id }} .hb-routine__heading {
      margin: 0;
      color: var(--hb-text);
      font-size: clamp({{ section.settings.heading_mobile_size }}px, 5vw, {{ section.settings.heading_desktop_size }}px);
      line-height: 0.98;
      letter-spacing: -0.055em;
      font-weight: 900;
    }

    #herbans-routine-{{ section.id }} .hb-routine__heading span {
      color: var(--hb-accent);
      display: inline;
    }

    #herbans-routine-{{ section.id }} .hb-routine__subheading {
      margin: 18px auto 0;
      max-width: 690px;
      color: var(--hb-muted);
      font-size: clamp(16px, 2vw, 20px);
      line-height: 1.45;
      font-weight: 500;
    }

    #herbans-routine-{{ section.id }} .hb-routine__cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: {{ section.settings.card_gap }}px;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    #herbans-routine-{{ section.id }} .hb-routine__card {
      position: relative;
      min-width: 0;
      overflow: hidden;
      border-radius: var(--hb-radius);
      background: var(--hb-card-bg);
      border: 1px solid var(--hb-border);
      box-shadow: 0 18px 45px rgba(68, 36, 16, 0.08);
      transition: transform 220ms ease, box-shadow 220ms ease;
    }

    #herbans-routine-{{ section.id }} .hb-routine__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 22px 60px rgba(68, 36, 16, 0.12);
    }

    #herbans-routine-{{ section.id }} .hb-routine__image-wrap {
      padding: 10px 10px 0;
    }

    #herbans-routine-{{ section.id }} .hb-routine__image {
      position: relative;
      width: 100%;
      aspect-ratio: {{ section.settings.image_ratio }};
      overflow: hidden;
      border-radius: var(--hb-image-radius);
      background: linear-gradient(135deg, #fff6ec, #f7ddc7);
    }

    #herbans-routine-{{ section.id }} .hb-routine__image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    #herbans-routine-{{ section.id }} .hb-routine__placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      color: var(--hb-accent);
      font-weight: 800;
      background:
        radial-gradient(circle at 18% 20%, rgba(228, 101, 45, 0.18), transparent 28%),
        radial-gradient(circle at 82% 75%, rgba(5, 112, 53, 0.12), transparent 30%),
        linear-gradient(135deg, #fff8f1, #f4d8c0);
    }

    #herbans-routine-{{ section.id }} .hb-routine__content {
      padding: 24px 26px 28px;
      text-align: center;
    }

    #herbans-routine-{{ section.id }} .hb-routine__icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      margin: -45px auto 14px;
      position: relative;
      z-index: 2;
      background: var(--hb-accent);
      color: #fff;
      display: grid;
      place-items: center;
      font-size: 18px;
      font-weight: 900;
      box-shadow: 0 10px 24px rgba(228, 101, 45, 0.22);
      border: 4px solid var(--hb-card-bg);
    }

    #herbans-routine-{{ section.id }} .hb-routine__title {
      margin: 0;
      color: var(--hb-text);
      font-size: clamp(22px, 2.4vw, 30px);
      line-height: 1.04;
      letter-spacing: -0.035em;
      font-weight: 900;
    }

    #herbans-routine-{{ section.id }} .hb-routine__text {
      margin: 12px auto 0;
      color: var(--hb-muted);
      font-size: clamp(15px, 1.4vw, 18px);
      line-height: 1.45;
      font-weight: 500;
      max-width: 360px;
    }

    #herbans-routine-{{ section.id }} .hb-routine__button-wrap {
      display: flex;
      justify-content: center;
      margin-top: 34px;
    }

    #herbans-routine-{{ section.id }} .hb-routine__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 54px;
      padding: 0 34px;
      border-radius: 999px;
      background: var(--hb-accent);
      color: #fff;
      text-decoration: none;
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 0.02em;
      box-shadow: 0 16px 34px rgba(228, 101, 45, 0.24);
      transition: transform 180ms ease, opacity 180ms ease;
    }

    #herbans-routine-{{ section.id }} .hb-routine__button:hover {
      transform: translateY(-2px);
      opacity: 0.92;
    }

    @media (max-width: 989px) {
      #herbans-routine-{{ section.id }} {
        padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
      }

      #herbans-routine-{{ section.id }} .hb-routine__inner {
        width: 100%;
        margin: 0;
      }

      #herbans-routine-{{ section.id }} .hb-routine__header {
        text-align: left;
        max-width: none;
        margin: 0 0 28px;
        padding: 0 24px;
      }

      #herbans-routine-{{ section.id }} .hb-routine__eyebrow {
        margin-left: 0;
        margin-right: 0;
      }

      #herbans-routine-{{ section.id }} .hb-routine__heading {
        font-size: clamp({{ section.settings.heading_mobile_size }}px, 14vw, 72px);
        line-height: 0.93;
        letter-spacing: -0.065em;
        max-width: 92%;
      }

      #herbans-routine-{{ section.id }} .hb-routine__subheading {
        margin: 18px 0 0;
        max-width: 92%;
        font-size: 17px;
        line-height: 1.42;
      }

      #herbans-routine-{{ section.id }} .hb-routine__cards {
        {% if section.settings.mobile_carousel %}
          display: grid;
          grid-auto-flow: column;
          grid-auto-columns: 78vw;
          overflow-x: auto;
          gap: 18px;
          width: 100vw;
          margin-inline: 0;
          padding-inline: 24px;
          padding-bottom: 4px;
          scroll-snap-type: x mandatory;
          scrollbar-width: none;
          -webkit-overflow-scrolling: touch;
        {% else %}
          grid-template-columns: 1fr;
          gap: 16px;
          padding-inline: 24px;
        {% endif %}
      }

      {% if section.settings.mobile_carousel %}
        #herbans-routine-{{ section.id }} .hb-routine__cards::-webkit-scrollbar {
          display: none;
        }

        #herbans-routine-{{ section.id }} .hb-routine__card {
          scroll-snap-align: start;
        }
      {% endif %}

      #herbans-routine-{{ section.id }} .hb-routine__card {
        border-radius: 28px;
      }

      #herbans-routine-{{ section.id }} .hb-routine__image-wrap {
        padding: 9px 9px 0;
      }

      #herbans-routine-{{ section.id }} .hb-routine__image {
        border-radius: 22px;
        aspect-ratio: 4 / 3;
      }

      #herbans-routine-{{ section.id }} .hb-routine__content {
        padding: 22px 24px 28px;
        text-align: center;
      }

      #herbans-routine-{{ section.id }} .hb-routine__title {
        font-size: 30px;
        line-height: 1.05;
      }

      #herbans-routine-{{ section.id }} .hb-routine__text {
        font-size: 17px;
        line-height: 1.45;
      }

      #herbans-routine-{{ section.id }} .hb-routine__card:hover {
        transform: none;
      }

      #herbans-routine-{{ section.id }} .hb-routine__button-wrap {
        padding: 0 24px;
      }

      #herbans-routine-{{ section.id }} .hb-routine__button {
        width: 100%;
      }
    }
  </style>

  <div class="hb-routine__inner">
    <div class="hb-routine__header">
      {% if section.settings.eyebrow != blank %}
        <div class="hb-routine__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hb-routine__heading">
          {{ section.settings.heading }}
          {% if section.settings.highlight_heading != blank %}
            <span>{{ section.settings.highlight_heading }}</span>
          {% endif %}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hb-routine__subheading">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <ul class="hb-routine__cards" role="list">
      {% for block in section.blocks %}
        <li class="hb-routine__card" {{ block.shopify_attributes }}>
          <div class="hb-routine__image-wrap">
            <div class="hb-routine__image">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 480, 640, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 33vw, 78vw',
                    alt: block.settings.title
                }}
              {% else %}
                <div class="hb-routine__placeholder">
                  Add image
                </div>
              {% endif %}
            </div>
          </div>

          <div class="hb-routine__content">
            {% if block.settings.icon_text != blank %}
              <div class="hb-routine__icon">
                {{ block.settings.icon_text }}
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="hb-routine__title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="hb-routine__text">
                {{ block.settings.text }}
              </p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <div class="hb-routine__button-wrap">
        <a class="hb-routine__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Herbans wellness cards",
  "tag": "section",
  "class": "section-herbans-routine-cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Daily wellness support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading first part",
      "default": "Hair & bladder support,"
    },
    {
      "type": "text",
      "id": "highlight_heading",
      "label": "Highlighted heading",
      "default": "made simple."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A simple daily softgel routine made with pumpkin seed oil and saw palmetto to support fuller-looking hair and everyday bladder comfort."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Herbans"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "mobile_carousel",
      "label": "Enable mobile carousel",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1320
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "4 / 3",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        },
        {
          "value": "3 / 2",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 6,
      "max": 32,
      "step": 2,
      "default": 22
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 20,
      "max": 140,
      "step": 4,
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 52
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 56
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_desktop_size",
      "label": "Heading desktop size",
      "min": 34,
      "max": 92,
      "step": 2,
      "default": 68
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "Heading mobile size",
      "min": 30,
      "max": 56,
      "step": 2,
      "default": 42
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFF3E8"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#5E5A55"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#E7652D"
    },
    {
      "type": "color",
      "id": "accent_soft_color",
      "label": "Soft accent background",
      "default": "#FFE1D0"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#F1C6B4"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Value card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Small icon text",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "Easy Daily Softgels"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Card text",
          "default": "Simple to take and easy to stay consistent with."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Herbans wellness cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon_text": "1",
            "title": "One Simple Daily Step",
            "text": "No complicated routine. Just easy softgels that fit into your day."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon_text": "2",
            "title": "Hair & Bladder Support",
            "text": "Supports fuller-looking hair and everyday urinary comfort from within."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon_text": "3",
            "title": "Plant-Based Ingredients",
            "text": "Made with pumpkin seed oil and saw palmetto for simple daily wellness support."
          }
        }
      ]
    }
  ]
}
{% endschema %}