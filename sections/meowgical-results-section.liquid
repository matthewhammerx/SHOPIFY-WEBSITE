{% comment %}
  Meowgical - Quick Results
  Wuffes-inspired scan-first results section with Meowgical styling.
  IMPORTANT: Replace percentage claims and source note with verified customer data before publishing.
{% endcomment %}

<section id="meowgical-quick-results-{{ section.id }}" class="meowgical-quick-results">
  <div class="mqr-wrap">

    {% if section.settings.heading != blank %}
      <div class="mqr-heading">{{ section.settings.heading }}</div>
    {% endif %}

    <div class="mqr-shell">

      <div class="mqr-box">
        <div class="mqr-box-title">
          {% if section.settings.results_icon != blank %}
            <img
              src="{{ section.settings.results_icon | image_url: width: 90 }}"
              alt=""
              loading="lazy"
              width="30"
              height="30"
            >
          {% endif %}
          <h3>{{ section.settings.results_heading }}</h3>
        </div>

        <div class="mqr-result-list">
          {% for block in section.blocks %}
            {% if block.type == 'result' %}
              <div class="mqr-result-row" {{ block.shopify_attributes }}>
                <div class="mqr-time-badge">
                  <span class="mqr-time-number">{{ block.settings.time_number }}</span>
                  <span class="mqr-time-unit">{{ block.settings.time_unit }}</span>
                </div>
                <div class="mqr-result-text">{{ block.settings.text }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.source_note != blank %}
          <div class="mqr-source-note">{{ section.settings.source_note }}</div>
        {% endif %}
      </div>

      <div class="mqr-box mqr-lookout-box">
        <div class="mqr-box-title">
          {% if section.settings.lookout_icon != blank %}
            <img src="{{ section.settings.lookout_icon | image_url: width: 90 }}" alt="" loading="lazy" width="30" height="30">
          {% endif %}
          <h3>{{ section.settings.lookout_heading }}</h3>
        </div>

        {% if section.settings.lookout_description != blank %}
          <div class="mqr-lookout-description">{{ section.settings.lookout_description }}</div>
        {% endif %}

        <div class="mqr-outcome-list">
          {% for block in section.blocks %}
            {% if block.type == 'outcome' %}
            <div class="mqr-outcome-row" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | image_url: width: 120 }}" alt="" loading="lazy" width="30" height="30">
              {% endif %}
              <span>{{ block.settings.label }}</span>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if section.settings.button_text != blank %}
        <div class="mqr-cta-wrap">
          <a href="{{ section.settings.button_link | default: '#product-form' }}" class="mqr-cta">
            {{ section.settings.button_text }}
          </a>

          {% if section.settings.guarantee_text != blank %}
            <div class="mqr-guarantee">
              {% if section.settings.guarantee_icon != blank %}
                <img
                  src="{{ section.settings.guarantee_icon | image_url: width: 80 }}"
                  alt=""
                  class="mqr-guarantee-icon"
                  loading="lazy"
                  width="24"
                  height="24"
                >
              {% endif %}
              <span>{{ section.settings.guarantee_text }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

<style>
  #meowgical-quick-results-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding:
      {{ section.settings.padding_top_mobile }}px
      {{ section.settings.padding_side_mobile }}px
      {{ section.settings.padding_bottom_mobile }}px;
  }

  #meowgical-quick-results-{{ section.id }} * {
    box-sizing: border-box;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-heading,
  #meowgical-quick-results-{{ section.id }} .mqr-heading p {
    margin: 0 0 {{ section.settings.heading_gap_mobile }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: .98;
    font-weight: 900;
    letter-spacing: -.045em;
    text-align: center;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-heading strong {
    color: {{ section.settings.heading_accent }};
    font-weight: inherit;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-shell {
    background: transparent;
    border:0;
    border-radius: {{ section.settings.shell_radius }}px;
    padding: {{ section.settings.shell_padding_mobile }}px;
    box-shadow:none;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-box {
    background: {{ section.settings.box_bg }};
    border: {{ section.settings.box_border_width }}px solid {{ section.settings.box_border_color }};
    border-radius: {{ section.settings.box_radius }}px;
    padding: {{ section.settings.box_padding_mobile }}px;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-lookout-box {
    margin-top: {{ section.settings.box_gap_mobile }}px;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-box-title {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 14px;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-box-title img {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-box-title h3 {
    margin: 0;
    color: {{ section.settings.box_heading_color }};
    font-size: {{ section.settings.box_heading_size_mobile }}px;
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: -.025em;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-lookout-description {
    max-width: 760px;
    margin: -2px 0 14px;
    color: {{ section.settings.lookout_description_color }};
    font-size: {{ section.settings.lookout_description_size_mobile }}px;
    line-height: 1.4;
    font-weight: 500;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-lookout-description p {
    margin: 0;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-result-list {
    display: grid;
    gap: {{ section.settings.result_gap_mobile }}px;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-result-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: {{ section.settings.result_bg }};
    border: {{ section.settings.inner_border_width }}px solid {{ section.settings.inner_border_color }};
    border-radius: {{ section.settings.inner_radius }}px;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-time-badge {
    width: {{ section.settings.time_badge_width_mobile }}px;
    min-height: {{ section.settings.time_badge_height_mobile }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 9px 8px;
    border-radius: {{ section.settings.time_badge_radius }}px;
    background: {{ section.settings.percent_bg }};
    color: {{ section.settings.percent_color }};
    text-align: center;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-time-number {
    display: block;
    font-size: {{ section.settings.time_number_size_mobile }}px;
    line-height: .95;
    font-weight: 900;
    letter-spacing: -.03em;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-time-unit {
    display: block;
    margin-top: 4px;
    font-size: {{ section.settings.time_unit_size_mobile }}px;
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-result-text {
    color: {{ section.settings.result_text_color }};
    font-size: {{ section.settings.result_text_size_mobile }}px;
    line-height: 1.25;
    font-weight: 800;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-source-note {
    width: calc(100% - 24px);
    max-width: 360px;
    margin: 13px auto 0;
    color: {{ section.settings.source_note_color }};
    font-size: {{ section.settings.source_note_size_mobile }}px;
    line-height: 1.35;
    text-align: center;
    font-weight: 500;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-lookout-box{
margin-top:24px;
}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-list{
background:#fff;
border:1px solid {{ section.settings.inner_border_color }};
border-radius:18px;
overflow:hidden;
}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-row{
display:flex;
align-items:center;
gap:16px;
padding:16px 20px;
border-bottom:1px solid {{ section.settings.inner_border_color }};
}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-row:last-child{border-bottom:none;}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-row img{
width:{{ section.settings.outcome_icon_size_mobile }}px;
height:{{ section.settings.outcome_icon_size_mobile }}px;
object-fit:contain;
}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-row span{
font-size:{{ section.settings.outcome_text_size_mobile }}px;
font-weight:700;
color:{{ section.settings.outcome_text_color }};
line-height:1.3;
}

#meowgical-quick-results-{{ section.id }} .mqr-cta-wrap {
    margin-top: {{ section.settings.cta_gap_mobile }}px;
    text-align: center;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, {{ section.settings.button_width_mobile }}px);
    min-height: {{ section.settings.button_height_mobile }}px;
    padding: 14px 28px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: 999px;
    {% if section.settings.button_use_gradient %}
      background: linear-gradient(
        135deg,
        {{ section.settings.button_gradient_1 }},
        {{ section.settings.button_gradient_2 }}
      );
    {% else %}
      background: {{ section.settings.button_bg }};
    {% endif %}
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.button_text_size_mobile }}px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: .01em;
    box-shadow: {{ section.settings.button_shadow }};
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-cta:hover {
    transform: translateY(-1px);
  }

  #meowgical-quick-results-{{ section.id }} .mqr-guarantee {
    margin-top: {{ section.settings.guarantee_gap_mobile }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: {{ section.settings.guarantee_color }};
    font-size: {{ section.settings.guarantee_size_mobile }}px;
    line-height: 1.25;
    font-weight: 600;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-guarantee-icon {
    flex: 0 0 auto;
    width: {{ section.settings.guarantee_icon_size_mobile }}px;
    height: {{ section.settings.guarantee_icon_size_mobile }}px;
    object-fit: contain;
  }

  @media screen and (min-width: 768px) {
    #meowgical-quick-results-{{ section.id }} {
      padding:
        {{ section.settings.padding_top_desktop }}px
        {{ section.settings.padding_side_desktop }}px
        {{ section.settings.padding_bottom_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-heading,
    #meowgical-quick-results-{{ section.id }} .mqr-heading p {
      margin-bottom: {{ section.settings.heading_gap_desktop }}px;
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-shell {
      padding: {{ section.settings.shell_padding_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-box {
      padding: {{ section.settings.box_padding_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-lookout-box {
      margin-top: {{ section.settings.box_gap_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-box-title h3 {
      font-size: {{ section.settings.box_heading_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-lookout-description {
      margin-bottom: 18px;
      font-size: {{ section.settings.lookout_description_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-result-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: {{ section.settings.result_gap_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-result-row {
      padding: {{ section.settings.result_padding_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-time-badge {
      width: {{ section.settings.time_badge_width_desktop }}px;
      min-height: {{ section.settings.time_badge_height_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-time-number {
      font-size: {{ section.settings.time_number_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-time-unit {
      font-size: {{ section.settings.time_unit_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-result-text {
      font-size: {{ section.settings.result_text_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-source-note {
      max-width: 760px;
      font-size: {{ section.settings.source_note_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-lookout-box{
margin-top:24px;
}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-list{
background:#fff;
border:1px solid {{ section.settings.inner_border_color }};
border-radius:18px;
overflow:hidden;
}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-row{
display:flex;
align-items:center;
gap:16px;
padding:16px 20px;
border-bottom:1px solid {{ section.settings.inner_border_color }};
}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-row:last-child{border-bottom:none;}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-row img{
width:{{ section.settings.outcome_icon_size_mobile }}px;
height:{{ section.settings.outcome_icon_size_mobile }}px;
object-fit:contain;
}

#meowgical-quick-results-{{ section.id }} .mqr-outcome-row span{
font-size:{{ section.settings.outcome_text_size_mobile }}px;
font-weight:700;
color:{{ section.settings.outcome_text_color }};
line-height:1.3;
}

#meowgical-quick-results-{{ section.id }} .mqr-cta-wrap {
      margin-top: {{ section.settings.cta_gap_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-cta {
      width: min(100%, {{ section.settings.button_width_desktop }}px);
      min-height: {{ section.settings.button_height_desktop }}px;
      font-size: {{ section.settings.button_text_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-guarantee {
      margin-top: {{ section.settings.guarantee_gap_desktop }}px;
      font-size: {{ section.settings.guarantee_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-guarantee-icon {
      width: {{ section.settings.guarantee_icon_size_desktop }}px;
      height: {{ section.settings.guarantee_icon_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Meowgical Quick Results",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>What to Expect With <strong>SuperTaurine</strong></p>"
    },
    {
      "type": "image_picker",
      "id": "results_icon",
      "label": "Results heading icon"
    },
    {
      "type": "text",
      "id": "results_heading",
      "label": "Results heading",
      "default": "When to Expect Results"
    },
    {
      "type": "richtext",
      "id": "source_note",
      "label": "Survey source note",
      "default": "<p>*Individual timelines and visible results may vary.</p>"
    },
    {
      "type": "image_picker",
      "id": "lookout_icon",
      "label": "Lookout heading icon"
    },
    {
      "type": "text",
      "id": "lookout_heading",
      "label": "Lookout heading",
      "default": "What to Look Out For"
    },
    {
      "type": "richtext",
      "id": "lookout_description",
      "label": "Lookout description",
      "default": "<p>As your cat gets the taurine they need every day, here's what you may begin to notice over time.</p>"
    },

    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "START NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "guarantee_icon",
      "label": "Guarantee icon"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "60-day money-back guarantee"
    },

    {
      "type": "header",
      "content": "Main sizing"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 900,
      "max": 1500,
      "step": 20,
      "default": 1180
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading mobile",
      "min": 26,
      "max": 52,
      "step": 1,
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading desktop",
      "min": 40,
      "max": 78,
      "step": 1,
      "default": 58
    },
    {
      "type": "range",
      "id": "heading_gap_mobile",
      "label": "Heading gap mobile",
      "min": 18,
      "max": 60,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_gap_desktop",
      "label": "Heading gap desktop",
      "min": 24,
      "max": 80,
      "step": 2,
      "default": 38
    },

    {
      "type": "header",
      "content": "Shell and boxes"
    },
    {
      "type": "range",
      "id": "shell_padding_mobile",
      "label": "Shell padding mobile",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "shell_padding_desktop",
      "label": "Shell padding desktop",
      "min": 16,
      "max": 60,
      "step": 2,
      "default": 22
    },
    {
      "type": "range",
      "id": "shell_radius",
      "label": "Shell radius",
      "min": 12,
      "max": 42,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "shell_border_width",
      "label": "Shell border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "box_padding_mobile",
      "label": "Box padding mobile",
      "min": 14,
      "max": 44,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "box_padding_desktop",
      "label": "Box padding desktop",
      "min": 18,
      "max": 60,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Box radius",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "box_border_width",
      "label": "Box border width",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "box_gap_mobile",
      "label": "Box gap mobile",
      "min": 12,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "box_gap_desktop",
      "label": "Box gap desktop",
      "min": 16,
      "max": 54,
      "step": 2,
      "default": 22
    },
    {
      "type": "range",
      "id": "box_heading_size_mobile",
      "label": "Box heading mobile",
      "min": 18,
      "max": 32,
      "step": 1,
      "default": 23
    },
    {
      "type": "range",
      "id": "box_heading_size_desktop",
      "label": "Box heading desktop",
      "min": 20,
      "max": 38,
      "step": 1,
      "default": 28
    },

    {
      "type": "header",
      "content": "Lookout description"
    },
    {
      "type": "range",
      "id": "lookout_description_size_mobile",
      "label": "Description size mobile",
      "min": 12,
      "max": 21,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "lookout_description_size_desktop",
      "label": "Description size desktop",
      "min": 13,
      "max": 23,
      "step": 1,
      "default": 17
    },

    {
      "type": "header",
      "content": "Result rows"
    },
    {
      "type": "range",
      "id": "result_padding_mobile",
      "label": "Result padding mobile",
      "min": 12,
      "max": 34,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "result_padding_desktop",
      "label": "Result padding desktop",
      "min": 14,
      "max": 42,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "result_gap_mobile",
      "label": "Result gap mobile",
      "min": 8,
      "max": 28,
      "step": 2,
      "default": 10
    },
    {
      "type": "range",
      "id": "result_gap_desktop",
      "label": "Result gap desktop",
      "min": 10,
      "max": 34,
      "step": 2,
      "default": 14
    },    {
      "type": "range",
      "id": "time_badge_width_mobile",
      "label": "Time badge width mobile",
      "min": 64,
      "max": 120,
      "step": 2,
      "default": 82
    },
    {
      "type": "range",
      "id": "time_badge_width_desktop",
      "label": "Time badge width desktop",
      "min": 72,
      "max": 140,
      "step": 2,
      "default": 92
    },
    {
      "type": "range",
      "id": "time_badge_height_mobile",
      "label": "Time badge height mobile",
      "min": 58,
