{%- liquid
  assign vis = ''
  unless section.settings.show_desktop
    assign vis = vis | append: ' lw-hide-desktop'
  endunless
  unless section.settings.show_mobile
    assign vis = vis | append: ' lw-hide-mobile'
  endunless
  assign col_m = 100 | divided_by: section.settings.columns_mobile | minus: 4
-%}
<div class="lw lw-ugc-home{% if section.settings.position == 'below' %} lw-section{% endif %}" data-lw-ugc-home="{{ section.id }}" data-position="{{ section.settings.position }}" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px;">
  <div class="{% if section.settings.position == 'below' %}lw-wrap{% endif %}">
    {%- if section.settings.show_desktop or section.settings.show_mobile -%}
    <div class="lw-ugc{{ vis }}" data-lw-ugc-from="{{ section.id }}">
      {%- if section.settings.heading != blank -%}<h3 class="lw-h lw-h--sm">{{ section.settings.heading }}</h3>{%- endif -%}
      <div class="lw-slider" data-lw-slider style="--lw-cols: {{ section.settings.columns_desktop }}; --lw-cols-t: {{ section.settings.columns_desktop }}; --lw-col-m: {{ col_m }}%; --lw-gap: 10px;">
        <div class="lw-slider__track">
          {%- for block in section.blocks -%}
            {%- liquid
              assign bvis = ''
              if block.settings.show_on == 'desktop'
                assign bvis = ' lw-hide-mobile'
              elsif block.settings.show_on == 'mobile'
                assign bvis = ' lw-hide-desktop'
              endif
            -%}
            <div class="lw-vid{{ bvis }}" data-lw-video {{ block.shopify_attributes }}>
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: playsinline: true, loop: true, muted: true, preload: 'metadata', image_size: '500x' }}
                <span class="lw-vid__play">{% render 'lw-icon', icon: 'play' %}</span>
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'lw-placeholder' }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="lw-vid__cap">{{ block.settings.caption }}</span>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="lw-slider__nav"><div class="lw-slider__dots"{% unless section.settings.show_dots %} hidden{% endunless %}></div>{%- if section.settings.show_arrows -%}<div class="lw-slider__arrows">
          <button type="button" data-lw-prev aria-label="Previous">{% render 'lw-icon', icon: 'arrow-left' %}</button>
          <button type="button" data-lw-next aria-label="Next">{% render 'lw-icon', icon: 'arrow-right' %}</button>
        </div>{%- endif -%}</div>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "LW · Customer videos",
  "tag": "section",
  "class": "lw-section-ugc",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers are saying:"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "media",
      "options": [
        {
          "value": "media",
          "label": "Under product image"
        },
        {
          "value": "below",
          "label": "Full-width row"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Videos visible on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Videos visible on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Video",
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "Caption sticker",
          "default": "My honest review"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (vertical 9:16)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (if no video)"
        },
        {
          "type": "select",
          "id": "show_on",
          "label": "Show on",
          "default": "both",
          "options": [
            {
              "value": "both",
              "label": "Both"
            },
            {
              "value": "desktop",
              "label": "Desktop only"
            },
            {
              "value": "mobile",
              "label": "Mobile only"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LW · Customer videos",
      "blocks": [
        {
          "type": "clip"
        },
        {
          "type": "clip"
        },
        {
          "type": "clip"
        },
        {
          "type": "clip"
        }
      ]
    }
  ]
}
{% endschema %}
