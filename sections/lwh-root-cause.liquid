<section class="lw lwh lw-section" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px; --lwh-bg: {{ section.settings.bg }};">
  <div class="lwh-wrap">
    <div class="lwh-head lwh-center">
      {%- if section.settings.eyebrow != blank -%}<span class="lwh-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="lwh-h lwh-h--lg">{{ section.settings.heading }}</h2>
    </div>
    <div class="lwh-cause__grid">
      {%- for block in section.blocks -%}
        <article class="lwh-cause lw-reveal" {{ block.shopify_attributes }}>
          <div class="lwh-cause__img{% if block.settings.image == blank %} lwh-tile lwh-tile--{{ forloop.index | modulo: 3 }}{% endif %}">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 90vw', widths: '400, 600, 900', alt: block.settings.title }}{%- else -%}<span class="lwh-tile__icon">{% render 'lw-icon', icon: block.settings.icon %}</span>{%- endif -%}</div>
          <div class="lwh-cause__body">
            <span class="lwh-cause__icon">{% render 'lw-icon', icon: block.settings.icon %}</span>
            <h3 class="lwh-h lwh-h--sm">{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

