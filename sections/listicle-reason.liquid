{% comment %}
  Listicle Reason - Custom Shopify Section
{% endcomment %}

<section id="listicle-reason-{{ section.id }}" class="mh-listicle-reason">
  <style>
    #listicle-reason-{{ section.id }} {
      background: {{ section.settings.background_color }};
      padding: {{ section.settings.padding_top_mobile }}px 20px {{ section.settings.padding_bottom_mobile }}px;
    }

    #listicle-reason-{{ section.id }} * {
      box-sizing: border-box;
    }

    #listicle-reason-{{ section.id }} .mh-reason-inner {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        "heading"
        "media"
        "body";
      gap: 16px;
    }

    #listicle-reason-{{ section.id }} .mh-reason-heading-wrap {
      grid-area: heading;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    #listicle-reason-{{ section.id }} .mh-reason-number {
      color: {{ section.settings.number_color }};
      font-size: {{ section.settings.number_size_mobile }}px;
      line-height: 1;
      letter-spacing: -0.05em;
      font-weight: 700;
    }

    #listicle-reason-{{ section.id }} .mh-reason-title {
      margin: 0;
      color: {{ section.settings.heading_color }};
      font-size: {{ section.settings.heading_size_mobile }}px;
      line-height: 1.08;
      letter-spacing: -0.05em;
      font-weight: 800;
    }

    #listicle-reason-{{ section.id }} .mh-reason-media {
      grid-area: media;
      border-radius: {{ section.settings.image_radius }}px;
      overflow: hidden;
      width: 100%;
      background: #f2f2f2;
    }

    #listicle-reason-{{ section.id }} .mh-reason-image,
    #listicle-reason-{{ section.id }} .placeholder-svg {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
      object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
    }

    #listicle-reason-{{ section.id }} .mh-reason-body {
      grid-area: body;
      color: {{ section.settings.text_color }};
      font-size: {{ section.settings.text_size_mobile }}px;
      line-height: 1.55;
      margin: 0;
    }

    #listicle-reason-{{ section.id }} .mh-reason-body p {
      margin: 0;
    }

    @media screen and (min-width: 768px) {
      #listicle-reason-{{ section.id }} {
        padding: {{ section.settings.padding_top_desktop }}px 20px {{ section.settings.padding_bottom_desktop }}px;
      }

      #listicle-reason-{{ section.id }} .mh-reason-inner {
        grid-template-columns: 1fr 1fr;
        column-gap: {{ section.settings.desktop_gap }}px;
        row-gap: 16px;
        align-items: center;

        {% if section.settings.image_side == 'left' %}
          grid-template-areas:
            "media heading"
            "media body";
        {% else %}
          grid-template-areas:
            "heading media"
            "body media";
        {% endif %}
      }

      #listicle-reason-{{ section.id }} .mh-reason-number {
        font-size: {{ section.settings.number_size_desktop }}px;
      }

      #listicle-reason-{{ section.id }} .mh-reason-title {
        font-size: {{ section.settings.heading_size_desktop }}px;
      }

      #listicle-reason-{{ section.id }} .mh-reason-body {
        font-size: {{ section.settings.text_size_desktop }}px;
      }

      #listicle-reason-{{ section.id }} .mh-reason-media {
        height: 100%;
        min-height: {{ section.settings.desktop_image_min_height }}px;
      }

      #listicle-reason-{{ section.id }} .mh-reason-image,
      #listicle-reason-{{ section.id }} .placeholder-svg {
        height: 100%;
        min-height: {{ section.settings.desktop_image_min_height }}px;
      }
    }
  </style>

  <div class="mh-reason-inner">
    <div class="mh-reason-heading-wrap">
      {% if section.settings.reason_number != blank %}
        <span class="mh-reason-number">{{ section.settings.reason_number }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="mh-reason-title">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="mh-reason-media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'mh-reason-image',
            loading: 'lazy',
            alt: section.settings.image_alt
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    {% if section.settings.text != blank %}
      <div class="mh-reason-body">
        {{ section.settings.text }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Listicle Reason",
  "settings": [
    {
      "type": "text",
      "id": "reason_number",
      "label": "Reason number",
      "default": "01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better Poops (Seriously)"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>GLP-1s are famous for slowing digestion and that often means, well, no poops. This delivers prebiotic fiber to help keep things moving and support healthy, regular digestion.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Product information image"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side on desktop",
      "default": "right",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 700,
      "max": 1400,
      "step": 50,
      "default": 1000
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_image_min_height",
      "label": "Desktop image minimum height",
      "min": 250,
      "max": 700,
      "step": 10,
      "default": 360
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image position X",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image position Y",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "number_size_desktop",
      "label": "Number size desktop",
      "min": 16,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "number_size_mobile",
      "label": "Number size mobile",
      "min": 14,
      "max": 40,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 28,
      "max": 70,
      "step": 1,
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 22,
      "max": 48,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text size desktop",
      "min": 14,
      "max": 26,
      "step": 1,
      "default": 19
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size mobile",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F8F6EC"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#7D9A2E"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#204B2A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Listicle Reason"
    }
  ]
}
{% endschema %}