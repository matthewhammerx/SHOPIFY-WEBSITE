{%- liquid
  assign lw_product = product
  if section.settings.product != blank
    assign lw_product = section.settings.product
  endif
-%}
<section class="lw lw-section lw-bundle" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px; --lw-bg: {{ section.settings.bg }}; --lw-fg: {{ section.settings.fg }}; --lw-hl: {{ section.settings.accent }}; --lw-accent: {{ section.settings.accent }};">
  <div class="lw-wrap">
    {%- if section.settings.image != blank -%}<div class="lw-bundle__hero">{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}</div>{%- endif -%}
    <div class="lw-head lw-center">
      <h2 class="lw-h lw-h--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lw-sub">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="lw-bundle__box" style="--lw-bg-card: {{ section.settings.bg }};">
      {%- if section.settings.show_stock -%}
        <div class="lw-stock" style="margin-bottom: 16px;"><div class="lw-stock__bar"><span data-lw-width="{{ section.settings.stock_percent }}%"></span></div><span>{{ section.settings.stock_text | replace: '[percent]', section.settings.stock_percent }}</span></div>
      {%- endif -%}
      {%- if lw_product != blank -%}
        {%- render 'lw-buy-box', lw_product: lw_product, bs: section.settings, section: section, main: false -%}
      {%- else -%}
        <p class="lw-center lw-sub">Select a product in the section settings.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
