      "min": -3,
      "max": 5,
      "step": 0.5,
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width desktop",
      "min": 300,
      "max": 900,
      "step": 20,
      "default": 540
    },
    {
      "type": "select",
      "id": "heading_align_desktop",
      "label": "Heading align desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Heading align mobile",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
