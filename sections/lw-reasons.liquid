<section class="lw lw-section" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px; --lw-bg: {{ section.settings.bg }}; --lw-fg: {{ section.settings.fg }}; --lw-hl: {{ section.settings.accent }}; --lw-accent: {{ section.settings.accent }};">
  <div class="lw-wrap">
    <div class="lw-head lw-center">
      {%- if section.settings.badge != blank -%}<span class="lw-pill">{{ section.settings.badge }}</span>{%- endif -%}
      <h2 class="lw-h lw-h--lg">{{ section.settings.heading }}</h2>
    </div>
    <div class="lw-slider" data-lw-slider style="--lw-cols: 3; --lw-col-m: 84%;">
      <div class="lw-slider__track">
        {%- for block in section.blocks -%}
          <article class="lw-reason" {{ block.shopify_attributes }}>
            <div class="lw-reason__img">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'lw-placeholder' }}{%- endif -%}</div>
            <div class="lw-reason__body">
              <span class="lw-reason__label">{{ section.settings.label_prefix }} {{ forloop.index }}</span>
              <h3 class="lw-reason__title">{{ block.settings.title }}</h3>
              <p class="lw-reason__text">{{ block.settings.text }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="lw-slider__nav">
      <div class="lw-slider__dots"></div>
      <div class="lw-slider__arrows">
        <button type="button" data-lw-prev aria-label="Previous">{% render 'lw-icon', icon: 'arrow-left' %}</button>
        <button type="button" data-lw-next aria-label="Next">{% render 'lw-icon', icon: 'arrow-right' %}</button>
      </div>
    </div>
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="lw-center" style="margin-top: 24px;"><a class="lw-btn lw-btn--wide" href="{{ section.settings.button_link | default: '#lw-product' }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LW · Reasons why",
  "tag": "section",
  "class": "lw-section-reasons",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "5 Reasons Why"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "LiverWell is Different From Everything You've Tried"
    },
    {
      "type": "text",
      "id": "label_prefix",
      "label": "Card label prefix",
      "default": "Reason"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try Risk-Free Today"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f1f0e8"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#111511"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent / highlighted words",
      "default": "#009370"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clinically-Dosed, Not Underdosed"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LW · Reasons why",
      "blocks": [
        {
          "type": "reason"
        },
        {
          "type": "reason"
        },
        {
          "type": "reason"
        },
        {
          "type": "reason"
        },
        {
          "type": "reason"
        }
      ]
    }
  ]
}
{% endschema %}
