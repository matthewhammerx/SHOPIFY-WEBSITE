{%- assign rows = section.blocks | where: 'type', 'row' -%}
{%- assign points = section.blocks | where: 'type', 'point' -%}
<section class="lw lw-section lw-cmp" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px; --lw-fg: {{ section.settings.fg }}; --lw-bg-grad: linear-gradient(180deg, {{ section.settings.bg }} 0%, {{ section.settings.bg_2 }} 100%); --lw-us-bg: {{ section.settings.us_bg }};">
  <div class="lw-wrap lw-cmp__grid">
    <div class="lw-cmp__table">
      <div class="lw-cmp__col lw-cmp__col--us">
        {%- if section.settings.us_image != blank -%}<div class="lw-cmp__colimg">{{ section.settings.us_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: section.settings.us_label }}</div>{%- endif -%}
        <div class="lw-cmp__head">{{ section.settings.us_label }}</div>
        {%- for block in rows -%}<div class="lw-cmp__cell" {{ block.shopify_attributes }}>{% render 'lw-icon', icon: block.settings.icon %}<span>{{ block.settings.us_text }}</span></div>{%- endfor -%}
      </div>
      <div class="lw-cmp__col lw-cmp__col--them">
        {%- if section.settings.them_image != blank -%}<div class="lw-cmp__colimg">{{ section.settings.them_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: section.settings.them_label }}</div>{%- endif -%}
        <div class="lw-cmp__head">{{ section.settings.them_label }}</div>
        {%- for block in rows -%}<div class="lw-cmp__cell">{% render 'lw-icon', icon: 'x-circle' %}<span>{{ block.settings.them_text }}</span></div>{%- endfor -%}
      </div>
    </div>
    <div class="lw-cmp__copy">
      <h2 class="lw-h lw-h--lg">{{ section.settings.heading }}</h2>
      <ul class="lw-cmp__list">
        {%- for block in points -%}<li {{ block.shopify_attributes }}>{% render 'lw-icon', icon: 'check-circle' %}<span><strong>{{ block.settings.bold }}</strong> {{ block.settings.text }}</span></li>{%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank -%}<a class="lw-btn lw-btn--cream lw-btn--block" href="{{ section.settings.button_link | default: '#lw-product' }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

