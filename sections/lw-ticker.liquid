<div class="lw lw-ticker" style="--lw-bg: {{ section.settings.bg }}; --lw-fg: {{ section.settings.fg }}; --lw-ic: {{ section.settings.icon_color }}; --lw-speed: {{ section.settings.speed }}s; --lw-ticker-border: {% if section.settings.border %}1px{% else %}0{% endif %};">
  <div class="lw-ticker__track">
    {%- for n in (1..2) -%}
      <div class="lw-ticker__group"{% if n == 2 %} aria-hidden="true"{% endif %}>
        {%- for r in (1..section.settings.repeat) -%}
          {%- for block in section.blocks -%}
            <span class="lw-ticker__item" {% if n == 1 and r == 1 %}{{ block.shopify_attributes }}{% endif %}>{% render 'lw-icon', icon: block.settings.icon %}{{ block.settings.text }}</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

