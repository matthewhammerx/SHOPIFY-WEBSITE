{% comment %}
  Reviews Carousel V2
  Grüns-style editable reviews carousel
  Added: top stars beside eyebrow/social proof line
{% endcomment %}

<section id="reviews-carousel-v2-{{ section.id }}" class="reviews-carousel-v2">
  <style>
    #reviews-carousel-v2-{{ section.id }} {
      --rc-bg: {{ section.settings.section_bg }};
      --rc-text: {{ section.settings.text_color }};
      --rc-card-bg: {{ section.settings.card_bg }};
      --rc-card-border: {{ section.settings.card_border_color }};
      --rc-headline: {{ section.settings.headline_color }};
      --rc-star: {{ section.settings.star_color }};
      --rc-header-star: {{ section.settings.header_star_color }};
      --rc-header-proof: {{ section.settings.header_proof_text_color }};
      --rc-arrow: {{ section.settings.arrow_color }};
      --rc-dot: {{ section.settings.dot_color }};
      --rc-dot-active: {{ section.settings.dot_active_color }};

      background: var(--rc-bg);
      color: var(--rc-text);
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      overflow: hidden;
      font-family: inherit;
    }

    #reviews-carousel-v2-{{ section.id }} * {
      box-sizing: border-box;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-inner {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 {{ section.settings.mobile_side_padding }}px;
      text-align: center;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-header {
      max-width: {{ section.settings.header_max_width }}px;
      margin: 0 auto {{ section.settings.header_bottom_margin }}px;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-eyebrow-row {
      display: flex;
      align-items: center;
      justify-content: {{ section.settings.header_social_align }};
      gap: {{ section.settings.header_social_gap }}px;
      flex-wrap: wrap;
      margin: 0 0 {{ section.settings.header_social_bottom }}px;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-header-stars {
      display: inline-flex;
      align-items: center;
      gap: {{ section.settings.header_star_gap }}px;
      color: var(--rc-header-star);
      line-height: 1;
      flex-shrink: 0;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-header-star {
      font-size: {{ section.settings.header_star_size_mobile }}px;
      line-height: 1;
      display: inline-block;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-eyebrow {
      margin: 0;
      font-size: {{ section.settings.eyebrow_size_mobile }}px;
      line-height: {{ section.settings.header_proof_line_height_mobile }}px;
      font-weight: {{ section.settings.header_proof_weight }};
      letter-spacing: {{ section.settings.header_proof_letter_spacing }}px;
      text-transform: {{ section.settings.header_proof_transform }};
      color: var(--rc-header-proof);
    }

    #reviews-carousel-v2-{{ section.id }} .rc-title {
      margin: 0;
      font-size: {{ section.settings.title_size_mobile }}px;
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 850;
      color: var(--rc-text);
    }

    #reviews-carousel-v2-{{ section.id }} .rc-title p {
      margin: 0;
      font: inherit;
      color: inherit;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-title strong,
    #reviews-carousel-v2-{{ section.id }} .rc-title b {
      color: var(--rc-headline);
      font-weight: inherit;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-subtitle {
      margin: 12px auto 0;
      max-width: 680px;
      font-size: {{ section.settings.subtitle_size_mobile }}px;
      line-height: 1.45;
      font-weight: 500;
      color: var(--rc-text);
      opacity: 0.9;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-subtitle p {
      margin: 0;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-carousel-wrap {
      position: relative;
      width: 100%;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-track {
      display: flex;
      gap: {{ section.settings.slide_gap_mobile }}px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding: 4px 0 8px;
      scrollbar-width: none;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-track::-webkit-scrollbar {
      display: none;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-slide {
      flex: 0 0 {{ section.settings.mobile_slide_width }}%;
      scroll-snap-align: center;
      min-width: 0;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-card {
      height: 100%;
      min-height: {{ section.settings.card_min_height_mobile }}px;
      background: var(--rc-card-bg);
      border: {{ section.settings.card_border_width }}px solid var(--rc-card-border);
      border-radius: {{ section.settings.card_radius }}px;
      padding: {{ section.settings.card_padding_mobile }}px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      text-align: left;
      box-shadow: {% if section.settings.show_card_shadow %}0 10px 28px rgba(0,0,0,0.08){% else %}none{% endif %};
    }

    #reviews-carousel-v2-{{ section.id }} .rc-review-text {
      width: 100%;
      font-size: {{ section.settings.body_size_mobile }}px;
      line-height: {{ section.settings.body_line_height | divided_by: 100.0 }};
      font-weight: {{ section.settings.body_weight }};
      color: var(--rc-text);
    }

    #reviews-carousel-v2-{{ section.id }} .rc-review-text p {
      margin: 0;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-review-text strong,
    #reviews-carousel-v2-{{ section.id }} .rc-review-text b {
      font-weight: 850;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-review-headline {
      display: inline-block;
      color: var(--rc-headline);
      font-size: {{ section.settings.headline_size_mobile }}px;
      line-height: 1.15;
      font-weight: 850;
      margin-bottom: {{ section.settings.headline_bottom_gap }}px;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-review-body {
      display: inline-block;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-reviewer {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: {{ section.settings.reviewer_top_margin }}px;
      width: 100%;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-reviewer-image {
      width: {{ section.settings.reviewer_image_size_mobile }}px;
      height: {{ section.settings.reviewer_image_size_mobile }}px;
      border-radius: 999px;
      object-fit: cover;
      flex-shrink: 0;
      background: #eee;
      border: {% if section.settings.reviewer_image_border %}1px solid var(--rc-card-border){% else %}0{% endif %};
    }

    #reviews-carousel-v2-{{ section.id }} .rc-reviewer-placeholder {
      width: {{ section.settings.reviewer_image_size_mobile }}px;
      height: {{ section.settings.reviewer_image_size_mobile }}px;
      border-radius: 999px;
      background: var(--rc-headline);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 900;
      flex-shrink: 0;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-reviewer-details {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-stars {
      display: flex;
      align-items: center;
      gap: 1px;
      color: var(--rc-star);
      line-height: 1;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-stars svg {
      width: {{ section.settings.star_size }}px;
      height: {{ section.settings.star_size }}px;
      fill: currentColor;
      display: block;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-name-row {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-reviewer-name {
      font-size: {{ section.settings.name_size_mobile }}px;
      line-height: 1.2;
      font-weight: 800;
      color: var(--rc-text);
    }

    #reviews-carousel-v2-{{ section.id }} .rc-verified {
      display: {% if section.settings.show_verified_badge %}inline-flex{% else %}none{% endif %};
      align-items: center;
      gap: 4px;
      font-size: {{ section.settings.verified_size }}px;
      line-height: 1;
      font-weight: 700;
      color: var(--rc-headline);
    }

    #reviews-carousel-v2-{{ section.id }} .rc-verified-icon {
      width: 13px;
      height: 13px;
      border-radius: 999px;
      background: var(--rc-headline);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-verified-icon svg {
      width: 9px;
      height: 9px;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-controls {
      display: {% if section.settings.show_controls %}flex{% else %}none{% endif %};
      align-items: center;
      justify-content: center;
      gap: {{ section.settings.controls_gap }}px;
      margin-top: {{ section.settings.controls_top_margin }}px;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-arrow {
      width: {{ section.settings.arrow_button_size }}px;
      height: {{ section.settings.arrow_button_size }}px;
      border-radius: 999px;
      border: {% if section.settings.arrow_button_border %}1px solid var(--rc-card-border){% else %}0{% endif %};
      background: {% if section.settings.arrow_button_bg_transparent %}transparent{% else %}var(--rc-card-bg){% endif %};
      color: var(--rc-arrow);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-arrow:hover {
      transform: translateY(-1px);
      opacity: 0.8;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-arrow svg {
      width: {{ section.settings.arrow_icon_size }}px;
      height: auto;
      display: block;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: {{ section.settings.dot_gap }}px;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-dot {
      width: {{ section.settings.dot_size }}px;
      height: {{ section.settings.dot_size }}px;
      border-radius: 999px;
      border: 0;
      padding: 0;
      background: var(--rc-dot);
      opacity: 0.35;
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
    }

    #reviews-carousel-v2-{{ section.id }} .rc-dot.is-active {
      opacity: 1;
      background: var(--rc-dot-active);
      transform: scale(1.15);
    }

    @media screen and (min-width: 768px) {
      #reviews-carousel-v2-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_desktop }}px;
        padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-inner {
        padding: 0 {{ section.settings.desktop_side_padding }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-eyebrow-row {
        justify-content: {{ section.settings.header_social_align }};
        gap: {{ section.settings.header_social_gap }}px;
        margin-bottom: {{ section.settings.header_social_bottom }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-header-stars {
        gap: {{ section.settings.header_star_gap }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-header-star {
        font-size: {{ section.settings.header_star_size_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-eyebrow {
        font-size: {{ section.settings.eyebrow_size_desktop }}px;
        line-height: {{ section.settings.header_proof_line_height_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-title {
        font-size: {{ section.settings.title_size_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-subtitle {
        font-size: {{ section.settings.subtitle_size_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-track {
        gap: {{ section.settings.slide_gap_desktop }}px;
        scroll-snap-type: x mandatory;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-slide {
        flex-basis: calc((100% - ({{ section.settings.cards_per_view_desktop | minus: 1 }} * {{ section.settings.slide_gap_desktop }}px)) / {{ section.settings.cards_per_view_desktop }});
        scroll-snap-align: start;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-card {
        min-height: {{ section.settings.card_min_height_desktop }}px;
        padding: {{ section.settings.card_padding_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-review-text {
        font-size: {{ section.settings.body_size_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-review-headline {
        font-size: {{ section.settings.headline_size_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-reviewer-image,
      #reviews-carousel-v2-{{ section.id }} .rc-reviewer-placeholder {
        width: {{ section.settings.reviewer_image_size_desktop }}px;
        height: {{ section.settings.reviewer_image_size_desktop }}px;
      }

      #reviews-carousel-v2-{{ section.id }} .rc-reviewer-name {
        font-size: {{ section.settings.name_size_desktop }}px;
      }
    }
  </style>

  <div class="rc-inner">
    {% if section.settings.show_header_stars or section.settings.eyebrow != blank or section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="rc-header">

        {% if section.settings.show_header_stars or section.settings.eyebrow != blank %}
          <div class="rc-eyebrow-row">
            {% if section.settings.show_header_stars %}
              <div class="rc-header-stars" aria-label="Rating stars">
                {% for i in (1..5) %}
                  <span class="rc-header-star">{{ section.settings.header_star_symbol }}</span>
                {% endfor %}
              </div>
            {% endif %}

            {% if section.settings.eyebrow != blank %}
              <p class="rc-eyebrow">{{ section.settings.eyebrow }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.title != blank %}
          <div class="rc-title">{{ section.settings.title }}</div>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <div class="rc-subtitle">{{ section.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="rc-carousel-wrap">
      <div class="rc-track" data-rc-track>
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="rc-slide" {{ block.shopify_attributes }}>
              <div class="rc-card">
                <div class="rc-review-text">
                  {% if block.settings.headline != blank %}
                    <span class="rc-review-headline">“{{ block.settings.headline }}</span><br>
                  {% endif %}

                  {% if block.settings.review != blank %}
                    <span class="rc-review-body">{{ block.settings.review }}</span>
                  {% endif %}
                </div>

                <div class="rc-reviewer">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 120
                      | image_tag:
                        class: 'rc-reviewer-image',
                        loading: 'lazy',
                        alt: block.settings.name
                    }}
                  {% else %}
                    <div class="rc-reviewer-placeholder">
                      {{ block.settings.name | slice: 0 }}
                    </div>
                  {% endif %}

                  <div class="rc-reviewer-details">
                    {% if section.settings.show_stars %}
                      <div class="rc-stars" aria-label="{{ block.settings.stars }} star review">
                        {% assign star_count = block.settings.stars | plus: 0 %}
                        {% for i in (1..5) %}
                          {% if i <= star_count %}
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                              <path d="M3.611 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.172 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.537.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256Z"/>
                            </svg>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}

                    <div class="rc-name-row">
                      {% if block.settings.name != blank %}
                        <span class="rc-reviewer-name">{{ block.settings.name }}</span>
                      {% endif %}

                      <span class="rc-verified">
                        <span class="rc-verified-icon">
                          <svg viewBox="0 0 18 18" fill="none">
                            <path d="M5 9l3 3 5-5" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                        {{ section.settings.verified_text }}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="rc-controls">
        <button class="rc-arrow rc-prev" type="button" aria-label="Previous review" data-rc-prev>
          <svg viewBox="0 0 18 14" fill="none">
            <path d="M16.75 6.75H.75M.75 6.75L6.75.75M.75 6.75l6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </button>

        <div class="rc-dots" data-rc-dots></div>

        <button class="rc-arrow rc-next" type="button" aria-label="Next review" data-rc-next>
          <svg viewBox="0 0 18 14" fill="none">
            <path d="M.75 6.75h16M16.75 6.75l-6 6M16.75 6.75L10.75.75" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var section = document.getElementById('reviews-carousel-v2-{{ section.id }}');
      if (!section) return;

      var track = section.querySelector('[data-rc-track]');
      var prev = section.querySelector('[data-rc-prev]');
      var next = section.querySelector('[data-rc-next]');
      var dotsWrap = section.querySelector('[data-rc-dots]');
      var slides = Array.prototype.slice.call(section.querySelectorAll('.rc-slide'));

      if (!track || !slides.length || !dotsWrap) return;

      var activeIndex = 0;

      function getStep() {
        var first = slides[0];
        if (!first) return 0;
        var rect = first.getBoundingClientRect();
        var styles = window.getComputedStyle(track);
        var gap = parseFloat(styles.columnGap || styles.gap || 0);
        return rect.width + gap;
      }

      function getActiveIndex() {
        var step = getStep();
        if (!step) return 0;
        return Math.round(track.scrollLeft / step);
      }

      function updateDots() {
        activeIndex = getActiveIndex();

        var dots = dotsWrap.querySelectorAll('.rc-dot');
        dots.forEach(function(dot, index) {
          dot.classList.toggle('is-active', index === activeIndex);
        });
      }

      function scrollToIndex(index) {
        var maxIndex = slides.length - 1;
        if (index < 0) index = maxIndex;
        if (index > maxIndex) index = 0;

        var step = getStep();
        track.scrollTo({
          left: step * index,
          behavior: 'smooth'
        });
      }

      dotsWrap.innerHTML = '';

      slides.forEach(function(slide, index) {
        var dot = document.createElement('button');
        dot.className = 'rc-dot';
        dot.type = 'button';
        dot.setAttribute('aria-label', 'Go to review ' + (index + 1));
        dot.addEventListener('click', function() {
          scrollToIndex(index);
        });
        dotsWrap.appendChild(dot);
      });

      if (prev) {
        prev.addEventListener('click', function() {
          scrollToIndex(getActiveIndex() - 1);
        });
      }

      if (next) {
        next.addEventListener('click', function() {
          scrollToIndex(getActiveIndex() + 1);
        });
      }

      var scrollTimer;
      track.addEventListener('scroll', function() {
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(updateDots, 80);
      });

      window.addEventListener('resize', updateDots);

      updateDots();

      {% if section.settings.enable_autoplay %}
        var autoplaySpeed = {{ section.settings.autoplay_speed | times: 1000 }};
        var autoplay = window.setInterval(function() {
          scrollToIndex(getActiveIndex() + 1);
        }, autoplaySpeed);

        section.addEventListener('mouseenter', function() {
          window.clearInterval(autoplay);
        });
      {% endif %}
    })();
  </script>
</section>

{% schema %}
{
  "name": "Reviews Carousel V2",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / social proof text",
      "default": "4.8/5.0 (95,000), 1M+ Customers"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Real Reviews From <strong>Herbans</strong> Users</p>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Simple daily softgels made to support healthy hair growth, scalp wellness, and reduced shedding from within.</p>"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Header max width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "default": 780
    },
    {
      "type": "range",
      "id": "header_bottom_margin",
      "label": "Header bottom margin",
      "min": 0,
      "max": 70,
      "step": 2,
      "default": 34
    },
    {
      "type": "header",
      "content": "Header stars / social proof"
    },
    {
      "type": "checkbox",
      "id": "show_header_stars",
      "label": "Show stars beside eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "header_star_symbol",
      "label": "Star symbol",
      "default": "★"
    },
    {
      "type": "select",
      "id": "header_social_align",
      "label": "Desktop alignment",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "header_social_gap",
      "label": "Gap between stars and text",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "header_social_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "header_star_gap",
      "label": "Star gap",
      "min": 0,
