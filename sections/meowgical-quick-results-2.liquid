{% comment %}
  Meowgical - Quick Results
  Layout restructured to a scan-first image + heading + checklist + CTA card, keeping the brand's existing color/gradient tokens.
{% endcomment %}

{%- if section.settings.image_position == 'right' -%}
  {%- assign image_direction = 'row-reverse' -%}
{%- else -%}
  {%- assign image_direction = 'row' -%}
{%- endif -%}

<section id="meowgical-quick-results-{{ section.id }}" class="meowgical-quick-results" style="--mqr-image-direction: {{ image_direction }};">
  <div class="mqr-wrap">
    <div class="mqr-row">

      {% if section.settings.image != blank %}
        <div class="mqr-image">
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 768px) 600px, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="eager"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        </div>
      {% endif %}

      <div class="mqr-content">

        {% if section.settings.heading != blank %}
          <div class="mqr-heading">{{ section.settings.heading }}</div>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="mqr-subheading">{{ section.settings.subheading }}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="mqr-checklist">
            {% for block in section.blocks %}
              <div class="mqr-checklist-item" {{ block.shopify_attributes }}>
                <span class="mqr-check-icon">
                  {% if block.settings.icon != blank %}
                    <img src="{{ block.settings.icon | image_url: width: 60 }}" alt="" loading="lazy" width="20" height="20">
                  {% else %}
                    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% endif %}
                </span>
                <span class="mqr-checklist-text">{{ block.settings.text }}</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <div class="mqr-cta-wrap">
            <a href="{{ section.settings.button_link | default: '#product-form' }}" class="mqr-cta">
              {{ section.settings.button_text }}
            </a>

            {% if section.settings.guarantee_text != blank %}
              <div class="mqr-guarantee">{{ section.settings.guarantee_text }}</div>
            {% endif %}
          </div>
        {% endif %}

      </div>

    </div>
  </div>
</section>

<style>
  #meowgical-quick-results-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding:
      {{ section.settings.padding_top_mobile }}px
      {{ section.settings.padding_side_mobile }}px
      {{ section.settings.padding_bottom_mobile }}px;
  }

  #meowgical-quick-results-{{ section.id }} * {
    box-sizing: border-box;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-row {
    display: flex;
    flex-direction: column;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-image {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    margin-bottom: {{ section.settings.image_gap_mobile }}px;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-content {
    min-width: 0;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-heading,
  #meowgical-quick-results-{{ section.id }} .mqr-heading p {
    margin: 0 0 {{ section.settings.heading_gap_mobile }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -.02em;
    text-align: center;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-heading strong,
  #meowgical-quick-results-{{ section.id }} .mqr-heading em {
    color: {{ section.settings.heading_accent }};
    font-weight: inherit;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-heading em {
    font-style: italic;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-subheading,
  #meowgical-quick-results-{{ section.id }} .mqr-subheading p {
    margin: 0 auto {{ section.settings.subheading_gap_mobile }}px;
    max-width: 44ch;
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size_mobile }}px;
    line-height: 1.4;
    font-weight: 500;
    text-align: center;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-checklist {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.checklist_gap_mobile }}px;
    margin-bottom: {{ section.settings.cta_gap_mobile }}px;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-checklist-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: {{ section.settings.checklist_padding_mobile }}px 18px;
    background: {{ section.settings.checklist_bg }};
    border: {{ section.settings.checklist_border_width }}px solid {{ section.settings.checklist_border_color }};
    border-radius: {{ section.settings.checklist_radius }}px;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-check-icon {
    flex: 0 0 auto;
    width: {{ section.settings.check_icon_size_mobile }}px;
    height: {{ section.settings.check_icon_size_mobile }}px;
    border-radius: 50%;
    background: {{ section.settings.check_icon_bg }};
    color: {{ section.settings.check_icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-check-icon svg {
    width: 45%;
    height: 45%;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-check-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-checklist-text,
  #meowgical-quick-results-{{ section.id }} .mqr-checklist-text p {
    margin: 0;
    color: {{ section.settings.checklist_text_color }};
    font-size: {{ section.settings.checklist_text_size_mobile }}px;
    line-height: 1.35;
    font-weight: 500;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-checklist-text strong,
  #meowgical-quick-results-{{ section.id }} .mqr-checklist-text em {
    font-weight: 700;
    font-style: italic;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-cta-wrap {
    text-align: center;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, {{ section.settings.button_width_mobile }}px);
    min-height: {{ section.settings.button_height_mobile }}px;
    padding: 14px 28px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: 999px;
    {% if section.settings.button_use_gradient %}
      background: linear-gradient(
        135deg,
        {{ section.settings.button_gradient_1 }},
        {{ section.settings.button_gradient_2 }}
      );
    {% else %}
      background: {{ section.settings.button_bg }};
    {% endif %}
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.button_text_size_mobile }}px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: .01em;
    box-shadow: {{ section.settings.button_shadow }};
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #meowgical-quick-results-{{ section.id }} .mqr-cta:hover {
    transform: translateY(-1px);
  }

  #meowgical-quick-results-{{ section.id }} .mqr-guarantee {
    margin-top: {{ section.settings.guarantee_gap_mobile }}px;
    color: {{ section.settings.guarantee_color }};
    font-size: {{ section.settings.guarantee_size_mobile }}px;
    line-height: 1.25;
    font-weight: 600;
  }

  @media screen and (min-width: 768px) {
    #meowgical-quick-results-{{ section.id }} {
      padding:
        {{ section.settings.padding_top_desktop }}px
        {{ section.settings.padding_side_desktop }}px
        {{ section.settings.padding_bottom_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-row {
      flex-direction: var(--mqr-image-direction, row);
      align-items: center;
      gap: {{ section.settings.column_gap_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-image {
      flex: 0 0 {{ section.settings.image_width_desktop }}%;
      margin-bottom: 0;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-content {
      flex: 1 1 0%;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-heading,
    #meowgical-quick-results-{{ section.id }} .mqr-heading p {
      margin-bottom: {{ section.settings.heading_gap_desktop }}px;
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-subheading,
    #meowgical-quick-results-{{ section.id }} .mqr-subheading p {
      margin-bottom: {{ section.settings.subheading_gap_desktop }}px;
      font-size: {{ section.settings.subheading_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-checklist {
      max-width: {{ section.settings.checklist_max_width_desktop }}px;
      margin-left: auto;
      margin-right: auto;
      gap: {{ section.settings.checklist_gap_desktop }}px;
      margin-bottom: {{ section.settings.cta_gap_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-checklist-item {
      padding: {{ section.settings.checklist_padding_desktop }}px 24px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-check-icon {
      width: {{ section.settings.check_icon_size_desktop }}px;
      height: {{ section.settings.check_icon_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-checklist-text,
    #meowgical-quick-results-{{ section.id }} .mqr-checklist-text p {
      font-size: {{ section.settings.checklist_text_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-cta {
      width: min(100%, {{ section.settings.button_width_desktop }}px);
      min-height: {{ section.settings.button_height_desktop }}px;
      font-size: {{ section.settings.button_text_size_desktop }}px;
    }

    #meowgical-quick-results-{{ section.id }} .mqr-guarantee {
      margin-top: {{ section.settings.guarantee_gap_desktop }}px;
      font-size: {{ section.settings.guarantee_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Meowgical Quick Results",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Results in as Little as <em>3 Weeks!</em></p>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>If you're not happy after 3 months of consistent use, we'll refund you.</p>"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "GET 50% OFF →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee line",
      "default": "Arrives in 3-5 Days | 60-Day Money Back Guarantee"
    },

    {
      "type": "header",
      "content": "Main sizing"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 400,
      "max": 1300,
      "step": 20,
      "default": 1100
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 20,
      "max": 44,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 24,
      "max": 54,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_gap_mobile",
      "label": "Heading gap mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_gap_desktop",
      "label": "Heading gap desktop",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading size desktop",
      "min": 13,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_gap_mobile",
      "label": "Subheading gap mobile",
      "min": 12,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_gap_desktop",
      "label": "Subheading gap desktop",
      "min": 12,
      "max": 56,
      "step": 2,
      "default": 28
    },

    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Image width (desktop)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "label": "Space between image and text (desktop)",
      "min": 16,
      "max": 160,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "image_gap_mobile",
      "label": "Space between image and text (mobile)",
      "min": 8,
      "max": 64,
      "step": 2,
      "default": 24
    },

    {
      "type": "header",
      "content": "Checklist"
    },
    {
      "type": "range",
      "id": "checklist_max_width_desktop",
      "label": "Checklist max width desktop",
      "min": 400,
      "max": 900,
      "step": 20,
      "default": 640
    },
    {
      "type": "range",
      "id": "checklist_gap_mobile",
      "label": "Checklist row gap mobile",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 10
    },
    {
      "type": "range",
      "id": "checklist_gap_desktop",
      "label": "Checklist row gap desktop",
      "min": 4,
      "max": 28,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "checklist_padding_mobile",
      "label": "Checklist item padding mobile",
      "min": 8,
      "max": 30,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "checklist_padding_desktop",
      "label": "Checklist item padding desktop",
      "min": 10,
      "max": 34,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "checklist_radius",
      "label": "Checklist item radius",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 30
    },
    {
      "type": "range",
      "id": "checklist_border_width",
      "label": "Checklist border width",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "check_icon_size_mobile",
      "label": "Check icon size mobile",
      "min": 18,
      "max": 40,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "check_icon_size_desktop",
      "label": "Check icon size desktop",
      "min": 20,
      "max": 44,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "checklist_text_size_mobile",
      "label": "Checklist text size mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "checklist_text_size_desktop",
      "label": "Checklist text size desktop",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 16
    },

    {
      "type": "header",
      "content": "CTA sizing"
    },
    {
      "type": "range",
      "id": "cta_gap_mobile",
      "label": "Space above button mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "cta_gap_desktop",
      "label": "Space above button desktop",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "button_width_mobile",
      "label": "Button width mobile",
      "min": 220,
      "max": 480,
      "step": 10,
      "default": 380
    },
    {
      "type": "range",
      "id": "button_width_desktop",
      "label": "Button width desktop",
      "min": 240,
      "max": 560,
      "step": 10,
      "default": 420
    },
    {
      "type": "range",
      "id": "button_height_mobile",
      "label": "Button height mobile",
      "min": 44,
      "max": 76,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "button_height_desktop",
      "label": "Button height desktop",
      "min": 48,
      "max": 84,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "button_text_size_mobile",
      "label": "Button text size mobile",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "button_text_size_desktop",
      "label": "Button text size desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "guarantee_gap_mobile",
      "label": "Guarantee top spacing mobile",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "guarantee_gap_desktop",
      "label": "Guarantee top spacing desktop",
      "min": 4,
      "max": 34,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "guarantee_size_mobile",
      "label": "Guarantee text size mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "guarantee_size_desktop",
      "label": "Guarantee text size desktop",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 13
    },

    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 20,
      "max": 140,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 20,
      "max": 140,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_side_mobile",
      "label": "Side padding mobile",
      "min": 10,
      "max": 30,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 40,
      "max": 180,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 40,
      "max": 180,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_side_desktop",
      "label": "Side padding desktop",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 40
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#F6F7FC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "#3456D1"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "checklist_bg",
      "label": "Checklist item background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "checklist_border_color",
      "label": "Checklist item border",
      "default": "#D9DFF4"
    },
    {
      "type": "color",
      "id": "checklist_text_color",
      "label": "Checklist text",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "check_icon_bg",
      "label": "Check icon background",
      "default": "#3456D1"
    },
    {
      "type": "color",
