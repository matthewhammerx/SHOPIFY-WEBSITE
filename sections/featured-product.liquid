<section
  id="MainProduct-{{ section.id }}"
  class="page-width section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
>
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.desktop_padding_top }}px;
        padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      }
    }

    #MediaGallery-{{ section.id }} {
      --desktop-thumbnails: {{ section.settings.desktop_thumbnails_count }};
      --desktop-vertical-thumbnails-width: {{ section.settings.desktop_vertical_thumbnails_width }}%;
      --mobile-thumbnails: {{ section.settings.mobile_thumbnails_count }};
      --mobile-vertical-thumbnails-width: {{ section.settings.mobile_vertical_thumbnails_width }}%;
    }
    @media screen and (max-width: 749px) {
      #MediaGallery-{{ section.id }} {
        --media-radius: {{ section.settings.mobile_media_corner_radius }}px;
        --grid-mobile-horizontal-spacing: {{ section.settings.mobile_spacing_pixels }}px;
        --mobile-scroll-padding: calc({{ section.settings.mobile_scroll_padding_percentage }}% + {{ section.settings.mobile_scroll_padding_pixels }}px);
        --slide-container-percentage-width: {{ section.settings.mobile_slides_container_width }}%;
        --slide-inner-percentage-width: {{ section.settings.mobile_slides_inner_width }}%;
      }
    }


    /* ===== HERBANS FULL-WIDTH BADGE ABOVE PRODUCT GRID ===== */
    #MainProduct-{{ section.id }} .herbans-full-product-badge-wrap {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0 0 22px;
    }

    #MainProduct-{{ section.id }} .herbans-full-product-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      max-width: calc(100% - 32px);
      background: #fff2c7;
      color: #111;
      padding: 8px 22px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 800;
      line-height: 1.1;
      text-align: center;
      white-space: nowrap;
      letter-spacing: 0.1px;
    }

    @media screen and (max-width: 749px) {
      #MainProduct-{{ section.id }} .herbans-full-product-badge-wrap {
        margin-bottom: 14px;
      }

      #MainProduct-{{ section.id }} .herbans-full-product-badge {
        font-size: 13px;
        padding: 8px 18px;
      }
    }

    /* ===== OPTIONAL IMAGE INSIDE COLLAPSIBLE ROWS ===== */
    #MainProduct-{{ section.id }} .accordion-image {
      width: 100%;
      margin-top: 18px;
      overflow: hidden;
      border-radius: 12px;
    }

    #MainProduct-{{ section.id }} .accordion-image img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
      margin: 0;
      border-radius: inherit;
    }

    @media screen and (max-width: 749px) {
      #MainProduct-{{ section.id }} .accordion-image {
        margin-top: 14px;
        border-radius: 10px;
      }
    }

  {%- endstyle -%}

  {%- liquid
    assign product = section.settings.product
  -%}

  {% if product == blank %}
    <div class="page-width" style="padding: 30px 0; text-align: center;">
      <strong>Select a product in this section settings.</strong>
    </div>
  {% else %}


  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  {% if section.settings.display_id %}
    <copy-button class='section-id-btn button' data-content="#shopify-section-{{ section.id }}" data-success="false">
      <span class="copy-text">Click to copy section ID</span>
      <span class="copy-success">ID copied successfully!</span>
    </copy-button>
  {% endif %}

  {%- liquid
    assign has_filtering = false
    if section.settings.variant_image_filtering != 'none'
      assign has_filtering = true
    endif
  
    assign hide_variants_enabled = false
    if section.settings.hide_variants and has_filtering != true
      assign hide_variants_enabled = true
    endif
  
    if hide_variants_enabled and variant_images.size == product.media.size
      assign single_media_visible = true
    endif
  
    assign media_count = product.media.size
    if hide_variants_enabled and media_count > 1 and variant_images.size > 0
      assign media_count = media_count | minus: variant_images.size | plus: 1
    endif
  
    if media_count == 1 or single_media_visible
      assign single_media_visible_mobile = true
    endif
  
    if media_count == 0 or single_media_visible_mobile or section.settings.mobile_thumbnails_position != 'hidden' and media_count < 3
      assign hide_mobile_slider = true
    endif
  -%}
 {% if product.tags contains 'show-3rd-party-tested' %}
  <div class="herbans-full-product-badge-wrap">
    <div class="herbans-full-product-badge">
      3rd-Party Tested
    </div>
  </div>
{% endif %}

  <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
    <div class="grid__item product__media-wrapper{% if section.settings.media_position == 'right' %} medium-hide large-up-hide{% endif %}{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}">
      {% render 'product-media-gallery', product: product, variant_images: variant_images, has_filtering: has_filtering, section: section %}
    </div>
    <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}{% if section.settings.mobile_pagination == 'dots_overlay' or hide_mobile_slider %} product__info-wrapper--top-padding{% endif %}">
      <product-info
        id="ProductInfo-{{ section.id }}"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
        class="product__info-container main-product__info-container"
      >
        {%- assign product_form_id = 'product-form-' | append: section.id -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'text' -%}
              {% render 'text-with-icon-block', block: block, margins: true, block_attributes: true %}
            {%- when 'title' -%}
              <div class="product__title" {{ block.shopify_attributes }} style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;">
                <h1 class="{{ block.settings.text_size }}{% if block.settings.uppercase_title %} product-title--uppercase{% endif %}{% if block.settings.title_alignment == 'center' %} center{% endif %}">
                  {{ product.title }}
                </h1>
                <a href="{{ product.url }}" class="product__title">
                  <h2 class="h1">
                    {{ product.title }}
                  </h2>
                </a>
              </div>
            {% when 'rating_stars' %}
              {% render 'rating-stars-block', block: block, margins: true, block_attributes: true %}
            {% when 'trustpilot_stars' %}
              {% render 'trustpilot-stars-block', block: block, margins: true, block_attributes: true %}
            {%- when 'price' -%}
              <div class="no-js-hidden product-page-price" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }} style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;">
                {% liquid 
                  assign price_second = false
                  if block.settings.layout == 'price_second'
                    assign price_second = true
                  endif
                %}
                {%- render 'price',
                  product: product,
                  block: block,
                  use_variant: true,
                  show_badges: true,
                  hide_sale_badge: block.settings.hide_sale_badge,
                  price_class: 'price--large',
                  price_second: price_second,
                  main_price: true
                -%}
              </div>
              <div {{ block.shopify_attributes }}>
                {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              </div>
            {% when 'clickable_discount' %}
              <div style='--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;' {{ block.shopify_attributes }}>
                {% if block.settings.discount_code != blank %}
                  <clickable-discount class='clickable-discount' data-applied='false' data-code="{{ block.settings.discount_code }}" data-loading="false" data-error='false' style='--mobile-text-size: {{ block.settings.mobile_text_size | divided_by: 10.0 }}rem;--desktop-text-size: {{ block.settings.desktop_text_size | divided_by: 10.0 }}rem;--padding:{{ block.settings.padding | divided_by: 7.0 }}em;--corner-radius:{{ block.settings.corner_radius | divided_by: 100.0 }}em;--alignment:{{ block.settings.alignment }};'>
                    <button class='clickable-discount__btn'>
                      <div class='clickable-discount__btn__text-1 product__text-container product__text-container--{{ block.settings.alignment }}{% if block.settings.enable_bg %} product__text-container--background{% endif %}'  style='--bg-color:{{ block.settings.bg_color_1 }};--icon-scale:{{ block.settings.icon_scale | divided_by: 100.0 }};' >
                        <p class="product__text product__text-{{ block.settings.alignment }}" style="--text-color:{{ block.settings.text_color_1 }};--icon-color:{{ block.settings.icon_color_1 }};">
                          {% if block.settings.custom_icon_1 != blank %}
                            <img
                              src="{{ block.settings.custom_icon_1 | image_url }}"
                              alt="{{ block.settings.custom_icon_1.alt }}"
                              width='auto'
                              height='auto'
                              loading='lazy'
                            >
                          {% elsif block.settings.icon_1 != blank %}
                            {% render 'material-icon', icon: block.settings.icon_1, filled: block.settings.filled_icon_1 %}
                          {% endif %}
                          <span class='product__text__text'>{{- block.settings.text_1 -}}</span>
                          <svg
                            aria-hidden="true"
                            focusable="false"
                            class="spinner"
                            viewBox="0 0 66 66"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                          </svg>
                        </p>
                      </div>
                      <div class='clickable-discount__btn__text-2 product__text-container product__text-container--{{ block.settings.alignment }}{% if block.settings.enable_bg %} product__text-container--background{% endif %}'  style='--bg-color:{{ block.settings.bg_color_2 }};--icon-scale:{{ block.settings.icon_scale | divided_by: 100.0 }};' >
                        <p class="product__text product__text-{{ block.settings.alignment }}" style="--text-color:{{ block.settings.text_color_2 }};--icon-color:{{ block.settings.icon_color_2 }};">
                          {% if block.settings.custom_icon_2 != blank %}
                            <img
                              src="{{ block.settings.custom_icon_2 | image_url }}"
                              alt="{{ block.settings.custom_icon_2.alt }}"
                              width='auto'
                              height='auto'
                              loading='lazy'
                            >
                          {% elsif block.settings.icon_2 != blank %}
                            {% render 'material-icon', icon: block.settings.icon_2, filled: block.settings.filled_icon_2 %}
                          {% endif %}
                          <span class='product__text__text'>{{- block.settings.text_2 -}}</span>
                        </p>
                      </div>
                    </button>
                  </clickable-discount>
                  <p class='clickable-discount__error'>An error has occured. Please try again.</p>
                {% else %}
                  <h4>Enter a discount code in block settings</h4>
                {% endif %}
              </div>
            {%- when 'inventory' -%}
              <p
                class="product__inventory no-js-hidden{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                {{ block.shopify_attributes }}
                id="Inventory-{{ section.id }}"
                role="status"
                style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;"
              >
                {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                  {%- if product.selected_or_first_available_variant.inventory_quantity <= block.settings.inventory_threshold -%}
                    <svg width="15" height="15" aria-hidden="true">
                      <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(238,148,65, 0.3)"/>
                      <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(238,148,65)"/>
                    </svg>
                    {%- if block.settings.show_inventory_quantity -%}
                      {{- 'products.product.inventory_low_stock_show_count' | t: quantity: product.selected_or_first_available_variant.inventory_quantity -}}
                    {%- else -%}
                      {{- 'products.product.inventory_low_stock' | t -}}
                    {%- endif -%}
                  {%- else -%}
                    <svg width="15" height="15" aria-hidden="true">
                      <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(62,214,96, 0.3)"/>
                      <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(62,214,96)"/>
                    </svg>
                    {%- if block.settings.show_inventory_quantity -%}
                      {{- 'products.product.inventory_in_stock_show_count' | t: quantity: product.selected_or_first_available_variant.inventory_quantity -}}
                    {%- else -%}
                        {{- 'products.product.inventory_in_stock' | t -}}
                    {%- endif -%}
                  {%- endif -%}
                {%- else -%}
                  {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                    <svg width="15" height="15" aria-hidden="true">
                      <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(62,214,96, 0.3)"/>
                      <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(62,214,96)"/>
                    </svg>
                    {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                  {%- else -%}
                    <svg width="15" height="15" aria-hidden="true">
                      <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(200,200,200, 0.3)"/>
                      <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(200,200,200)"/>
                    </svg>
                    {{- 'products.product.inventory_out_of_stock' | t -}}
                  {%- endif -%}
                {%- endif -%}
              </p>
            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }} style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;">
                  {{ product.description }}
                </div>
              {%- endif -%}
            {%- when 'sku' -%}
              <p
                class="product__sku no-js-hidden{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                id="Sku-{{ section.id }}"
                role="status"
                {{ block.shopify_attributes }}
                style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;"
              >
                <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span> {{- product.selected_or_first_available_variant.sku -}}
              </p>
            {%- when 'cat_bundle_subscribe' -%}
              {%- liquid
                assign cb_selling_plan_group = null
                if block.settings.selling_plan_group_name != blank
                  for cb_group in product.selling_plan_groups
                    if cb_group.name == block.settings.selling_plan_group_name
                      assign cb_selling_plan_group = cb_group
                    endif
                  endfor
                endif
                if cb_selling_plan_group == null and product.selling_plan_groups.size > 0
                  assign cb_selling_plan_group = product.selling_plan_groups.first
                endif
                assign cb_default_selling_plan = cb_selling_plan_group.selling_plans.first

                assign cb_selling_plan_allocation = null
                if cb_default_selling_plan
                  for cb_allocation in product.selected_or_first_available_variant.selling_plan_allocations
                    if cb_allocation.selling_plan.id == cb_default_selling_plan.id
                      assign cb_selling_plan_allocation = cb_allocation
                    endif
                  endfor
                endif

                assign cb_features = block.settings.subscribe_features | split: ','
                assign cb_cons = block.settings.onetime_cons | split: ','

                assign cb_plan60_selling_plan = null
                if block.settings.plan60_selling_plan_name != blank
                  for cb_group3 in product.selling_plan_groups
                    for cb_plan3 in cb_group3.selling_plans
                      if cb_plan3.name == block.settings.plan60_selling_plan_name
                        assign cb_plan60_selling_plan = cb_plan3
                      endif
                    endfor
                  endfor
                endif
                if cb_plan60_selling_plan == null
                  for cb_group4 in product.selling_plan_groups
                    for cb_plan4 in cb_group4.selling_plans
                      if cb_plan4.id == 3022946457
                        assign cb_plan60_selling_plan = cb_plan4
                      endif
                    endfor
                  endfor
                endif
                if cb_plan60_selling_plan == null
                  assign cb_plan60_selling_plan = cb_default_selling_plan
                endif

                assign cb_plan60_allocation = null
                if cb_plan60_selling_plan
                  for cb_alloc60 in product.selected_or_first_available_variant.selling_plan_allocations
                    if cb_alloc60.selling_plan.id == cb_plan60_selling_plan.id
                      assign cb_plan60_allocation = cb_alloc60
                    endif
                  endfor
                endif
                assign cb_plan60_unit_price = product.selected_or_first_available_variant.price
                if cb_plan60_allocation
                  assign cb_plan60_unit_price = cb_plan60_allocation.price
                endif
              -%}
              <div
                class="cat-bundle"
                id="CatBundle-{{ block.id }}"
                {{ block.shopify_attributes }}
                style="
                  --cb-accent:{{ block.settings.accent_color }};
                  --cb-accent-bg:{{ block.settings.accent_bg_color }};
                  --cb-accent-text:{{ block.settings.accent_text_color }};
                  --cb-radius:{{ block.settings.corner_radius }}px;
                  --cb-heading-color:{{ block.settings.heading_text_color }};
                  --cb-toggle-border:{{ block.settings.toggle_border_color }};
                  --cb-toggle-text:{{ block.settings.toggle_text_color }};
                  --cb-option-border:{{ block.settings.option_border_color }};
                  --cb-radio-dot:{{ block.settings.radio_dot_color }};
                  --cb-title-color:{{ block.settings.title_text_color }};
                  --cb-detail-color:{{ block.settings.detail_text_color }};
                  --cb-price-color:{{ block.settings.price_text_color }};
                  --cb-compare-color:{{ block.settings.compare_price_color }};
                  --cb-per-day-color:{{ block.settings.per_day_text_color }};
                  --cb-check-color:{{ block.settings.checkmark_color }};
                  --cb-x-color:{{ block.settings.x_icon_color }};
                  --cb-feature-text-color:{{ block.settings.feature_text_color }};
                  --cb-con-text-color:{{ block.settings.con_text_color }};
                  --cb-divider-color:{{ block.settings.divider_color }};
                  --cb-gifts-badge-bg:{{ block.settings.gifts_badge_bg_color }};
                  --cb-gifts-badge-text:{{ block.settings.gifts_badge_text_color }};
                  --cb-gift-corner-bg:{{ block.settings.gift_corner_badge_bg_color }};
                  --cb-gift-corner-text:{{ block.settings.gift_corner_badge_text_color }};
                  --cb-gift-title-color:{{ block.settings.gift_title_color }};
                  --cb-gift-image-size:{{ block.settings.gift_image_size }}px;
                  --cb-gift-image-radius:{{ block.settings.gift_image_radius }}px;
                  --cb-gifts-bg:{{ block.settings.gifts_card_bg_color }};
                  --cb-heading-size:{{ block.settings.heading_font_size | divided_by: 10.0 }}rem;
                  --cb-toggle-size:{{ block.settings.toggle_font_size | divided_by: 10.0 }}rem;
                  --cb-banner-size:{{ block.settings.banner_font_size | divided_by: 10.0 }}rem;
                  --cb-title-size:{{ block.settings.option_title_font_size | divided_by: 10.0 }}rem;
                  --cb-detail-size:{{ block.settings.detail_font_size | divided_by: 10.0 }}rem;
                  --cb-price-size:{{ block.settings.price_font_size | divided_by: 10.0 }}rem;
                  --cb-price-suffix-size:{{ block.settings.price_suffix_font_size | divided_by: 10.0 }}rem;
                  --cb-compare-size:{{ block.settings.compare_price_font_size | divided_by: 10.0 }}rem;
                  --cb-per-day-size:{{ block.settings.per_day_font_size | divided_by: 10.0 }}rem;
                  --cb-gifts-heading-size:{{ block.settings.gifts_heading_font_size | divided_by: 10.0 }}rem;
                  --cb-gift-title-size:{{ block.settings.gift_title_font_size | divided_by: 10.0 }}rem;
                  --cb-sub60-best-bg:{{ block.settings.plan60_best_value_bg_color }};
                  --cb-sub60-best-text:{{ block.settings.plan60_best_value_text_color }};
                  --margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;
                  --margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;
                "
                data-interval-days="{{ block.settings.interval_days }}"
              >
                {%- assign cb_has_tiers = false -%}
                {%- for i in (1..3) -%}
                  {%- assign cb_qty_key = 'cat_' | append: i | append: '_quantity' -%}
                  {%- if block.settings[cb_qty_key] > 0 -%}{%- assign cb_has_tiers = true -%}{%- endif -%}
                {%- endfor -%}

                {%- if cb_has_tiers -%}
                  <h3 class="cat-bundle__heading">{{ block.settings.heading_text }}</h3>
                  <div class="cat-bundle__toggle" role="radiogroup" aria-label="{{ block.settings.heading_text }}">
                    {%- assign cb_first_tier_rendered = false -%}
                    {%- for i in (1..3) -%}
                      {%- assign cb_qty_key = 'cat_' | append: i | append: '_quantity' -%}
                      {%- assign cb_label_key = 'cat_' | append: i | append: '_label' -%}
                      {%- assign cb_plan_name_key = 'cat_' | append: i | append: '_selling_plan_name' -%}
                      {%- assign cb_qty = block.settings[cb_qty_key] -%}
                      {%- if cb_qty > 0 -%}
                        {%- assign cb_tier_plan_name = block.settings[cb_plan_name_key] -%}
                        {%- assign cb_tier_selling_plan = cb_default_selling_plan -%}
                        {%- if cb_tier_plan_name != blank -%}
                          {%- assign cb_tier_matched_plan = null -%}
                          {%- for cb_group2 in product.selling_plan_groups -%}
                            {%- for cb_plan2 in cb_group2.selling_plans -%}
                              {%- if cb_plan2.name == cb_tier_plan_name -%}
                                {%- assign cb_tier_matched_plan = cb_plan2 -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endfor -%}
                          {%- if cb_tier_matched_plan -%}
                            {%- assign cb_tier_selling_plan = cb_tier_matched_plan -%}
                          {%- endif -%}
                        {%- endif -%}
                        {%- assign cb_tier_allocation = null -%}
                        {%- if cb_tier_selling_plan -%}
                          {%- for cb_alloc in product.selected_or_first_available_variant.selling_plan_allocations -%}
                            {%- if cb_alloc.selling_plan.id == cb_tier_selling_plan.id -%}
                              {%- assign cb_tier_allocation = cb_alloc -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                        {%- assign cb_tier_subscribe_unit_price = product.selected_or_first_available_variant.price -%}
                        {%- if cb_tier_allocation -%}
                          {%- assign cb_tier_subscribe_unit_price = cb_tier_allocation.price -%}
                        {%- endif -%}
                        <button
                          type="button"
                          class="cat-bundle__toggle-btn{% unless cb_first_tier_rendered %} cat-bundle__toggle-btn--selected{% endunless %}"
                          data-qty="{{ cb_qty }}"
                          data-cb-tier="{{ i }}"
                          data-selling-plan-id="{{ cb_tier_selling_plan.id }}"
                          data-subscribe-unit-price="{{ cb_tier_subscribe_unit_price }}"
                          role="radio"
                          aria-checked="{% unless cb_first_tier_rendered %}true{% else %}false{% endunless %}"
                        >
                          {{ block.settings[cb_label_key] }}
                        </button>
                        {%- assign cb_first_tier_rendered = true -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <input type="hidden" name="quantity" value="1" form="{{ product_form_id }}" data-cb-quantity-input>
                {%- if cb_default_selling_plan -%}
                  <input type="hidden" name="selling_plan" value="{{ cb_default_selling_plan.id }}" form="{{ product_form_id }}" data-cb-selling-plan-input>
                {%- endif -%}

                <div class="cat-bundle__sub-plans" data-cb-sub-plans>
                <h3 class="cat-bundle__heading cat-bundle__heading--sub">{{ block.settings.subscription_heading }}</h3>

                <div class="cat-bundle__option cat-bundle__option--subscribe cat-bundle__option--selected" data-cb-option="subscribe" role="radio" aria-checked="true" tabindex="0">
                  {%- if block.settings.banner_text != blank -%}
                    <div class="cat-bundle__banner">{{ block.settings.banner_text }}</div>
                  {%- endif -%}
                  <div class="cat-bundle__option-inner">
                    <div class="cat-bundle__option-row">
                      <div class="cat-bundle__option-left">
                        <span class="cat-bundle__radio-dot"></span>
                        <div>
                          <div class="cat-bundle__option-title">{{ block.settings.subscribe_label }}</div>
                          <div class="cat-bundle__option-detail" data-cb-subscribe-detail>{{ block.settings.subscribe_detail_text }}</div>
                        </div>
                      </div>
                      <div class="cat-bundle__option-price">
                        <div class="cat-bundle__price-row">
                          <span class="cat-bundle__price" data-cb-price="subscribe">{{ 0 | money }}</span>
                          <s class="cat-bundle__compare-price" data-cb-compare="subscribe">{{ 0 | money }}</s>
                        </div>
                        <div class="cat-bundle__per-day" data-cb-per-day="subscribe"></div>
                      </div>
                    </div>

                    <hr class="cat-bundle__divider">

                    {%- if cb_features.size > 0 -%}
                      <ul class="cat-bundle__feature-list">
                        {%- for feature in cb_features -%}
                          {%- assign feature_trimmed = feature | strip -%}
                          {%- if feature_trimmed != blank -%}
                            <li>
                              <svg class="cat-bundle__check" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M13.5 4.5L6 12L2.5 8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                              {{ feature_trimmed }}
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    {%- if block.settings.gifts_note != blank -%}
                      <p class="cat-bundle__gifts-note">{{ block.settings.gifts_note }}</p>
                    {%- endif -%}

                    {%- assign cb_has_gifts = false -%}
                    {%- assign cb_gift_count = 0 -%}
                    {%- for i in (1..4) -%}
                      {%- assign cb_gift_title_key = 'gift_' | append: i | append: '_title' -%}
                      {%- if block.settings[cb_gift_title_key] != blank -%}
                        {%- assign cb_has_gifts = true -%}
                        {%- assign cb_gift_count = cb_gift_count | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {%- if cb_has_gifts -%}
                      <div class="cat-bundle__gifts">
                        <div class="cat-bundle__gifts-header">
                          <span>{{ block.settings.gifts_heading }}</span>
                          {%- if block.settings.gifts_badge_text != blank -%}
                            <span class="cat-bundle__gifts-badge">{{ block.settings.gifts_badge_text }}</span>
                          {%- endif -%}
                        </div>
                        <div class="cat-bundle__gifts-grid" style="--cb-gift-count: {{ cb_gift_count }};">
                          {%- for i in (1..4) -%}
                            {%- assign cb_gift_title_key = 'gift_' | append: i | append: '_title' -%}
                            {%- assign cb_gift_image_key = 'gift_' | append: i | append: '_image' -%}
                            {%- assign cb_gift_badge_prefix_key = 'gift_' | append: i | append: '_badge_prefix' -%}
                            {%- assign cb_gift_badge_price_key = 'gift_' | append: i | append: '_badge_price' -%}
                            {%- assign cb_gift_strike_key = 'gift_' | append: i | append: '_badge_strikethrough' -%}
                            {%- assign cb_gift_title = block.settings[cb_gift_title_key] -%}
                            {%- if cb_gift_title != blank -%}
                              <div class="cat-bundle__gift">
                                <div class="cat-bundle__gift-image-wrap">
                                  {%- assign cb_gift_image = block.settings[cb_gift_image_key] -%}
                                  {%- if cb_gift_image -%}
                                    <img
                                      src="{{ cb_gift_image | image_url: width: 200 }}"
                                      alt="{{ cb_gift_image.alt | default: cb_gift_title | escape }}"
                                      loading="lazy"
                                      width="60"
                                      height="60"
                                      class="cat-bundle__gift-image"
                                    >
                                  {%- endif -%}
                                  {%- assign cb_gift_badge_prefix = block.settings[cb_gift_badge_prefix_key] -%}
                                  {%- assign cb_gift_badge_price = block.settings[cb_gift_badge_price_key] -%}
                                  {%- if cb_gift_badge_prefix != blank or cb_gift_badge_price != blank -%}
                                    <span class="cat-bundle__gift-corner-badge">
                                      {%- if cb_gift_badge_prefix != blank -%}
                                        <span class="cat-bundle__gift-corner-badge-prefix">{{ cb_gift_badge_prefix }}</span>
                                      {%- endif -%}
                                      {%- if cb_gift_badge_price != blank -%}
                                        <span class="cat-bundle__gift-corner-badge-price{% if block.settings[cb_gift_strike_key] %} cat-bundle__gift-corner-badge-price--strike{% endif %}">{{ cb_gift_badge_price }}</span>
                                      {%- endif -%}
                                    </span>
                                  {%- endif -%}
                                </div>
                                <p class="cat-bundle__gift-title">{{ cb_gift_title }}</p>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                </div>

                <div
                  class="cat-bundle__sub60"
                  data-cb-option="sub60"
                  data-qty="{{ block.settings.plan60_quantity }}"
                  data-selling-plan-id="{{ cb_plan60_selling_plan.id }}"
                  data-subscribe-unit-price="{{ cb_plan60_unit_price }}"
                  role="radio"
                  aria-checked="false"
                  tabindex="0"
                >
                  <div class="cat-bundle__sub60-left">
                    <span class="cat-bundle__radio-dot"></span>
                    <div>
                      <div class="cat-bundle__sub60-title">{{ block.settings.plan60_label }}</div>
                      <div class="cat-bundle__sub60-detail">{{ block.settings.plan60_detail }}</div>
                      <span class="cat-bundle__sub60-save-badge" data-cb-sub60-savings></span>
                    </div>
                  </div>
                  <div class="cat-bundle__sub60-right">
                    <div class="cat-bundle__sub60-price-row">
                      <span class="cat-bundle__sub60-price" data-cb-price="sub60">{{ 0 | money }}</span>
                      <s class="cat-bundle__sub60-compare-price" data-cb-compare="sub60">{{ 0 | money }}</s>
                    </div>
                    <div class="cat-bundle__per-day" data-cb-per-day="sub60"></div>
                    {%- if block.settings.plan60_show_best_value -%}
                      <span class="cat-bundle__sub60-best-badge">{{ block.settings.plan60_best_value_text }}</span>
                    {%- endif -%}
                  </div>
                </div>
                </div>

                <div class="cat-bundle__option cat-bundle__option--onetime{% unless block.settings.show_onetime_row %} cat-bundle__option--hidden{% endunless %}" data-cb-option="onetime" role="radio" aria-checked="false" tabindex="0">
                  <div class="cat-bundle__option-inner">
                    <div class="cat-bundle__option-row">
                      <div class="cat-bundle__option-left">
                        <span class="cat-bundle__radio-dot"></span>
                        <div>
                          <div class="cat-bundle__option-title">{{ block.settings.onetime_label }}</div>
                          <div class="cat-bundle__option-detail" data-cb-onetime-detail>{{ block.settings.onetime_detail_text }}</div>
                        </div>
                      </div>
                      <div class="cat-bundle__option-price">
                        <div class="cat-bundle__price-row">
                          <span class="cat-bundle__price" data-cb-price="onetime">{{ 0 | money }}</span>
                        </div>
                        <div class="cat-bundle__per-day" data-cb-per-day="onetime"></div>
                      </div>
                    </div>

                    {%- if cb_cons.size > 0 -%}
                      <ul class="cat-bundle__con-list">
                        {%- for con in cb_cons -%}
                          {%- assign con_trimmed = con | strip -%}
                          {%- if con_trimmed != blank -%}
                            <li>
                              <svg class="cat-bundle__x" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                              </svg>
                              {{ con_trimmed }}
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                </div>
              </div>

              <script>
                (function () {
                  var root = document.getElementById('CatBundle-{{ block.id }}');
                  if (!root) return;

                  var moneyFormat = {{ shop.money_format | json }};
                  function formatMoney(cents) {
                    var amount = (cents / 100).toFixed(2);
                    return moneyFormat.replace(/\{\{\s*amount\s*\}\}/, amount);
                  }

                  var intervalDays = parseInt(root.dataset.intervalDays, 10) || 30;
                  var basePrice = {{ product.selected_or_first_available_variant.price | json }};
                  var baseCompare = {{ product.selected_or_first_available_variant.compare_at_price | default: 0 | json }};
                  var manualDiscountPercent = {{ block.settings.subscribe_discount_percent | default: 0 | json }};
                  var fallbackSubscribePerUnit = basePrice * (manualDiscountPercent ? (1 - manualDiscountPercent / 100) : 1);

                  var qtyBtns = Array.prototype.slice.call(root.querySelectorAll('.cat-bundle__toggle-btn'));
                  var qtyInput = root.querySelector('[data-cb-quantity-input]');
                  var sellingPlanInput = root.querySelector('[data-cb-selling-plan-input]');

                  var subPlansWrap = root.querySelector('[data-cb-sub-plans]');
                  var subscribeOption = root.querySelector('[data-cb-option="subscribe"]');
                  var sub60Card = root.querySelector('[data-cb-option="sub60"]');
                  var onetimeOption = root.querySelector('[data-cb-option="onetime"]');

                  var subscribePriceEl = root.querySelector('[data-cb-price="subscribe"]');
                  var subscribeCompareEl = root.querySelector('[data-cb-compare="subscribe"]');
                  var subscribePerDayEl = root.querySelector('[data-cb-per-day="subscribe"]');
                  var subscribeDetailEl = root.querySelector('[data-cb-subscribe-detail]');
                  var subscribeDetailTemplate = subscribeDetailEl ? subscribeDetailEl.textContent : '';
                  var sub60PriceEl = root.querySelector('[data-cb-price="sub60"]');
                  var sub60CompareEl = root.querySelector('[data-cb-compare="sub60"]');
                  var sub60PerDayEl = root.querySelector('[data-cb-per-day="sub60"]');
                  var sub60SavingsEl = root.querySelector('[data-cb-sub60-savings]');
                  var sub60SavingsManualText = {{ block.settings.plan60_savings_text | json }};
                  var onetimePriceEl = root.querySelector('[data-cb-price="onetime"]');
                  var onetimePerDayEl = root.querySelector('[data-cb-per-day="onetime"]');
                  var onetimeDetailEl = root.querySelector('[data-cb-onetime-detail]');
                  var onetimeDetailTemplate = onetimeDetailEl ? onetimeDetailEl.textContent : '';

                  var tier1Qty = qtyBtns.length ? (parseInt(qtyBtns[0].dataset.qty, 10) || 1) : 1;
                  var tier1SellingPlanId = qtyBtns.length ? (qtyBtns[0].dataset.sellingPlanId || '') : '';
                  var tier1UnitPrice = qtyBtns.length && qtyBtns[0].dataset.subscribeUnitPrice
                    ? parseInt(qtyBtns[0].dataset.subscribeUnitPrice, 10)
                    : fallbackSubscribePerUnit;

                  var sub60Qty = sub60Card ? (parseInt(sub60Card.dataset.qty, 10) || 2) : 2;
                  var sub60SellingPlanId = sub60Card ? (sub60Card.dataset.sellingPlanId || '') : '';
                  var sub60UnitPrice = sub60Card && sub60Card.dataset.subscribeUnitPrice
                    ? parseInt(sub60Card.dataset.subscribeUnitPrice, 10)
                    : fallbackSubscribePerUnit;

                  var subBoxQty = tier1Qty;
                  var subBoxUnitPrice = tier1UnitPrice;

                  var cbMonthlySubscribeOnly = {{ block.settings.hide_secondary_option | json }};

                  var catCount = 1;
                  var subPlanChoice = '30';
                  var currentQty = tier1Qty;
                  var subscribePerUnit = tier1UnitPrice;
                  var currentSellingPlanId = tier1SellingPlanId;
                  var selectedMode = 'subscribe';

                  function tierBtn(n) {
                    return qtyBtns.filter(function (b) { return b.dataset.cbTier === String(n); })[0];
                  }

                  try {
                    var cbUrlParams = new URLSearchParams(window.location.search);
                    if (cbUrlParams.get('subscribe_only') === '1') {
                      if (onetimeOption) {
                        onetimeOption.style.display = 'none';
                        onetimeOption.setAttribute('aria-hidden', 'true');
                        onetimeOption.setAttribute('tabindex', '-1');
                      }
                      qtyBtns.forEach(function (b) {
                        if (b.dataset.cbTier !== '1') {
                          b.style.display = 'none';
                          b.setAttribute('aria-hidden', 'true');
                          b.setAttribute('tabindex', '-1');
                        }
                      });
                    }
                  } catch (e) {}

                  function updatePrices() {
                    var activeSubTotal = Math.round(subscribePerUnit * currentQty);
                    var onetimeTotal = basePrice * currentQty;
                    var compareTotal = (baseCompare > 0 ? baseCompare : basePrice) * currentQty;
                    var compareEach = baseCompare > 0 ? baseCompare : basePrice;

                    if (subscribePriceEl) subscribePriceEl.innerHTML = formatMoney(subBoxUnitPrice) + ' <span class="cat-bundle__price-suffix">each</span>';
                    if (subscribeCompareEl) {
                      if (compareEach > subBoxUnitPrice) {
                        subscribeCompareEl.textContent = formatMoney(compareEach);
                        subscribeCompareEl.style.display = '';
                      } else {
                        subscribeCompareEl.style.display = 'none';
                      }
                    }
                    if (subscribeDetailEl && subscribeDetailTemplate) {
                      var unitWord = subBoxQty === 1 ? 'Tub' : 'Tubs';
                      subscribeDetailEl.textContent = subscribeDetailTemplate
                        .replace('[qty]', subBoxQty)
                        .replace('[unit]', unitWord);
                    }
                    if (subscribePerDayEl) subscribePerDayEl.textContent = 'Total ' + formatMoney(Math.round(subBoxUnitPrice * subBoxQty));

                    if (sub60PriceEl) sub60PriceEl.innerHTML = formatMoney(sub60UnitPrice) + ' <span class="cat-bundle__price-suffix">each</span>';
                    if (sub60CompareEl) {
                      if (compareEach > sub60UnitPrice) {
                        sub60CompareEl.textContent = formatMoney(compareEach);
                        sub60CompareEl.style.display = '';
                      } else {
                        sub60CompareEl.style.display = 'none';
                      }
                    }
                    if (sub60PerDayEl) sub60PerDayEl.textContent = 'Total ' + formatMoney(Math.round(sub60UnitPrice * sub60Qty));
                    if (sub60SavingsEl) {
                      if (sub60SavingsManualText) {
                        sub60SavingsEl.textContent = sub60SavingsManualText;
                        sub60SavingsEl.style.display = '';
                      } else if (compareEach > sub60UnitPrice) {
                        var sub60Pct = Math.round((1 - (sub60UnitPrice / compareEach)) * 100);
                        sub60SavingsEl.textContent = 'SAVE ' + sub60Pct + '%';
                        sub60SavingsEl.style.display = '';
                      } else {
                        sub60SavingsEl.style.display = 'none';
                      }
                    }

                    if (onetimePriceEl) onetimePriceEl.innerHTML = formatMoney(basePrice) + ' <span class="cat-bundle__price-suffix">each</span>';
                    if (onetimeDetailEl && onetimeDetailTemplate) {
                      var otUnitWord = currentQty === 1 ? 'Tub' : 'Tubs';
                      onetimeDetailEl.textContent = onetimeDetailTemplate
                        .replace('[qty]', currentQty)
                        .replace('[unit]', otUnitWord);
                    }
                    if (onetimePerDayEl) onetimePerDayEl.textContent = 'Total ' + formatMoney(onetimeTotal);

                    if (qtyInput) qtyInput.value = currentQty;
                    if (sellingPlanInput) {
                      if (currentSellingPlanId) sellingPlanInput.value = currentSellingPlanId;
                      sellingPlanInput.disabled = selectedMode !== 'subscribe';
                    }

                    var atcPriceEl = document.getElementById('main-atc-price-{{ section.id }}');
                    if (atcPriceEl) {
                      var atcTotal = selectedMode === 'subscribe' ? activeSubTotal : onetimeTotal;
                      var atcCompare = selectedMode === 'subscribe' ? compareTotal : 0;
                      atcPriceEl.innerHTML = '';
                      atcPriceEl.appendChild(document.createTextNode('| ' + formatMoney(atcTotal) + ' '));
                      if (atcCompare > atcTotal) {
                        var atcCompareEl = document.createElement('s');
                        atcCompareEl.className = 'main-atc-compare-price';
                        atcCompareEl.textContent = formatMoney(atcCompare);
                        atcPriceEl.appendChild(atcCompareEl);
                      }
                    }

                    try {
                      document.dispatchEvent(new CustomEvent('meowCbPricesUpdated', { detail: { catCount: catCount } }));
                    } catch (e) {}
                  }

                  function selectSubPlan(choice) {
                    subPlanChoice = choice;
                    selectedMode = 'subscribe';
                    if (choice === '60') {
                      currentQty = sub60Qty;
                      currentSellingPlanId = sub60SellingPlanId;
                      subscribePerUnit = sub60UnitPrice;
                    } else {
                      currentQty = tier1Qty;
                      currentSellingPlanId = tier1SellingPlanId;
                      subscribePerUnit = tier1UnitPrice;
                    }
                    subBoxQty = tier1Qty;
                    subBoxUnitPrice = tier1UnitPrice;

                    if (subscribeOption) {
                      subscribeOption.classList.toggle('cat-bundle__option--selected', choice === '30');
                      subscribeOption.setAttribute('aria-checked', choice === '30' ? 'true' : 'false');
                    }
                    if (sub60Card) {
                      sub60Card.classList.toggle('cat-bundle__sub60--selected', choice === '60');
                      sub60Card.setAttribute('aria-checked', choice === '60' ? 'true' : 'false');
                    }
                    if (onetimeOption) {
                      onetimeOption.classList.remove('cat-bundle__option--selected');
                      onetimeOption.setAttribute('aria-checked', 'false');
                    }
                    updatePrices();
                  }

                  function selectMode(m) {
                    selectedMode = m;
                    var btn = tierBtn(catCount);
                    var tierQty = btn ? (parseInt(btn.dataset.qty, 10) || catCount) : catCount;
                    var tierPlanId = btn ? (btn.dataset.sellingPlanId || '') : '';
                    var tierUnitPrice = btn && btn.dataset.subscribeUnitPrice
                      ? parseInt(btn.dataset.subscribeUnitPrice, 10)
                      : fallbackSubscribePerUnit;

                    subBoxQty = tierQty;
                    subBoxUnitPrice = tierUnitPrice;
                    currentQty = tierQty;

                    if (m === 'subscribe') {
                      currentSellingPlanId = tierPlanId;
                      subscribePerUnit = tierUnitPrice;
                    } else {
                      currentSellingPlanId = '';
                    }

                    if (subscribeOption) {
                      subscribeOption.classList.toggle('cat-bundle__option--selected', m === 'subscribe');
                      subscribeOption.setAttribute('aria-checked', m === 'subscribe' ? 'true' : 'false');
                    }
                    if (onetimeOption) {
                      onetimeOption.classList.toggle('cat-bundle__option--selected', m === 'onetime');
                      onetimeOption.setAttribute('aria-checked', m === 'onetime' ? 'true' : 'false');
                    }
                    updatePrices();
                  }

                  function selectCatCount(count) {
                    catCount = count;

                    if (cbMonthlySubscribeOnly) {
                      if (sub60Card) {
                        sub60Card.style.display = 'none';
                        sub60Card.classList.remove('cat-bundle__sub60--selected');
                        sub60Card.setAttribute('aria-hidden', 'true');
                        sub60Card.setAttribute('tabindex', '-1');
                      }
                      if (onetimeOption) {
                        onetimeOption.classList.add('cat-bundle__option--hidden');
                        onetimeOption.classList.remove('cat-bundle__option--selected');
                        onetimeOption.setAttribute('aria-hidden', 'true');
                        onetimeOption.setAttribute('tabindex', '-1');
                      }
                      selectMode('subscribe');
                      return;
                    }

                    if (count === 1) {
                      if (sub60Card) sub60Card.style.display = '';
                      if (onetimeOption) {
                        onetimeOption.classList.add('cat-bundle__option--hidden');
                        onetimeOption.classList.remove('cat-bundle__option--selected');
                      }
                      selectSubPlan(subPlanChoice === '60' ? '60' : '30');
                    } else {
                      if (sub60Card) sub60Card.classList.remove('cat-bundle__sub60--selected');
                      if (sub60Card) sub60Card.style.display = 'none';
                      if (onetimeOption) onetimeOption.classList.remove('cat-bundle__option--hidden');
                      selectMode(selectedMode === 'onetime' ? 'onetime' : 'subscribe');
                    }
                  }

                  function selectQty(btn) {
                    qtyBtns.forEach(function (b) {
                      b.classList.remove('cat-bundle__toggle-btn--selected');
                      b.setAttribute('aria-checked', 'false');
                    });
                    btn.classList.add('cat-bundle__toggle-btn--selected');
                    btn.setAttribute('aria-checked', 'true');
                  }

                  qtyBtns.forEach(function (btn) {
                    btn.addEventListener('click', function () {
                      selectQty(btn);
                      var tier = parseInt(btn.dataset.cbTier, 10) || parseInt(btn.dataset.qty, 10) || 1;
                      if (tier === 1) subPlanChoice = '30';
                      selectCatCount(tier);
                    });
                  });

                  if (subscribeOption) {
                    subscribeOption.addEventListener('click', function () {
                      if (catCount === 1) {
                        selectSubPlan('30');
                      } else {
                        selectMode('subscribe');
                      }
                    });
                  }
                  if (sub60Card) {
                    sub60Card.addEventListener('click', function () {
                      selectSubPlan('60');
                    });
                  }
                  if (onetimeOption) {
                    onetimeOption.addEventListener('click', function () {
                      if (catCount !== 1) selectMode('onetime');
                    });
                  }

                  root.cbSelectMode = selectMode;
                  root.cbGetOnetimeText = function () {
                    return formatMoney(basePrice * currentQty);
                  };
                  root.cbGoToOnetimeCheckout = function () {
                    if (root.cbOtpRedirecting) return;
                    root.cbOtpRedirecting = true;

                    fetch(cbCartAddUrl, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                      body: JSON.stringify({
                        items: [{
                          id: cbMainVariantId,
                          quantity: currentQty
                        }]
                      })
                    })
                      .then(function (r) { return r.json(); })
                      .then(function () {
                        window.location.href = '/checkout';
                      })
                      .catch(function (err) {
                        console.error('One-time purchase checkout failed:', err);
                        root.cbOtpRedirecting = false;
                      });
                  };

                  selectCatCount(1);
                  if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', function () { selectCatCount(catCount); });
                  } else {
                    setTimeout(function () { selectCatCount(catCount); }, 0);
                  }

                  {%- assign cb_gift_entries = '' -%}
                  {%- for i in (1..4) -%}
                    {%- assign cb_gift_product_key = 'gift_' | append: i | append: '_product' -%}
                    {%- assign cb_gift_product = block.settings[cb_gift_product_key] -%}
                    {%- if cb_gift_product and cb_gift_product.selected_or_first_available_variant -%}
                      {%- assign cb_gift_recurring_key = 'gift_' | append: i | append: '_recurring' -%}
                      {%- assign cb_gift_sub_product_key = 'gift_' | append: i | append: '_subscription_product' -%}
                      {%- assign cb_gift_sub_product = block.settings[cb_gift_sub_product_key] -%}
                      {%- assign cb_gift_is_recurring = false -%}
                      {%- if block.settings[cb_gift_recurring_key] and cb_gift_sub_product and cb_gift_sub_product.id == product.id -%}
                        {%- assign cb_gift_is_recurring = true -%}
                      {%- endif -%}
                      {%- capture cb_gift_entry -%}{"id":{{ cb_gift_product.selected_or_first_available_variant.id | json }},"quantity":1,"properties":{"_meowgical_gift":"true"},"recurring":{{ cb_gift_is_recurring }}}{%- endcapture -%}
                      {%- assign cb_gift_entries = cb_gift_entries | append: cb_gift_entry | append: '|CBSPLIT|' -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign cb_gift_entries_arr = cb_gift_entries | split: '|CBSPLIT|' -%}

                  var cbMainVariantId = {{ product.selected_or_first_available_variant.id | json }};
                  var cbGiftItems = [{{ cb_gift_entries_arr | join: ',' }}];
                  var cbCartAddUrl = {{ routes.cart_add_url | json }};
                  var cbFormId = {{ product_form_id | json }};

                  function cbBuildGiftItem(giftRaw) {
                    var out = { id: giftRaw.id, quantity: giftRaw.quantity, properties: giftRaw.properties };
                    if (giftRaw.recurring && selectedMode === 'subscribe' && currentSellingPlanId) {
                      out.selling_plan = currentSellingPlanId;
                    }
                    return out;
                  }

                  console.log('CB gifts loaded:', cbGiftItems);

                  document.addEventListener('submit', function (evt) {
                    console.log('CB submit detected', {
                      target: evt.target,
                      targetId: evt.target && evt.target.getAttribute('id'),
                      expectedFormId: cbFormId,
                      selectedMode: selectedMode,
                      giftItems: cbGiftItems,
                      mainVariant: cbMainVariantId,
                      qty: currentQty,
                      sellingPlan: currentSellingPlanId
                    });

                    if (!evt.target || evt.target.getAttribute('id') !== cbFormId) return;
                    if (selectedMode !== 'subscribe') return;
                    if (!cbGiftItems.length) return;

                    evt.preventDefault();
                    evt.stopImmediatePropagation();

                    fetch('/cart.js', { cache: 'no-store' })
                      .then(function (r) { return r.json(); })
                      .then(function (cart) {
                        var cbExistingGiftVariantIds = cart.items
                          .filter(function (i) { return i.properties && i.properties._meowgical_gift === 'true'; })
                          .map(function (i) { return i.variant_id; });

                        var cbMissingGiftItems = cbGiftItems.filter(function (giftItem) {
                          return cbExistingGiftVariantIds.indexOf(giftItem.id) === -1;
                        });

                        var cbSellingPlanByQty = {
                          1: 3010953369,
                          2: 3011870873,
                          3: 3011903641
                        };
                        var cbKnownSuperTaurineProductIds = [8804625940633, 8911928819865];
                        var cbKnownTierPlanIds = [3010953369, 3011870873, 3011903641];

                        var cbExistingMainLine = null;
                        cart.items.some(function (i) {
                          var isRecognizedProduct = cbKnownSuperTaurineProductIds.indexOf(i.product_id) !== -1;
                          var planId = i.selling_plan_allocation ? i.selling_plan_allocation.selling_plan.id : null;
                          var isTierPlan = cbKnownTierPlanIds.indexOf(planId) !== -1;
                          if (isRecognizedProduct && isTierPlan) {
                            cbExistingMainLine = i;
                            return true;
                          }
                          return false;
                        });

                        var cbDrawerEl = document.querySelector('cart-drawer');
                        var cbSectionIds = (cbDrawerEl && typeof cbDrawerEl.getSectionsToRender === 'function')
                          ? cbDrawerEl.getSectionsToRender().map(function (s) { return s.id; })
                          : [];

                        function cbFinishRender(data) {
                          if (cbDrawerEl && typeof cbDrawerEl.renderContents === 'function' && data && data.sections) {
                            cbDrawerEl.classList.remove('is-empty');
                            cbDrawerEl.renderContents(data);
                          }
                        }

                        if (!cbExistingMainLine) {
                          var items = [{
                            id: cbMainVariantId,
                            quantity: currentQty,
                            selling_plan: currentSellingPlanId || undefined
                          }].concat(cbMissingGiftItems.map(cbBuildGiftItem));

                          var cbBody = { items: items };
                          if (cbSectionIds.length) {
                            cbBody.sections = cbSectionIds;
                            cbBody.sections_url = window.location.pathname;
                          }

                          return fetch(cbCartAddUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                            body: JSON.stringify(cbBody)
                          })
                            .then(function (r) { return r.json(); })
                            .then(cbFinishRender);
                        }

                        var cbFinalQty = cbExistingMainLine.quantity + currentQty;
                        if (cbFinalQty > 3) cbFinalQty = 3;
                        var cbNewPlanId = cbSellingPlanByQty[cbFinalQty];
                        var cbHasMissingGifts = cbMissingGiftItems.length > 0;

                        var cbChangeBody = {
                          id: cbExistingMainLine.key,
                          quantity: cbFinalQty,
                          selling_plan: cbNewPlanId
                        };
                        if (!cbHasMissingGifts && cbSectionIds.length) {
                          cbChangeBody.sections = cbSectionIds;
                          cbChangeBody.sections_url = window.location.pathname;
                        }

                        return fetch('/cart/change.js', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                          body: JSON.stringify(cbChangeBody)
                        })
                          .then(function (r) { return r.json(); })
                          .then(function (changeData) {
                            if (!cbHasMissingGifts) {
                              return changeData;
                            }
                            var cbAddBody = { items: cbMissingGiftItems.map(cbBuildGiftItem) };
                            if (cbSectionIds.length) {
                              cbAddBody.sections = cbSectionIds;
                              cbAddBody.sections_url = window.location.pathname;
                            }
                            return fetch(cbCartAddUrl, {
                              method: 'POST',
                              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                              body: JSON.stringify(cbAddBody)
                            }).then(function (r) { return r.json(); });
                          })
                          .then(cbFinishRender);
                      })
                      .catch(function (err) {
                        console.error('Cat Bundle add to cart failed:', err);
                      });
                  }, true);
                })();
              </script>

