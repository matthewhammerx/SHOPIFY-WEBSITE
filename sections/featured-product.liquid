  {% if block.settings.display_price %}
  <script>
  (function() {
    var sectionId = {{ section.id | json }};

    function findPriceEl() {
      return document.getElementById('main-atc-price-' + sectionId);
    }

   function getSelectedBundleCompare() {
  var bar = document.querySelector('.kaching-bundles__bar--selected');
  if (!bar) return null;

  var unitCompareEl = bar.querySelector('.kaching-bundles__bar-full-price');
  var unitSaleEl = bar.querySelector('.kaching-bundles__bar-price');
  var totalEl = bar.querySelector('.kaching-bundles__bar-subtitle');
  if (!unitCompareEl) return null;

  function toNumber(text) {
    var match = text.replace(/,/g, '').match(/[\d.]+/);
    return match ? parseFloat(match[0]) : 0;
  }

  var unitCompareText = unitCompareEl.textContent.trim();
  var unitCompare = toNumber(unitCompareText);
  if (!unitCompare) return unitCompareText;

  var quantity = 1;
  if (unitSaleEl && totalEl) {
    var unitSale = toNumber(unitSaleEl.textContent);
    var total = toNumber(totalEl.textContent);
    if (unitSale > 0 && total > 0) {
      var qty = Math.round(total / unitSale);
      if (qty > 0) quantity = qty;
    }
  }

  if (quantity <= 1) return unitCompareText;

  var scaled = unitCompare * quantity;
  var prefixMatch = unitCompareText.match(/^([^\d]*)/);
  var suffixMatch = unitCompareText.match(/([^\d]*)$/);
  var prefix = prefixMatch ? prefixMatch[1] : '$';
  var suffix = suffixMatch ? suffixMatch[1] : '';
  return prefix + scaled.toFixed(2) + suffix;
}

    function reformat() {
      if (document.querySelector('.cat-bundle')) return;
      var priceEl = findPriceEl();
      if (!priceEl) return;

      var raw = priceEl.textContent.replace(/[•|\s]+$/, '').replace(/^[•|\s]+/, '').trim();
      if (!raw) return;

      var compareText = getSelectedBundleCompare();

      priceEl.innerHTML = '';
      priceEl.appendChild(document.createTextNode('| ' + raw + ' '));
      if (compareText && compareText !== raw) {
        var s = document.createElement('s');
        s.className = 'main-atc-compare-price';
        s.textContent = compareText;
        priceEl.appendChild(s);
      }
    }

    function init() {
      var priceEl = findPriceEl();
      if (!priceEl) return;

      var isReformatting = false;
      var pending = null;

      function scheduleReformat() {
        if (pending) clearTimeout(pending);
        pending = setTimeout(function() {
          pending = null;
          isReformatting = true;
          reformat();
        }, 250);
      }

      reformat();

      var observer = new MutationObserver(function() {
        if (isReformatting) {
          isReformatting = false;
          return;
        }
        scheduleReformat();
      });
      observer.observe(priceEl, { childList: true, subtree: true, characterData: true });

      document.addEventListener('click', function(e) {
        if (e.target.closest('.kaching-bundles__bars')) {
          scheduleReformat();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>
  {% endif %}

 

                
