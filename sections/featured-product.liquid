            {%- when 'otp_link' -%}
              <div
                class="cat-bundle-otp__wrap"
                id="CatBundleOtpLink-{{ block.id }}"
                style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;--font-size: {{ block.settings.font_size | default: 13 | divided_by: 10.0 }}rem;"
                {{ block.shopify_attributes }}
              >
                <a href="#" class="cat-bundle-otp__link" data-cb-otp-link>{{ block.settings.link_text | default: 'One Time Purchase [price]' }}</a>
              </div>
              <style>
                #CatBundleOtpLink-{{ block.id }} {
                  width: 100%;
                  display: flex;
                  justify-content: center;
                  margin-top: var(--margin-top);
                  margin-bottom: var(--margin-bottom);
                }
                #CatBundleOtpLink-{{ block.id }} .cat-bundle-otp__link {
                  display: inline-block;
                  font-size: var(--font-size);
                  line-height: 1.4;
                  text-align: center;
                  text-decoration: underline;
                  color: inherit;
                  cursor: pointer;
                }
              </style>
              <script>
                (function () {
                  var wrap = document.getElementById('CatBundleOtpLink-{{ block.id }}');
                  if (!wrap) return;

                  try {
                    var otpUrlParams = new URLSearchParams(window.location.search);
                    if (otpUrlParams.get('subscribe_only') === '1') {
                      wrap.style.display = 'none';
                      return;
                    }
                  } catch (e) {}

                  var linkEl = wrap.querySelector('[data-cb-otp-link]');
                  if (!linkEl) return;
                  var template = linkEl.textContent;

                  function findBundleRoot() {
                    return document.querySelector('[id^="CatBundle-"]');
                  }

                  function updateText() {
                    var root = findBundleRoot();
                    if (!root || typeof root.cbGetOnetimeText !== 'function') return;
                    linkEl.textContent = template.replace('[price]', root.cbGetOnetimeText());
                  }

                  linkEl.addEventListener('click', function (evt) {
                    evt.preventDefault();
                    var root = findBundleRoot();
                    if (root && typeof root.cbGoToOnetimeCheckout === 'function') {
                      linkEl.style.opacity = '0.6';
                      linkEl.style.pointerEvents = 'none';
                      root.cbGoToOnetimeCheckout();
                    }
                  });

                  document.addEventListener('meowCbPricesUpdated', function () {
                    updateText();
                  });

                  if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', updateText);
                  } else {
                    setTimeout(updateText, 0);
                  }
                })();
              </script>
