{% comment %}
  Herbans Ingredient Spotlight - Compact Editable Version
{% endcomment %}

<section id="herbans-ingredients-{{ section.id }}" class="herbans-ingredients">
  <div class="hi-wrap">

    <div class="hi-header">
      {% if section.settings.top_text != blank %}
        <div class="hi-top-text">{{ section.settings.top_text }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="hi-heading">{{ section.settings.heading }}</div>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hi-text">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="hi-grid">
      {% for block in section.blocks %}
        <div
          class="hi-card"
          style="--ingredient-title-color: {{ block.settings.title_color }};"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.sticker_image != blank %}
            <div class="hi-sticker hi-sticker-{{ block.settings.sticker_position }}">
              <img
                src="{{ block.settings.sticker_image | image_url: width: 500 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            </div>
          {% endif %}

          <div class="hi-content">
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="hi-description">{{ block.settings.description }}</div>
            {% endif %}

            <ul class="hi-benefits">
              {% if block.settings.benefit_1 != blank %}
                <li>{{ block.settings.benefit_1 }}</li>
              {% endif %}
              {% if block.settings.benefit_2 != blank %}
                <li>{{ block.settings.benefit_2 }}</li>
              {% endif %}
              {% if block.settings.benefit_3 != blank %}
                <li>{{ block.settings.benefit_3 }}</li>
              {% endif %}
            </ul>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="hi-button-wrap">
        <a href="{{ section.settings.button_link }}" class="hi-button">
          {{ section.settings.button_text }}
        </a>

        {% if section.settings.guarantee_text != blank %}
          <div class="hi-guarantee">
            {% if section.settings.guarantee_icon != blank %}
              <img
                src="{{ section.settings.guarantee_icon | image_url: width: 80 }}"
                alt="Guarantee"
                class="hi-guarantee-icon"
                loading="lazy"
              >
            {% endif %}

            <span class="hi-guarantee-text">
              {{ section.settings.guarantee_text }}
            </span>
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  #herbans-ingredients-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_side_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    overflow: hidden;
  }

  #herbans-ingredients-{{ section.id }} * {
    box-sizing: border-box;
  }

  #herbans-ingredients-{{ section.id }} .hi-wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #herbans-ingredients-{{ section.id }} .hi-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto {{ section.settings.header_gap_mobile }}px;
  }

  #herbans-ingredients-{{ section.id }} .hi-top-text {
    color: {{ section.settings.top_text_color }};
    font-size: {{ section.settings.top_text_size_mobile }}px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  #herbans-ingredients-{{ section.id }} .hi-heading,
  #herbans-ingredients-{{ section.id }} .hi-heading p {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: -0.045em;
  }

  #herbans-ingredients-{{ section.id }} .hi-heading strong {
    color: {{ section.settings.heading_accent }};
    font-weight: inherit;
  }

  #herbans-ingredients-{{ section.id }} .hi-text {
    margin-top: 16px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_mobile }}px;
    line-height: 1.5;
    font-weight: 500;
  }

  #herbans-ingredients-{{ section.id }} .hi-text p,
  #herbans-ingredients-{{ section.id }} .hi-description p {
    margin: 0;
  }

  #herbans-ingredients-{{ section.id }} .hi-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.card_gap_mobile }}px;
  }

  #herbans-ingredients-{{ section.id }} .hi-card {
    position: relative;
    background: {{ section.settings.card_bg }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    box-shadow: {{ section.settings.card_shadow }};
    padding: {{ section.settings.card_padding_mobile }}px;
    min-height: 0;
    overflow: visible;
  }

  #herbans-ingredients-{{ section.id }} .hi-content {
    max-width: 620px;
  }

  #herbans-ingredients-{{ section.id }} .hi-sticker {
    position: absolute;
    width: {{ section.settings.sticker_size_mobile }}px;
    height: {{ section.settings.sticker_size_mobile }}px;
    top: {{ section.settings.sticker_top_mobile }}px;
    z-index: 2;
    pointer-events: none;
  }

  #herbans-ingredients-{{ section.id }} .hi-sticker-top-left {
    left: {{ section.settings.sticker_side_mobile }}px;
  }

  #herbans-ingredients-{{ section.id }} .hi-sticker-top-right {
    right: {{ section.settings.sticker_side_mobile }}px;
  }

  #herbans-ingredients-{{ section.id }} .hi-sticker img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 8px 10px rgba(0,0,0,0.12));
  }

  #herbans-ingredients-{{ section.id }} h3 {
    margin: 0 0 12px;
    color: var(--ingredient-title-color);
    font-size: {{ section.settings.card_title_size_mobile }}px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.04em;
    padding-right: 85px;
  }

  #herbans-ingredients-{{ section.id }} .hi-description {
    color: {{ section.settings.card_text_color }};
    font-size: {{ section.settings.card_text_size_mobile }}px;
    line-height: 1.42;
    font-weight: 500;
    margin-bottom: 18px;
    padding-right: 10px;
  }

  #herbans-ingredients-{{ section.id }} .hi-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #herbans-ingredients-{{ section.id }} .hi-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: {{ section.settings.benefit_color }};
    font-size: {{ section.settings.benefit_size_mobile }}px;
    line-height: 1.2;
    font-weight: 900;
    margin: 9px 0;
  }

  #herbans-ingredients-{{ section.id }} .hi-benefits li:before {
    content: "✓";
    color: {{ section.settings.check_color }};
    font-weight: 900;
    flex: 0 0 auto;
  }

  #herbans-ingredients-{{ section.id }} .hi-button-wrap {
    text-align: center;
    margin-top: {{ section.settings.button_gap_mobile }}px;
  }

  #herbans-ingredients-{{ section.id }} .hi-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    {% if section.settings.button_use_gradient %}
      background: linear-gradient(
        135deg,
        {{ section.settings.button_gradient_1 }},
        {{ section.settings.button_gradient_2 }}
      );
      border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_gradient_1 }};
    {% else %}
      background: {{ section.settings.button_bg }};
      border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_bg }};
    {% endif %}

    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: 999px;
    padding: 15px 40px;
    min-width: {{ section.settings.button_width_mobile }}px;
    font-size: {{ section.settings.button_size_mobile }}px;
    font-weight: 900;
    box-shadow: {{ section.settings.button_shadow }};
    transition: all .25s ease;
  }

  #herbans-ingredients-{{ section.id }} .hi-button:hover {
    background: transparent;

    {% if section.settings.button_use_gradient %}
      color: {{ section.settings.button_gradient_1 }};
      border-color: {{ section.settings.button_gradient_1 }};
    {% else %}
      color: {{ section.settings.button_bg }};
      border-color: {{ section.settings.button_bg }};
    {% endif %}

    transform: translateY(-1px);
  }

  #herbans-ingredients-{{ section.id }} .hi-guarantee {
    margin-top: {{ section.settings.guarantee_gap_mobile }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  #herbans-ingredients-{{ section.id }} .hi-guarantee-icon {
    width: {{ section.settings.guarantee_icon_size_mobile }}px;
    height: {{ section.settings.guarantee_icon_size_mobile }}px;
    object-fit: contain;
    display: block;
  }

  #herbans-ingredients-{{ section.id }} .hi-guarantee-text {
    color: {{ section.settings.guarantee_text_color }};
    font-size: {{ section.settings.guarantee_font_size_mobile }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.guarantee_font_weight }};
    letter-spacing: {{ section.settings.guarantee_letter_spacing | divided_by: 100.0 }}em;
  }

  @media screen and (min-width: 768px) {
    #herbans-ingredients-{{ section.id }} {
      padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_side_desktop }}px {{ section.settings.padding_bottom_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-header {
      margin-bottom: {{ section.settings.header_gap_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-top-text {
      font-size: {{ section.settings.top_text_size_desktop }}px;
      margin-bottom: 18px;
    }

    #herbans-ingredients-{{ section.id }} .hi-heading,
    #herbans-ingredients-{{ section.id }} .hi-heading p {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-text {
      font-size: {{ section.settings.text_size_desktop }}px;
      margin-top: 22px;
    }

    #herbans-ingredients-{{ section.id }} .hi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: {{ section.settings.card_gap_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-card {
      padding: {{ section.settings.card_padding_desktop }}px;
      min-height: 0;
    }

    #herbans-ingredients-{{ section.id }} .hi-sticker {
      width: {{ section.settings.sticker_size_desktop }}px;
      height: {{ section.settings.sticker_size_desktop }}px;
      top: {{ section.settings.sticker_top_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-sticker-top-left {
      left: {{ section.settings.sticker_side_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-sticker-top-right {
      right: {{ section.settings.sticker_side_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} h3 {
      font-size: {{ section.settings.card_title_size_desktop }}px;
      padding-right: 120px;
      margin-bottom: 14px;
    }

    #herbans-ingredients-{{ section.id }} .hi-description {
      font-size: {{ section.settings.card_text_size_desktop }}px;
      margin-bottom: 22px;
    }

    #herbans-ingredients-{{ section.id }} .hi-benefits li {
      font-size: {{ section.settings.benefit_size_desktop }}px;
      margin: 10px 0;
    }

    #herbans-ingredients-{{ section.id }} .hi-button-wrap {
      margin-top: {{ section.settings.button_gap_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-button {
      min-width: {{ section.settings.button_width_desktop }}px;
      font-size: {{ section.settings.button_size_desktop }}px;
      padding: 17px 48px;
    }

    #herbans-ingredients-{{ section.id }} .hi-guarantee {
      margin-top: {{ section.settings.guarantee_gap_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-guarantee-icon {
      width: {{ section.settings.guarantee_icon_size_desktop }}px;
      height: {{ section.settings.guarantee_icon_size_desktop }}px;
    }

    #herbans-ingredients-{{ section.id }} .hi-guarantee-text {
      font-size: {{ section.settings.guarantee_font_size_desktop }}px;
    }
  }
</style>

{% schema %}
