{% comment %}
  Meow rating banner - a full-width color strip with star icons and a rating line.
  Usage: add as a section via Theme Editor (Add section > Meow Rating Badge).
{% endcomment %}

<section
  class="meow-rating-badge"
  style="
    --meow-rb-bg: {{ section.settings.banner_bg_color | default: '#2E6E3E' }};
    --meow-rb-text-color: {{ section.settings.text_color | default: '#FFFFFF' }};
    --meow-rb-star-color: {{ section.settings.star_color | default: '#FFFFFF' }};
    --meow-rb-radius: {{ section.settings.banner_radius | default: 0 }}px;
    --meow-rb-padding-y: {{ section.settings.padding_y | default: 16 }}px;
    --meow-rb-padding-x: {{ section.settings.padding_x | default: 20 }}px;
    --meow-rb-content-max-width: {{ section.settings.content_max_width | default: 1200 }}px;
    --meow-rb-font-size: {{ section.settings.font_size | default: 16 }}px;
    --meow-rb-star-size: {{ section.settings.star_size | default: 18 }}px;
    --meow-rb-gap: {{ section.settings.gap | default: 10 }}px;
    --meow-rb-margin-top: {{ section.settings.margin_top | default: 0 }}px;
    --meow-rb-margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px;
  "
>
  <div class="meow-rating-badge__inner">
    {%- if section.settings.show_stars -%}
      <span class="meow-rating-badge__stars" aria-hidden="true">
        {%- for i in (1..5) -%}
          <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.2 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.2 5.9-.9L12 3.5z"/></svg>
        {%- endfor -%}
      </span>
    {%- endif -%}
    {%- if section.settings.rating_text != blank -%}
      <span class="meow-rating-badge__rating">{{ section.settings.rating_text }}</span>
    {%- endif -%}
    {%- if section.settings.label_text != blank -%}
      <span class="meow-rating-badge__label">{{ section.settings.label_text }}</span>
    {%- endif -%}
  </div>
</section>

<style>
  .meow-rating-badge {
    width: 100%;
    box-sizing: border-box;
    background: var(--meow-rb-bg, #2E6E3E);
    border-radius: var(--meow-rb-radius, 0px);
    margin-top: var(--meow-rb-margin-top, 0px);
    margin-bottom: var(--meow-rb-margin-bottom, 0px);
  }
  .meow-rating-badge__inner {
    max-width: var(--meow-rb-content-max-width, 1200px);
    margin: 0 auto;
    padding: var(--meow-rb-padding-y, 16px) var(--meow-rb-padding-x, 20px);
    box-sizing: border-box;
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--meow-rb-gap, 10px);
    overflow-x: auto;
  }
  .meow-rating-badge__stars {
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: 2px;
    color: var(--meow-rb-star-color, #FFFFFF);
    flex-shrink: 0;
  }
  .meow-rating-badge__stars svg {
    width: var(--meow-rb-star-size, 18px);
    height: var(--meow-rb-star-size, 18px);
    flex-shrink: 0;
  }
  .meow-rating-badge__rating,
  .meow-rating-badge__label {
    font-size: var(--meow-rb-font-size, 16px);
    color: var(--meow-rb-text-color, #FFFFFF);
    line-height: 1.2;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .meow-rating-badge__rating {
    font-weight: 800;
  }
  .meow-rating-badge__label {
    font-weight: 500;
  }
  @media screen and (max-width: 480px) {
    .meow-rating-badge__inner {
      gap: calc(var(--meow-rb-gap, 10px) * 0.6);
      padding-left: calc(var(--meow-rb-padding-x, 20px) * 0.7);
      padding-right: calc(var(--meow-rb-padding-x, 20px) * 0.7);
    }
    .meow-rating-badge__stars svg {
      width: calc(var(--meow-rb-star-size, 18px) * 0.75);
      height: calc(var(--meow-rb-star-size, 18px) * 0.75);
    }
    .meow-rating-badge__rating,
    .meow-rating-badge__label {
      font-size: calc(var(--meow-rb-font-size, 16px) * 0.8);
    }
  }
</style>

{% schema %}
{
  "name": "Meow Rating Badge",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-width rating banner strip with its own unique classes/CSS - safe to add anywhere. The color fills the entire section edge to edge."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star icons",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text (bold)",
      "default": "4.8/5"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "from Verified Reviews"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Banner background",
      "default": "#2E6E3E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "info": "Keeps the text from spreading too far apart on very wide screens. The banner color always fills the full section width regardless.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "banner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Banner corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 6,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Banner vertical padding",
      "info": "Controls the banner's thickness.",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_x",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Content side padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Star icon size",
      "default": 18
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Gap between stars and text",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space above banner",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space below banner",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Meow Rating Badge"
    }
  ]
}
{% endschema %}