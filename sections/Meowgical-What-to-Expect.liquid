      "min": 13,
      "max": 24,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Intro text size desktop",
      "min": 15,
      "max": 28,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "top_text_size_mobile",
