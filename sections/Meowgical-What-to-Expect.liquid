{% comment %}
  Meowgical - What to Expect
  Wuffes-inspired information structure with a softer Meowgical card design.
{% endcomment %}

<section id="meowgical-expect-{{ section.id }}" class="meowgical-expect">
  <div class="mwe-wrap">

    <div class="mwe-header">
      {% if section.settings.top_text != blank %}
        <div class="mwe-top-text">{{ section.settings.top_text }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="mwe-heading">{{ section.settings.heading }}</div>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="mwe-intro">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="mwe-panel">
      <div class="mwe-grid">
        {% for block in section.blocks %}
          <article
            class="mwe-card"
            style="
              --mwe-card-bg: {{ block.settings.card_bg }};
              --mwe-title-color: {{ block.settings.title_color }};
            "
            {{ block.shopify_attributes }}
          >
            <div class="mwe-card-head">
              <div class="mwe-icon-wrap">
                {% if block.settings.icon != blank %}
                  <img
                    src="{{ block.settings.icon | image_url: width: 180 }}"
                    alt=""
                    class="mwe-icon"
                    loading="lazy"
                    width="90"
                    height="90"
                  >
                {% else %}
                  <span class="mwe-icon-fallback">{{ forloop.index }}</span>
                {% endif %}
              </div>

              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
            </div>

            {% if block.settings.description != blank %}
              <div class="mwe-description">{{ block.settings.description }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if section.settings.expectation_note != blank %}
        <div class="mwe-note">
          {% if section.settings.note_icon != blank %}
            <img
              src="{{ section.settings.note_icon | image_url: width: 60 }}"
              alt=""
              class="mwe-note-icon"
              loading="lazy"
              width="24"
              height="24"
            >
          {% endif %}
          <div class="mwe-note-text">{{ section.settings.expectation_note }}</div>
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
  #meowgical-expect-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding:
      {{ section.settings.padding_top_mobile }}px
      {{ section.settings.padding_side_mobile }}px
      {{ section.settings.padding_bottom_mobile }}px;
    overflow: hidden;
  }

  #meowgical-expect-{{ section.id }} * {
    box-sizing: border-box;
  }

  #meowgical-expect-{{ section.id }} .mwe-wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #meowgical-expect-{{ section.id }} .mwe-header {
    width: 100%;
    max-width: 760px;
    margin: 0 auto {{ section.settings.header_gap_mobile }}px;
    padding: 0 6px;
    text-align: center;
  }

  #meowgical-expect-{{ section.id }} .mwe-top-text {
    margin-bottom: 12px;
    color: {{ section.settings.top_text_color }};
    font-size: {{ section.settings.top_text_size_mobile }}px;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #meowgical-expect-{{ section.id }} .mwe-heading,
  #meowgical-expect-{{ section.id }} .mwe-heading p {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.045em;
  }

  #meowgical-expect-{{ section.id }} .mwe-heading strong {
    color: {{ section.settings.heading_accent }};
    font-weight: inherit;
  }

  #meowgical-expect-{{ section.id }} .mwe-intro {
    width: min(100%, 320px);
    margin: 16px auto 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_mobile }}px;
    line-height: 1.5;
    font-weight: 500;
    text-wrap: pretty;
  }

  #meowgical-expect-{{ section.id }} .mwe-intro p,
  #meowgical-expect-{{ section.id }} .mwe-description p,
  #meowgical-expect-{{ section.id }} .mwe-note-text p {
    margin: 0;
  }

  #meowgical-expect-{{ section.id }} .mwe-panel {
    background: {{ section.settings.panel_bg }};
    border: {{ section.settings.panel_border_width }}px solid {{ section.settings.panel_border_color }};
    border-radius: {{ section.settings.panel_radius }}px;
    padding: {{ section.settings.panel_padding_mobile }}px;
    box-shadow: {{ section.settings.panel_shadow }};
  }

  #meowgical-expect-{{ section.id }} .mwe-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.card_gap_mobile }}px;
  }

  #meowgical-expect-{{ section.id }} .mwe-card {
    min-width: 0;
    padding: {{ section.settings.card_padding_mobile }}px;
    background: var(--mwe-card-bg);
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    box-shadow: {{ section.settings.card_shadow }};
  }

  #meowgical-expect-{{ section.id }} .mwe-card-head {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
  }

  #meowgical-expect-{{ section.id }} .mwe-icon-wrap {
    flex: 0 0 auto;
    width: {{ section.settings.icon_box_mobile }}px;
    height: {{ section.settings.icon_box_mobile }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.icon_bg }};
    border: {{ section.settings.icon_border_width }}px solid {{ section.settings.icon_border_color }};
    border-radius: {{ section.settings.icon_radius }}px;
  }

  #meowgical-expect-{{ section.id }} .mwe-icon {
    display: block;
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
    object-fit: contain;
  }

  #meowgical-expect-{{ section.id }} .mwe-icon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
    border-radius: 999px;
    background: {{ section.settings.fallback_icon_bg }};
    color: {{ section.settings.fallback_icon_color }};
    font-size: {{ section.settings.fallback_icon_size_mobile }}px;
    line-height: 1;
    font-weight: 900;
  }

  #meowgical-expect-{{ section.id }} h3 {
    min-width: 0;
    margin: 0;
    color: var(--mwe-title-color);
    font-size: {{ section.settings.card_title_size_mobile }}px;
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  #meowgical-expect-{{ section.id }} .mwe-description {
    margin-top: 14px;
    color: {{ section.settings.card_text_color }};
    font-size: {{ section.settings.card_text_size_mobile }}px;
    line-height: 1.42;
    font-weight: 500;
    text-wrap: pretty;
  }

  #meowgical-expect-{{ section.id }} .mwe-note {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 9px;
    width: calc(100% - 28px);
    max-width: 310px;
    margin: {{ section.settings.note_gap_mobile }}px auto 0;
    padding: {{ section.settings.note_padding_top_mobile }}px 8px 0;
    border-top: 1px solid {{ section.settings.note_border_color }};
    text-align: center;
  }

  #meowgical-expect-{{ section.id }} .mwe-note-icon {
    flex: 0 0 auto;
    width: {{ section.settings.note_icon_size_mobile }}px;
    height: {{ section.settings.note_icon_size_mobile }}px;
    object-fit: contain;
    margin-top: 1px;
  }

  #meowgical-expect-{{ section.id }} .mwe-note-text {
    color: {{ section.settings.note_text_color }};
    font-size: {{ section.settings.note_text_size_mobile }}px;
    line-height: 1.45;
    font-weight: 500;
  }

  @media screen and (min-width: 768px) {
    #meowgical-expect-{{ section.id }} {
      padding:
        {{ section.settings.padding_top_desktop }}px
        {{ section.settings.padding_side_desktop }}px
        {{ section.settings.padding_bottom_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-header {
      margin-bottom: {{ section.settings.header_gap_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-top-text {
      margin-bottom: 14px;
      font-size: {{ section.settings.top_text_size_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-heading,
    #meowgical-expect-{{ section.id }} .mwe-heading p {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-intro {
      width: min(100%, 680px);
      margin-top: 20px;
      font-size: {{ section.settings.text_size_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-panel {
      padding: {{ section.settings.panel_padding_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: {{ section.settings.card_gap_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-card {
      padding: {{ section.settings.card_padding_desktop }}px;
      min-height: {{ section.settings.card_min_height_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-card-head {
      gap: 16px;
    }

    #meowgical-expect-{{ section.id }} .mwe-icon-wrap {
      width: {{ section.settings.icon_box_desktop }}px;
      height: {{ section.settings.icon_box_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-icon {
      width: {{ section.settings.icon_size_desktop }}px;
      height: {{ section.settings.icon_size_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-icon-fallback {
      width: {{ section.settings.icon_size_desktop }}px;
      height: {{ section.settings.icon_size_desktop }}px;
      font-size: {{ section.settings.fallback_icon_size_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} h3 {
      font-size: {{ section.settings.card_title_size_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-description {
      margin-top: 18px;
      font-size: {{ section.settings.card_text_size_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-note {
      width: calc(100% - 80px);
      max-width: 760px;
      margin-top: {{ section.settings.note_gap_desktop }}px;
      padding: {{ section.settings.note_padding_top_desktop }}px 18px 0;
    }

    #meowgical-expect-{{ section.id }} .mwe-note-icon {
      width: {{ section.settings.note_icon_size_desktop }}px;
      height: {{ section.settings.note_icon_size_desktop }}px;
    }

    #meowgical-expect-{{ section.id }} .mwe-note-text {
      font-size: {{ section.settings.note_text_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Meowgical What to Expect",
  "settings": [
    {
      "type": "text",
      "id": "top_text",
      "label": "Top text",
      "default": "WHAT TO EXPECT"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>What to Expect With <strong>SuperTaurine</strong></p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>A simple daily routine designed to make taurine support clear, consistent, and easy to maintain.</p>"
    },
    {
      "type": "richtext",
      "id": "expectation_note",
      "label": "Expectation note",
      "default": "<p>SuperTaurine is daily nutritional support, not a stimulant or medication. Some cats may not show an immediate visible change.</p>"
    },
    {
      "type": "image_picker",
      "id": "note_icon",
      "label": "Bottom note icon"
    },

    {
      "type": "header",
      "content": "Main sizing"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 900,
      "max": 1500,
      "step": 20,
      "default": 1180
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
