<section class="lw lwh lwh-dark lw-section" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px; --lwh-bg: {{ section.settings.bg }};">
  <div class="lwh-wrap">
    <div class="lwh-split-head">
      <h2 class="lwh-h lwh-h--lg">{{ section.settings.heading }}</h2>
      <div class="lwh-split-head__side">
        {%- if section.settings.text != blank -%}<p class="lwh-lead">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.link_label != blank -%}<a class="lwh-link lwh-link--light" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }} →</a>{%- endif -%}
      </div>
    </div>
    <div class="lwh-intro__grid">
      {%- liquid
        assign p = section.settings.product
      -%}
      <a class="lwh-pcard" href="{% if p != blank %}{{ p.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
        {%- if section.settings.badge != blank -%}<span class="lwh-badge">{{ section.settings.badge }}</span>{%- endif -%}
        {%- if section.settings.tag != blank -%}<span class="lwh-tag">{{ section.settings.tag }}</span>{%- endif -%}
        <span class="lwh-pcard__title">{% if section.settings.card_title != blank %}{{ section.settings.card_title }}{% elsif p != blank %}{{ p.title }}{% else %}Milk Thistle Support{% endif %}</span>
        <span class="lwh-pcard__img">
          {%- if section.settings.card_image != blank -%}{{ section.settings.card_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}
          {%- elsif p != blank and p.featured_image -%}{{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: p.title }}
          {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'lw-placeholder' }}{%- endif -%}
        </span>
        <span class="lwh-btn lwh-btn--small">{{ section.settings.card_button }}</span>
        {%- if p != blank -%}<span class="lwh-pcard__price">From {{ p.price_min | money }}</span>{%- endif -%}
      </a>
      <div class="lwh-intro__features">
        {%- for block in section.blocks -%}
          <div class="lwh-feature" {{ block.shopify_attributes }}>
            <span class="lwh-feature__icon">{% render 'lw-icon', icon: block.settings.icon %}</span>
            <div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

