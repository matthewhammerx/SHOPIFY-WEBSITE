{%- liquid
  assign img = section.settings.image
  if img == blank and product
    assign img = product.featured_image
  endif
-%}
<section class="lw lw-section lw-bprod" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px; --lw-fg: {{ section.settings.fg }}; --lw-bg-grad: linear-gradient(180deg, {{ section.settings.bg }} 0%, {{ section.settings.bg_2 }} 100%);">
  <div class="lw-wrap">
    <div class="lw-head lw-center">
      <h2 class="lw-h lw-h--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lw-sub" style="color: inherit; opacity: .85;">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="lw-bprod__grid">
      <div class="lw-bprod__icons">
        {%- for block in section.blocks -%}
          <div class="lw-bprod__icon lw-reveal" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'lw-icon', icon: block.settings.icon %}{%- endif -%}
            <span>{{ block.settings.text | replace: '†', '<sup>†</sup>' }}</span>
          </div>
        {%- endfor -%}
      </div>
      <div class="lw-bprod__visual">
        {%- assign lw_alt = section.settings.heading | strip_html -%}
        <div class="lw-bprod__rings" aria-hidden="true"><span></span><span></span><span></span></div>
        {%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', alt: lw_alt }}{%- else -%}{{ 'product-2' | placeholder_svg_tag: 'lw-placeholder' }}{%- endif -%}
      </div>
    </div>
  </div>
</section>

