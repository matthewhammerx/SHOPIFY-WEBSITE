{% comment %}
  Meowgical FAQ (v2) — Wuffes-style layout.
  Centered heading/subheading, then image + short intro paragraph + a short
  accordion (no category tabs), CTA button below. Mobile stacks as:
  heading -> image -> button -> paragraph -> accordion.
{% endcomment %}

<section id="mg-faq2-{{ section.id }}" class="mg-faq2">
  <div class="mg-faq2__inner">

    <header class="mg-faq2__header">
      {% if section.settings.heading != blank %}
        <h2 class="mg-faq2__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="mg-faq2__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}
    </header>

    <div class="mg-faq2__layout">

      {% if section.settings.image != blank %}
        <div class="mg-faq2__media">
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
            class="mg-faq2__media-image"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        </div>
      {% endif %}

      <div class="mg-faq2__content">
        {% if section.settings.intro_text != blank %}
          <div class="mg-faq2__intro rte">{{ section.settings.intro_text }}</div>
        {% endif %}

        <div class="mg-faq2__accordion">
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <details class="mg-faq2__item" {{ block.shopify_attributes }}>
                <summary class="mg-faq2__question">
                  <span>{{ block.settings.question }}</span>
                  <span class="mg-faq2__chevron" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none">
                      <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </summary>

                <div class="mg-faq2__answer rte">
                  {{ block.settings.answer }}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if section.settings.button_text != blank %}
        <div class="mg-faq2__cta">
          <a
            href="{{ section.settings.button_link | default: '#MainProduct' }}"
            class="mg-faq2__cta-button"
          >
            {{ section.settings.button_text }}
          </a>
        </div>
      {% endif %}

    </div>

  </div>

  {% if section.settings.enable_faq_schema %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {% assign first_faq = true %}
          {% for block in section.blocks %}
            {% if block.type == 'faq' and block.settings.question != blank and block.settings.answer != blank %}
              {% unless first_faq %},{% endunless %}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
                }
              }
              {% assign first_faq = false %}
            {% endif %}
          {% endfor %}
        ]
      }
    </script>
  {% endif %}
</section>

<style>
  #mg-faq2-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding:
      {{ section.settings.padding_top_mobile }}px
      16px
      {{ section.settings.padding_bottom_mobile }}px;
  }

  #mg-faq2-{{ section.id }} * {
    box-sizing: border-box;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__header {
    max-width: 720px;
    margin: 0 auto {{ section.settings.header_gap_mobile }}px;
    text-align: center;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -.02em;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__subheading {
    margin-top: 10px;
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size_mobile }}px;
    line-height: 1.5;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__subheading p {
    margin: 0;
  }

  /* Mobile order: image -> button -> paragraph/accordion */
  #mg-faq2-{{ section.id }} .mg-faq2__layout {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.block_gap_mobile }}px;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__media {
    order: 1;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__cta {
    order: 2;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__content {
    order: 3;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__media-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    object-fit: cover;
    border-radius: {{ section.settings.image_radius }}px;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__intro {
    margin: 0 0 {{ section.settings.intro_gap_mobile }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.intro_size_mobile }}px;
    line-height: 1.5;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__intro p {
    margin: 0;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__item {
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  #mg-faq2-{{ section.id }} .mg-faq2__accordion .mg-faq2__item:first-child {
    border-top: 1px solid {{ section.settings.border_color }};
  }

  #mg-faq2-{{ section.id }} .mg-faq2__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: {{ section.settings.question_padding_mobile }}px 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.question_size_mobile }}px;
    line-height: 1.3;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__question::-webkit-details-marker {
    display: none;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__chevron {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    color: {{ section.settings.accent_color }};
    transition: transform .2s ease;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__chevron svg {
    width: 100%;
    height: 100%;
  }

  #mg-faq2-{{ section.id }} details[open] .mg-faq2__chevron {
    transform: rotate(180deg);
  }

  #mg-faq2-{{ section.id }} .mg-faq2__answer {
    padding: 0 0 {{ section.settings.answer_padding_bottom_mobile }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.answer_size_mobile }}px;
    line-height: 1.6;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__answer p {
    margin: 0 0 12px;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__answer p:last-child {
    margin-bottom: 0;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, {{ section.settings.button_width_mobile }}px);
    min-height: {{ section.settings.button_height_mobile }}px;
    padding: 14px 28px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_radius }}px;
    {% if section.settings.button_use_gradient %}
      background: linear-gradient(
        {{ section.settings.button_gradient_angle }}deg,
        {{ section.settings.button_gradient_1 }},
        {{ section.settings.button_gradient_2 }}
      );
    {% else %}
      background: {{ section.settings.button_bg }};
    {% endif %}
    box-shadow: {{ section.settings.button_shadow }};
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_text_size_mobile }}px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: .01em;
    text-decoration: none;
    text-align: center;
    transition: transform .2s ease;
  }

  #mg-faq2-{{ section.id }} .mg-faq2__cta-button:hover {
    transform: translateY(-1px);
  }

  @media screen and (min-width: 750px) {
    #mg-faq2-{{ section.id }} {
      padding:
        {{ section.settings.padding_top_desktop }}px
        40px
        {{ section.settings.padding_bottom_desktop }}px;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__header {
      margin-bottom: {{ section.settings.header_gap_desktop }}px;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__subheading {
      font-size: {{ section.settings.subheading_size_desktop }}px;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      grid-template-areas: "media content" "cta cta";
      column-gap: {{ section.settings.column_gap_desktop }}px;
      row-gap: {{ section.settings.cta_gap_desktop }}px;
      align-items: start;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__media {
      grid-area: media;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__content {
      grid-area: content;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__cta {
      grid-area: cta;
      text-align: center;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__cta-button {
      width: min(100%, {{ section.settings.button_width_desktop }}px);
      min-height: {{ section.settings.button_height_desktop }}px;
      font-size: {{ section.settings.button_text_size_desktop }}px;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__intro {
      font-size: {{ section.settings.intro_size_desktop }}px;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__question {
      font-size: {{ section.settings.question_size_desktop }}px;
      padding: {{ section.settings.question_padding_desktop }}px 0;
    }

    #mg-faq2-{{ section.id }} .mg-faq2__answer {
      font-size: {{ section.settings.answer_size_desktop }}px;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('mg-faq2-{{ section.id }}');
    if (!section) return;

    if ({{ section.settings.only_one_open | json }}) {
      section.querySelectorAll('details').forEach((detail) => {
        detail.addEventListener('toggle', () => {
          if (!detail.open) return;
          section.querySelectorAll('details[open]').forEach((other) => {
            if (other !== detail) other.removeAttribute('open');
          });
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Meowgical FAQ v2",
  "tag": "section",
  "class": "section-meowgical-faq-v2",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Taurine Experts®"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Essential Daily Taurine Support for Cats. <strong>The Vet-Formulated Feline Supplement</strong></p>"
    },

    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 2", "label": "Landscape" }
      ],
      "default": "1 / 1"
    },

    {
      "type": "header",
      "content": "Intro text"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro paragraph",
      "default": "<p>It's not just a supplement. It's a daily taurine boost that helps support <strong>heart, vision and energy</strong>. Backed by real science, real reviews, and thousands of happy cats.</p>"
    },

    {
      "type": "header",
      "content": "Accordion behavior"
    },
    {
      "type": "checkbox",
      "id": "only_one_open",
      "label": "Only allow one open answer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "label": "Enable FAQ structured data",
      "default": true
    },

    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SAVE 54% + FREE SHIPPING →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_use_gradient",
      "label": "Use gradient button",
      "default": true
    },
    {
      "type": "color",
      "id": "button_gradient_1",
      "label": "Gradient color 1",
      "default": "#3E50DC"
    },
    {
      "type": "color",
      "id": "button_gradient_2",
      "label": "Gradient color 2",
      "default": "#6695DE"
    },
    {
      "type": "range",
      "id": "button_gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 180,
      "step": 5,
      "unit": "deg",
