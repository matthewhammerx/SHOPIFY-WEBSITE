        },
        {
          "type": "menu",
          "settings": {
            "heading": "Shop",
            "menu": "main-menu"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Help",
            "menu": "footer"
          }
        }
      ]
