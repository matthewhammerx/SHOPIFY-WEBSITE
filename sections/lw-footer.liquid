{%- liquid
  assign menus = section.blocks | where: 'type', 'menu'
  assign badges = section.blocks | where: 'type', 'badge'
  assign brand = section.settings.brand_name | default: shop.name
-%}
<footer class="lwf{% if section.settings.rounded %} lwf--rounded{% endif %}" style="--lwf-bg: {{ section.settings.bg }}; --lwf-bg2: {{ section.settings.bg_2 }}; --lwf-fg: {{ section.settings.fg }}; --lwf-accent: {{ section.settings.accent }}; --lwf-pt: {{ section.settings.padding_top }}px;">
  <div class="lwf__wrap">
    {%- if badges.size > 0 -%}
      <ul class="lwf__trust">
        {%- for block in badges -%}
          <li class="lwf__badge" {{ block.shopify_attributes }}>
            <span class="lwf__badgeicon">{% render 'lw-icon', icon: block.settings.icon %}</span>
            <span><strong>{{ block.settings.title }}</strong>{%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="lwf__news">
        <div>
          <p class="lwf__newshead">{{ section.settings.news_heading }}</p>
          {%- if section.settings.news_text != blank -%}<p class="lwf__newstext">{{ section.settings.news_text }}</p>{%- endif -%}
        </div>
        {%- form 'customer', id: 'LwFooterNewsletter', class: 'lwf__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="lwf__ok">{{ section.settings.news_success }}</p>
          {%- else -%}
            <div class="lwf__field">
              <label class="lwf__sr" for="LwFooterEmail">Email</label>
              <input id="LwFooterEmail" type="email" name="contact[email]" placeholder="{{ section.settings.news_placeholder }}" autocomplete="email" required>
              <button type="submit">{{ section.settings.news_button }}</button>
            </div>
            {%- if form.errors -%}<p class="lwf__err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="lwf__top">
      <div class="lwf__brand">
        <a class="lwf__logo" href="{{ routes.root_url }}" style="--lwf-logo-w: {{ section.settings.logo_width }}px;">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name }}
          {%- else -%}
            {{ brand }}
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}<p class="lwf__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
        {%- if section.settings.instagram != blank or section.settings.tiktok != blank or section.settings.facebook != blank -%}
          <div class="lwf__social">
            {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg></a>{%- endif -%}
            {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v11.2a3.3 3.3 0 1 1-3.3-3.3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M14 3c.4 2.6 2.2 4.4 5 4.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></a>{%- endif -%}
            {%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 8H16V5h-1.8C11.9 5 11 6.4 11 8.6V10H9v3h2v6h3v-6h2l.5-3H14V8.8c0-.5.2-.8.5-.8z" fill="currentColor"/></svg></a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="lwf__cols">
        {%- for block in menus -%}
          <nav class="lwf__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<p class="lwf__head">{{ block.settings.heading }}</p>{%- endif -%}
            <ul>
              {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          </nav>
        {%- endfor -%}
        {%- if section.settings.contact_email != blank or section.settings.contact_note != blank -%}
          <div class="lwf__col">
            <p class="lwf__head">{{ section.settings.contact_heading }}</p>
            <ul>
              {%- if section.settings.contact_email != blank -%}<li><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></li>{%- endif -%}
              {%- if section.settings.contact_note != blank -%}<li class="lwf__muted">{{ section.settings.contact_note }}</li>{%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="lwf__bottom">
      <p class="lwf__copy">&copy; {{ 'now' | date: '%Y' }} {{ brand }}</p>
      {%- if section.settings.show_policies and shop.policies.size > 0 -%}
        <ul class="lwf__policies">
          {%- for policy in shop.policies -%}{%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="lwf__pay" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'lwf__payicon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}<div class="lwf__legal">{{ section.settings.disclaimer }}</div>{%- endif -%}
  </div>
  {%- if section.settings.show_wordmark -%}
    {%- if section.settings.wordmark_image != blank -%}
      <div class="lwf__wordmark-img" aria-hidden="true" style="--lwf-wm-w: {{ section.settings.wordmark_width }}%;">{{ section.settings.wordmark_image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: '', sizes: '100vw', widths: '800, 1200, 1800, 2400' }}</div>
    {%- else -%}
      <div class="lwf__wordmark" aria-hidden="true">{{ section.settings.wordmark | default: brand }}</div>
    {%- endif -%}
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "LW \u00b7 Footer",
  "tag": "section",
  "class": "lw-section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
