      "unit": "px",
      "default": 150
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (used when there is no logo)",
      "default": "LiverWell"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Complete liver support in one daily capsule. Clinically dosed, fully transparent."
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok link"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook link"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "contact_note",
      "label": "Note",
      "default": "Mon to Fri, 9am to 5pm EST. We reply within 24 hours."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "news_heading",
      "label": "Heading",
      "default": "Feel lighter. Get 10% off."
    },
    {
      "type": "text",
      "id": "news_text",
      "label": "Text",
      "default": "Join the LiverWell list for liver tips, new launches and member-only offers. No spam, ever."
    },
    {
      "type": "text",
      "id": "news_placeholder",
      "label": "Email placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "news_button",
      "label": "Button label",
      "default": "Join"
    },
    {
      "type": "text",
      "id": "news_success",
      "label": "Success message",
      "default": "Thanks for joining! Check your inbox."
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Small print",
      "default": "<p>\u2020These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show big wordmark at the bottom",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark text",
      "info": "Leave empty to use the brand name."
    },
    {
      "type": "image_picker",
      "id": "wordmark_image",
      "label": "Wordmark image",
      "info": "Optional. Replaces the text, e.g. your logo as a transparent PNG or SVG."
    },
    {
      "type": "range",
      "id": "wordmark_width",
      "label": "Wordmark image width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "label": "Rounded top corners",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#16301f"
    },
    {
      "type": "color",
      "id": "bg_2",
      "label": "Background glow",
      "default": "#2f5a3a"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#fafaf5"
    },
    {
      "type": "color",
