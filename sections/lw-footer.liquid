            },
            {
              "value": "factory",
              "label": "Factory"
            },
            {
              "value": "vegan",
              "label": "Vegan"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "lock",
              "label": "Lock"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "90-day money-back guarantee"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LW \u00b7 Footer",
      "blocks": [
        {
