<div class="lw lw-cd" style="--lw-bg: {{ section.settings.bg }}; --lw-fg: {{ section.settings.fg }};">
  {%- if section.settings.link != blank -%}<a class="lw-cd__link" href="{{ section.settings.link }}" aria-label="{{ section.settings.title | escape }}"></a>{%- endif -%}
  <div class="lw-cd__inner">
    <div class="lw-cd__copy">
      <div class="lw-cd__title">{{ section.settings.title }}</div>
      {%- if section.settings.text != blank -%}<div class="lw-cd__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="lw-cd__timer" data-lw-countdown data-mode="{{ section.settings.mode }}" data-end="{{ section.settings.end_date | escape }}" data-hours="{{ section.settings.hours }}">
      <div class="lw-cd__unit"><b data-h>00</b><span>{{ section.settings.label_hours }}</span></div><i>:</i>
      <div class="lw-cd__unit"><b data-m>00</b><span>{{ section.settings.label_mins }}</span></div><i>:</i>
      <div class="lw-cd__unit"><b data-s>00</b><span>{{ section.settings.label_secs }}</span></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LW · Sale countdown bar",
  "tag": "section",
  "class": "lw-section-countdown",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "FALL SALE"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext",
      "default": "Shop Now and Get Up To 50% Off"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (whole bar)"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Timer",
      "default": "midnight",
      "options": [
        {
          "value": "midnight",
          "label": "Resets every night at midnight"
        },
        {
          "value": "session",
          "label": "Per-visitor (X hours from first visit)"
        },
        {
          "value": "date",
          "label": "Counts down to a fixed date"
        }
      ]
    },
    {
      "type": "range",
      "id": "hours",
      "label": "Hours (per-visitor mode)",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date (fixed-date mode)",
      "default": "2026-10-31 23:59",
      "info": "Format: YYYY-MM-DD HH:MM (visitor local time)"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Hours label",
      "default": "Hrs"
    },
    {
      "type": "text",
      "id": "label_mins",
      "label": "Minutes label",
      "default": "Mins"
    },
    {
      "type": "text",
      "id": "label_secs",
      "label": "Seconds label",
      "default": "Secs"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#095946"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "LW · Sale countdown bar"
    }
  ]
}
{% endschema %}
