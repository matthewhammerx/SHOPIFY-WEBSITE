{% comment %}
  Meowgical - Daily Ritual Hero
  A rounded color card sits inset inside the section (like Gruns' final-cta block),
  not a full-bleed hero. Text + button on one side, image bleeding to the card edge on the other.
{% endcomment %}

{%- if section.settings.image_position == 'left' -%}
  {%- assign image_direction = 'row-reverse' -%}
{%- else -%}
  {%- assign image_direction = 'row' -%}
{%- endif -%}

{%- if section.settings.text_align_mobile == 'center' -%}
  {%- assign align_mobile = 'center' -%}
  {%- assign text_align_mobile = 'center' -%}
{%- else -%}
  {%- assign align_mobile = 'flex-start' -%}
  {%- assign text_align_mobile = 'left' -%}
{%- endif -%}

<section id="hr-hero-{{ section.id }}" class="hr-hero" style="--hr-image-direction: {{ image_direction }}; --hr-align-mobile: {{ align_mobile }}; --hr-text-align-mobile: {{ text_align_mobile }};">
  <div class="hr-inner">
    <div class="hr-card">

      <div class="hr-text">
        {%- if section.settings.rating_count > 0 or section.settings.proof_text != blank -%}
          <div class="hr-proof">
            {%- if section.settings.rating_count > 0 -%}
              <span class="hr-stars">
                {%- for i in (1..section.settings.rating_count) -%}
                  <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M10 1.5l2.59 5.24 5.78.84-4.18 4.08.99 5.76L10 14.77l-5.18 2.65.99-5.76-4.18-4.08 5.78-.84L10 1.5z"/></svg>
                {%- endfor -%}
              </span>
            {%- endif -%}
            {%- if section.settings.proof_text != blank -%}
              <span class="hr-proof-text">{{ section.settings.proof_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="hr-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="hr-body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '#product-form' }}" class="hr-button">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>

      <div class="hr-media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 860px) 560px, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="eager"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="hr-image"
          >
        {%- else -%}
          <div class="hr-placeholder">
            {{ 'image' | placeholder_svg_tag: 'hr-placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
  #hr-hero-{{ section.id }} {
    background: {{ section.settings.outer_bg }};
    padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_side_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
  }

  #hr-hero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #hr-hero-{{ section.id }} .hr-inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #hr-hero-{{ section.id }} .hr-card {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.bg_color }};
    border-radius: {{ section.settings.card_radius_mobile }}px;
    display: flex;
    flex-direction: column;
  }

  #hr-hero-{{ section.id }} .hr-text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: var(--hr-align-mobile, flex-start);
    text-align: var(--hr-text-align-mobile, left);
    gap: 16px;
    padding: {{ section.settings.text_padding_mobile }}px {{ section.settings.text_padding_mobile }}px 0;
  }

  #hr-hero-{{ section.id }} .hr-proof {
    display: flex;
    align-items: center;
    justify-content: var(--hr-align-mobile, flex-start);
    gap: 8px;
    flex-wrap: wrap;
    width: 100%;
  }

  #hr-hero-{{ section.id }} .hr-stars {
    display: flex;
    gap: 2px;
  }

  #hr-hero-{{ section.id }} .hr-stars svg {
    width: {{ section.settings.star_size_mobile }}px;
    height: {{ section.settings.star_size_mobile }}px;
    color: {{ section.settings.star_color }};
  }

  #hr-hero-{{ section.id }} .hr-proof-text {
    color: {{ section.settings.proof_text_color }};
    font-size: {{ section.settings.proof_text_size_mobile }}px;
    font-weight: 600;
  }

  #hr-hero-{{ section.id }} .hr-heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  #hr-hero-{{ section.id }} .hr-heading strong,
  #hr-hero-{{ section.id }} .hr-heading em {
    color: {{ section.settings.heading_accent }};
    font-style: normal;
    font-weight: inherit;
  }

  #hr-hero-{{ section.id }} .hr-body,
  #hr-hero-{{ section.id }} .hr-body p {
    margin: 0;
    max-width: 46ch;
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_size_mobile }}px;
    line-height: 1.55;
  }

  #hr-hero-{{ section.id }} .hr-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.button_height_mobile }}px;
    padding: 14px 30px;
    border-radius: 999px;
    {% if section.settings.button_use_gradient %}
      background: linear-gradient(135deg, {{ section.settings.button_gradient_1 }}, {{ section.settings.button_gradient_2 }});
    {% else %}
      background: {{ section.settings.button_bg }};
    {% endif %}
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.button_text_size_mobile }}px;
    font-weight: 800;
    letter-spacing: 0.01em;
    margin-top: 4px;
    margin-bottom: {{ section.settings.text_padding_mobile }}px;
    transition: transform 0.2s ease;
  }

  #hr-hero-{{ section.id }} .hr-button:hover {
    transform: translateY(-1px);
  }

  #hr-hero-{{ section.id }} .hr-media {
    position: relative;
    width: 100%;
    margin-top: {{ section.settings.stack_gap_mobile }}px;
  }

  #hr-hero-{{ section.id }} .hr-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  #hr-hero-{{ section.id }} .hr-placeholder svg {
    width: 100%;
    height: auto;
  }

  @media screen and (min-width: 860px) {
    #hr-hero-{{ section.id }} {
      padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_side_desktop }}px {{ section.settings.padding_bottom_desktop }}px;
    }

    #hr-hero-{{ section.id }} .hr-card {
      flex-direction: var(--hr-image-direction, row);
      align-items: stretch;
      min-height: {{ section.settings.card_min_height_desktop }}px;
      border-radius: {{ section.settings.card_radius_desktop }}px;
    }

    #hr-hero-{{ section.id }} .hr-text {
      flex: 1 1 0%;
      justify-content: center;
      padding: {{ section.settings.text_padding_desktop }}px {{ section.settings.column_gap_desktop }}px {{ section.settings.text_padding_desktop }}px {{ section.settings.text_padding_desktop }}px;
    }

    #hr-hero-{{ section.id }} .hr-button {
      margin-bottom: 0;
    }

    #hr-hero-{{ section.id }} .hr-media {
      flex: 0 0 {{ section.settings.image_width_desktop }}%;
      margin-top: 0;
      align-self: stretch;
    }

    #hr-hero-{{ section.id }} .hr-image,
    #hr-hero-{{ section.id }} .hr-placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #hr-hero-{{ section.id }} .hr-image {
      object-position: {{ section.settings.image_focal_x }}% {{ section.settings.image_focal_y }}%;
    }

    #hr-hero-{{ section.id }} .hr-stars svg {
      width: {{ section.settings.star_size_desktop }}px;
      height: {{ section.settings.star_size_desktop }}px;
    }

    #hr-hero-{{ section.id }} .hr-proof-text {
      font-size: {{ section.settings.proof_text_size_desktop }}px;
    }

    #hr-hero-{{ section.id }} .hr-heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #hr-hero-{{ section.id }} .hr-body,
    #hr-hero-{{ section.id }} .hr-body p {
      font-size: {{ section.settings.body_size_desktop }}px;
    }

    #hr-hero-{{ section.id }} .hr-button {
      min-height: {{ section.settings.button_height_desktop }}px;
      font-size: {{ section.settings.button_text_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Daily Ritual Hero",
  "settings": [
    {
      "type": "header",
      "content": "Proof line"
    },
    {
      "type": "range",
      "id": "rating_count",
      "label": "Star rating",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "star_size_mobile",
      "label": "Star size mobile",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "star_size_desktop",
      "label": "Star size desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18
    },
    {
      "type": "text",
      "id": "proof_text",
      "label": "Proof text",
      "default": "4.8 Rating • Loved by Cat Parents • 60-Day Guarantee"
    },
    {
      "type": "range",
      "id": "proof_text_size_mobile",
      "label": "Proof text size mobile",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "proof_text_size_desktop",
      "label": "Proof text size desktop",
      "min": 11,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Headline",
      "default": "<p>Try SuperTaurine For 60 Days—Risk Free</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>We want SuperTaurine to earn its place in your cat's daily routine. If it's not the right fit, contact us within 60 days and we'll make it right.</p>"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center",
      "info": "Applies to the proof line, headline, body copy, and button on mobile. Desktop always stays left-aligned."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start Daily Support →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Image width (desktop)",
      "min": 35,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "image_focal_x",
      "label": "Image focal point X (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_focal_y",
      "label": "Image focal point Y (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "range",
      "id": "card_radius_mobile",
      "label": "Card corner radius mobile",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "card_radius_desktop",
      "label": "Card corner radius desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 30
    },
    {
      "type": "range",
      "id": "card_min_height_desktop",
      "label": "Card minimum height desktop",
      "min": 320,
      "max": 760,
      "step": 10,
      "default": 560
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1280
    },
    {
      "type": "range",
      "id": "text_padding_mobile",
      "label": "Text padding mobile",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "text_padding_desktop",
      "label": "Text padding desktop",
      "min": 24,
      "max": 80,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "label": "Space between text and image edge (desktop)",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "stack_gap_mobile",
      "label": "Text/image gap mobile",
      "min": 12,
      "max": 60,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Section top padding mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Section bottom padding mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_side_mobile",
      "label": "Section side padding mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Section top padding desktop",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Section bottom padding desktop",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_side_desktop",
      "label": "Section side padding desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 22,
      "max": 48,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 30,
      "max": 72,
      "step": 1,
      "default": 48
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body text size mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Body text size desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "button_text_size_mobile",
      "label": "Button text size mobile",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "button_text_size_desktop",
      "label": "Button text size desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "button_height_mobile",
      "label": "Button height mobile",
      "min": 40,
      "max": 76,
      "step": 2,
      "default": 52
    },
    {
      "type": "range",
      "id": "button_height_desktop",
      "label": "Button height desktop",
      "min": 44,
      "max": 84,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "outer_bg",
      "label": "Page background (around the card)",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Card background",
      "default": "#101A3D"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "#8FA6FF"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#D7DCF2"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFC93C"
    },
    {
      "type": "color",
      "id": "proof_text_color",
      "label": "Proof text",
      "default": "#D7DCF2"
    },
    {
      "type": "checkbox",
      "id": "button_use_gradient",
      "label": "Use gradient button",
      "default": false
    },
    {
      "type": "color",
      "id": "button_gradient_1",
      "label": "Button gradient color 1",
      "default": "#3E50DC"
    },
    {
      "type": "color",
      "id": "button_gradient_2",
      "label": "Button gradient color 2",
      "default": "#6695DE"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background (solid)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#173FAE"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Daily Ritual Hero"
    }
  ]
}
{% endschema %}