{%- liquid
  assign lw_product = product
  if section.settings.product != blank
    assign lw_product = section.settings.product
  endif
  assign tiles = section.blocks | where: 'type', 'tile'
  assign offer_blocks = section.blocks | where: 'type', 'offer'
  assign bundle_gallery = false
  assign bundle_default = ''
  for b in offer_blocks
    if b.settings.gallery_image != blank
      assign bundle_gallery = true
    endif
    if b.settings.default_selected and bundle_default == ''
      assign bundle_default = b.id
    endif
  endfor
  if bundle_default == '' and offer_blocks.size > 0
    assign bundle_default = offer_blocks.first.id
  endif
  assign fallback_class = 'is-on'
  for b in offer_blocks
    if b.id == bundle_default and b.settings.gallery_image != blank
      assign fallback_class = ''
    endif
  endfor
  assign bundle_gallery2 = false
  assign slot2_hidden = true
  for b in offer_blocks
    if b.settings.gallery_image_2 != blank
      assign bundle_gallery2 = true
      if b.id == bundle_default
        assign slot2_hidden = false
      endif
    endif
  endfor
  if bundle_gallery == false
    assign bundle_gallery2 = false
  endif
  assign first_media = lw_product.media.first
  assign media_offset = 0
  if bundle_gallery
    assign media_offset = 1
  endif
-%}
<section class="lw lw-pdp" id="lw-product" style="--lw-bg: {{ section.settings.bg }};">
  <div class="lw-wrap lw-pdp__grid">
    <div class="lw-pdp__left{% if section.settings.sticky_left %} lw-pdp__left--sticky{% endif %}" style="--lw-sticky-offset: {{ section.settings.sticky_offset }}px;">
    <div class="lw-pdp__media lw-pdp__gallery">
      <div class="lw-gallery" data-lw-gallery>
        <div class="lw-gallery__stage{% if tiles.size > 0 %} lw-gallery__stage--tiles{% endif %}">
          <div class="lw-gallery__main">
            <div class="lw-gallery__slides">
              {%- if bundle_gallery -%}
                {%- comment -%} Bundle slide: shows the picked offer's "Gallery image" (falls back to the first product image) {%- endcomment -%}
                <div class="lw-gallery__slide lw-gallery__bundle" data-lw-bundle-media>
                  {%- if first_media -%}
                    {{ first_media.preview_image | image_url: width: 1100 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 600px, 100vw', widths: '400, 600, 800, 1100', alt: first_media.alt, data-lw-bundle-img: 'default', class: fallback_class }}
                  {%- endif -%}
                  {%- for b in offer_blocks -%}
                    {%- if b.settings.gallery_image != blank -%}
                      {%- liquid
                        assign bload = 'lazy'
                        assign bclass = ''
                        if b.id == bundle_default
                          assign bload = 'eager'
                          assign bclass = 'is-on'
                        endif
                      -%}
                      {{ b.settings.gallery_image | image_url: width: 1100 | image_tag: loading: bload, sizes: '(min-width: 990px) 600px, 100vw', widths: '400, 600, 800, 1100', alt: b.settings.gallery_image.alt, data-lw-bundle-img: b.id, class: bclass }}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if bundle_gallery2 -%}
                  <div class="lw-gallery__slide lw-gallery__bundle" data-lw-bundle-media="2"{% if slot2_hidden %} hidden{% endif %}>
                    {%- for b in offer_blocks -%}
                      {%- if b.settings.gallery_image_2 != blank -%}
                        {%- if b.id == bundle_default -%}{%- assign bclass = 'is-on' -%}{%- else -%}{%- assign bclass = '' -%}{%- endif -%}
                        {{ b.settings.gallery_image_2 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 600px, 100vw', widths: '400, 600, 800, 1100', alt: b.settings.gallery_image_2.alt, data-lw-bundle-img: b.id, class: bclass }}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
              {%- for media in lw_product.media offset: media_offset -%}
                <div class="lw-gallery__slide">
                  {%- liquid
                    assign load = 'lazy'
                    if forloop.first
                      assign load = 'eager'
                    endif
                  -%}
                  {%- case media.media_type -%}
                    {%- when 'video' -%}
                      {{ media | video_tag: controls: true, playsinline: true, muted: true, loop: true, image_size: '1100x' }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag }}
                    {%- else -%}
                      {{ media.preview_image | image_url: width: 1100 | image_tag: loading: load, sizes: '(min-width: 990px) 600px, 100vw', widths: '400, 600, 800, 1100', alt: media.alt }}
                  {%- endcase -%}
                </div>
              {%- else -%}
                <div class="lw-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'lw-placeholder' }}</div>
              {%- endfor -%}
            </div>
            {%- if section.settings.show_arrows and lw_product.media.size > 1 or section.settings.show_arrows and bundle_gallery2 -%}
              <button type="button" class="lw-gallery__arrow lw-gallery__arrow--prev" aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 6-6 6 6 6"/></svg></button>
              <button type="button" class="lw-gallery__arrow lw-gallery__arrow--next" aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 6 6 6-6 6"/></svg></button>
            {%- endif -%}
          </div>
          {%- if tiles.size > 0 -%}
            <div class="lw-gallery__tiles">
              {%- for block in tiles -%}
                <div class="lw-gallery__tile{% if block.settings.image != blank %} lw-gallery__tile--img{% endif %}" style="--lw-tile-bg: {{ block.settings.bg }}; --lw-tile-fg: {{ block.settings.fg }};" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.text }}
                  {%- else -%}
                    {% render 'lw-icon', icon: block.settings.icon %}
                    <span>{{ block.settings.text }}</span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        {%- if lw_product.media.size > 1 or bundle_gallery2 -%}
          <div class="lw-gallery__thumbs{% unless section.settings.thumbs_mobile %} lw-hide-mobile{% endunless %}{% unless section.settings.thumbs_desktop %} lw-hide-desktop{% endunless %}">
            {%- if bundle_gallery -%}
              <button type="button" class="lw-gallery__thumb lw-gallery__bundle is-active" aria-label="Show bundle image" data-lw-bundle-media>
                {%- if first_media -%}{{ first_media.preview_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', data-lw-bundle-img: 'default', class: fallback_class }}{%- endif -%}
                {%- for b in offer_blocks -%}
                  {%- if b.settings.gallery_image != blank -%}{%- if b.id == bundle_default -%}{%- assign bclass = 'is-on' -%}{%- else -%}{%- assign bclass = '' -%}{%- endif -%}{{ b.settings.gallery_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', data-lw-bundle-img: b.id, class: bclass }}{%- endif -%}
                {%- endfor -%}
              </button>
              {%- if bundle_gallery2 -%}
                <button type="button" class="lw-gallery__thumb lw-gallery__bundle" aria-label="Show bundle image 2" data-lw-bundle-media="2"{% if slot2_hidden %} hidden{% endif %}>
                  {%- for b in offer_blocks -%}
                    {%- if b.settings.gallery_image_2 != blank -%}{%- if b.id == bundle_default -%}{%- assign bclass = 'is-on' -%}{%- else -%}{%- assign bclass = '' -%}{%- endif -%}{{ b.settings.gallery_image_2 | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', data-lw-bundle-img: b.id, class: bclass }}{%- endif -%}
                  {%- endfor -%}
                </button>
              {%- endif -%}
            {%- endif -%}
            {%- for media in lw_product.media offset: media_offset -%}
              <button type="button" class="lw-gallery__thumb{% if forloop.first and bundle_gallery == false %} is-active{% endif %}" aria-label="Show media {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

    </div>
    {%- comment -%} The "LW · Customer videos" section moves its carousel in here (see liverwell.js) {%- endcomment -%}
    <div class="lw-pdp__ugc" data-lw-ugc-slot></div>
    </div>

    <div class="lw-pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'rating' -%}
            <div class="lw-rating" {{ block.shopify_attributes }}>
              {% render 'lw-stars', count: 5 %}
              <span>{{ block.settings.text }}</span>
              {%- if block.settings.avatar_1 != blank or block.settings.show_avatars -%}
                <span class="lw-rating__avatars">
                  {%- for i in (1..4) -%}
                    {%- liquid
                      case i
                        when 1
                          assign av = block.settings.avatar_1
                        when 2
                          assign av = block.settings.avatar_2
                        when 3
                          assign av = block.settings.avatar_3
                        else
                          assign av = block.settings.avatar_4
                      endcase
                    -%}
                    {%- if av != blank -%}{{ av | image_url: width: 60 | image_tag: loading: 'lazy', alt: '' }}{%- elsif block.settings.show_avatars -%}<span></span>{%- endif -%}
                  {%- endfor -%}
                </span>
              {%- endif -%}
            </div>
          {%- when 'eyebrow' -%}
            <div class="lw-pdp__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'title' -%}
            <h1 class="lw-pdp__title{% if block.settings.weight != blank and block.settings.weight != 'normal' %} lw-pdp__title--{{ block.settings.weight }}{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.title != blank %}{{ block.settings.title }}{% else %}{{ lw_product.title }}{% endif %}</h1>
          {%- when 'text' -%}
            <div class="lw-pdp__desc lw-rte" {{ block.shopify_attributes }}>
              {%- if block.settings.use_product_description -%}{{ lw_product.description }}{%- else -%}{{ block.settings.text }}{%- endif -%}
            </div>
          {%- when 'benefits' -%}
            <div class="lw-benefit-grid" {{ block.shopify_attributes }}>
              {%- for i in (1..6) -%}
                {%- liquid
                  assign k_text = 'text_' | append: i
                  assign k_icon = 'icon_' | append: i
                  assign t = block.settings[k_text]
                -%}
                {%- if t != blank -%}<div class="lw-benefit-grid__item">{% render 'lw-icon', icon: block.settings[k_icon] %}<span>{{ t | replace: '†', '<sup>†</sup>' }}</span></div>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- when 'stock' -%}
            <div class="lw-stock" {{ block.shopify_attributes }}>
              <div class="lw-stock__bar"><span data-lw-width="{{ block.settings.percent }}%"></span></div>
              <span>{{ block.settings.text | replace: '[percent]', block.settings.percent }}</span>
            </div>
          {%- when 'buy_box' -%}
            {%- render 'lw-buy-box', lw_product: lw_product, bs: block.settings, section: section, main: true, attrs: block.shopify_attributes -%}
          {%- when 'collapsible' -%}
            <div class="lw-acc" {{ block.shopify_attributes }}>
              <details{% if block.settings.open %} open{% endif %}>
                <summary><span class="lw-acc__title">{% if block.settings.icon != 'none' %}{% render 'lw-icon', icon: block.settings.icon %}{% endif %}{{ block.settings.heading }}</span><span class="lw-acc__plus" aria-hidden="true"></span></summary>
                <div class="lw-acc__body lw-rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            </div>
          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{%- if lw_product != blank -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ lw_product.title | json }},
    "url": {{ request.origin | append: lw_product.url | json }},
    {% if lw_product.featured_image %}"image": [{{ lw_product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}],{% endif %}
    "description": {{ lw_product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ lw_product.vendor | json }} },
    "offers": [
      {%- for variant in lw_product.variants -%}
        {
          "@type": "Offer",
          {% if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

