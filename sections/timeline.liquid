{% comment %}
  Herbans Timeline Section
  - Richtext heading
  - Bold words in heading use accent color
  - Editable timeline items
  - Image collage
  - How-to box
{% endcomment %}

<section id="timeline-seed-{{ section.id }}" class="timeline-seed-section">
  <div class="timeline-seed-container">

    <div class="timeline-seed-header">
      {% if section.settings.heading != blank %}
        <div class="timeline-seed-heading">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.intro != blank %}
        <div class="timeline-seed-intro">
          {{ section.settings.intro }}
        </div>
      {% endif %}
    </div>

    <div class="timeline-seed-grid">

      <div class="timeline-seed-left">
        <div class="timeline-milestones">
          {% for block in section.blocks %}
            <div class="timeline-milestone" {{ block.shopify_attributes }}>
              <span class="timeline-dot"></span>
              <span class="timeline-line-base"></span>
              <span class="timeline-line-progress"></span>

              <div class="timeline-week-row">
                {% if block.settings.week_text != blank %}
                  <span class="timeline-week-pill">
                    {{ block.settings.week_text }}
                  </span>
                {% endif %}

                {% if block.settings.title_text != blank %}
                  <span class="timeline-week-title">
                    {{ block.settings.title_text }}
                  </span>
                {% endif %}
              </div>

              {% if block.settings.description != blank %}
                <div class="timeline-description-text">
                  {{ block.settings.description }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        </div>

      <div class="timeline-seed-images">
        {% if section.settings.image_large != blank %}
          <div class="timeline-image-large timeline-image-card">
            <img
              src="{{ section.settings.image_large | image_url: width: 1000 }}"
              alt="{{ section.settings.image_large_alt | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}
      </div>

    </div>

    {% if section.settings.button_text != blank %}
      <div class="timeline-cta-wrap">
        <a href="{{ section.settings.button_link | default: '#' }}" class="timeline-cta-button">
          {{ section.settings.button_text }}
        </a>

        {% if section.settings.guarantee_text != blank %}
          <div class="timeline-guarantee">
            {% if section.settings.guarantee_icon != blank %}
              <img
                src="{{ section.settings.guarantee_icon | image_url: width: 60 }}"
                alt=""
                loading="lazy"
              >
            {% endif %}
            <span>{{ section.settings.guarantee_text }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  #timeline-seed-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #timeline-seed-{{ section.id }} * {
    box-sizing: border-box;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-header {
    text-align: center;
    max-width: {{ section.settings.header_width }}px;
    margin: 0 auto {{ section.settings.header_bottom }}px;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-heading,
  #timeline-seed-{{ section.id }} .timeline-seed-heading p {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: {{ section.settings.heading_line_height }}px;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-heading {
    margin-bottom: {{ section.settings.heading_bottom }}px;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-heading strong {
    color: {{ section.settings.heading_accent_color }};
    font-weight: inherit;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-heading em {
    color: {{ section.settings.heading_accent_color }};
    font-family: Georgia, serif;
    font-style: italic;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-intro,
  #timeline-seed-{{ section.id }} .timeline-seed-intro p {
    color: {{ section.settings.intro_color }};
    font-size: {{ section.settings.intro_size }}px;
    line-height: {{ section.settings.intro_line_height }}px;
    margin: 0;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.mobile_gap }}px;
    align-items: center;
    justify-content: center;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-left {
    width: 100%;
    max-width: {{ section.settings.timeline_max_width }}px;
    margin: 0 auto;
  }

  #timeline-seed-{{ section.id }} .timeline-seed-images {
    display: block;
    gap: {{ section.settings.image_gap }}px;
    width: 100%;
    max-width: {{ section.settings.image_collage_max_width }}px;
    margin: 0 auto;
  }

  #timeline-seed-{{ section.id }} .timeline-milestones {
    display: flex;
    flex-direction: column;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone {
    position: relative;
    padding-left: {{ section.settings.timeline_padding_left }}px;
    padding-bottom: {{ section.settings.item_gap }}px;
    opacity: {{ section.settings.inactive_opacity | divided_by: 100.0 }};
    transition: opacity 0.8s ease;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone:last-child {
    padding-bottom: 0;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone.active {
    opacity: 1;
  }

  #timeline-seed-{{ section.id }} .timeline-dot {
    position: absolute;
    left: 0;
    top: {{ section.settings.dot_top }}px;
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    border-radius: 50%;
    background: {{ section.settings.inactive_dot_color }};
    z-index: 3;
    transition: background 0.8s ease;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone.active .timeline-dot {
    background: {{ section.settings.active_dot_color }};
  }

  #timeline-seed-{{ section.id }} .timeline-line-base {
    position: absolute;
    left: {{ section.settings.line_left }}px;
    top: {{ section.settings.line_top }}px;
    width: {{ section.settings.line_width }}px;
    height: 100%;
    background: {{ section.settings.inactive_line_color }};
    pointer-events: none;
  }

  #timeline-seed-{{ section.id }} .timeline-line-progress {
    position: absolute;
    left: {{ section.settings.progress_line_left }}px;
    top: {{ section.settings.line_top }}px;
    width: {{ section.settings.progress_line_width }}px;
    height: 0;
    background: {{ section.settings.active_line_color }};
    z-index: 2;
    pointer-events: none;
    transition: height 1.1s ease;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone.active .timeline-line-progress {
    height: {{ section.settings.progress_height }}%;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone:last-child .timeline-line-base,
  #timeline-seed-{{ section.id }} .timeline-milestone:last-child .timeline-line-progress {
    display: none;
  }

  #timeline-seed-{{ section.id }} .timeline-week-row {
    display: flex;
    align-items: center;
    gap: {{ section.settings.week_row_gap }}px;
    margin-bottom: {{ section.settings.row_bottom }}px;
    flex-wrap: wrap;
  }

  #timeline-seed-{{ section.id }} .timeline-week-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.pill_padding_y }}px {{ section.settings.pill_padding_x }}px;
    border-radius: {{ section.settings.pill_radius }}px;
    min-height: {{ section.settings.pill_height }}px;
    background: {{ section.settings.inactive_pill_bg }};
    color: {{ section.settings.inactive_pill_text }};
    font-size: {{ section.settings.pill_size }}px;
    line-height: 1;
    font-weight: {{ section.settings.pill_weight }};
    white-space: nowrap;
    transition: background 0.8s ease, color 0.8s ease;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone.active .timeline-week-pill {
    background: {{ section.settings.active_pill_bg }};
    color: {{ section.settings.active_pill_text }};
  }

  #timeline-seed-{{ section.id }} .timeline-week-title {
    color: {{ section.settings.inactive_title_color }};
    font-size: {{ section.settings.title_size }}px;
    line-height: {{ section.settings.title_line_height }}px;
    font-weight: {{ section.settings.title_weight }};
    transition: color 0.8s ease;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone.active .timeline-week-title {
    color: {{ section.settings.active_title_color }};
  }

  #timeline-seed-{{ section.id }} .timeline-description-text {
    color: {{ section.settings.inactive_description_color }};
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height }}px;
    max-width: {{ section.settings.description_width }}px;
    transition: color 0.8s ease;
  }

  #timeline-seed-{{ section.id }} .timeline-description-text p {
    margin: 0;
  }

  #timeline-seed-{{ section.id }} .timeline-milestone.active .timeline-description-text {
    color: {{ section.settings.active_description_color }};
  }

  #timeline-seed-{{ section.id }} .timeline-how-to-box {
    margin-top: {{ section.settings.how_to_margin_top }}px;
    background: {{ section.settings.how_to_bg }};
    border-radius: {{ section.settings.how_to_radius }}px;
    padding: {{ section.settings.how_to_padding_y }}px {{ section.settings.how_to_padding_x }}px;
    display: flex;
    align-items: center;
    gap: {{ section.settings.how_to_gap }}px;
    width: 100%;
  }

  #timeline-seed-{{ section.id }} .timeline-how-to-image-wrap {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #timeline-seed-{{ section.id }} .timeline-how-to-image {
    width: {{ section.settings.how_to_image_width }}px;
    height: {{ section.settings.how_to_image_height }}px;
    object-fit: contain;
    display: block;
  }

  #timeline-seed-{{ section.id }} .timeline-how-to-content {
    flex: 1;
  }

  #timeline-seed-{{ section.id }} .timeline-how-to-title {
    font-size: {{ section.settings.how_to_title_size }}px;
    line-height: 1.2;
    font-weight: 700;
    color: {{ section.settings.how_to_title_color }};
    margin-bottom: 4px;
  }

  #timeline-seed-{{ section.id }} .timeline-how-to-list {
    margin: 0;
    padding-left: 16px;
    color: {{ section.settings.how_to_text_color }};
  }

  #timeline-seed-{{ section.id }} .timeline-how-to-list li {
    font-size: {{ section.settings.how_to_text_size }}px;
    line-height: {{ section.settings.how_to_text_line_height }}px;
    margin-bottom: 2px;
  }

  #timeline-seed-{{ section.id }} .timeline-how-to-list li:last-child {
    margin-bottom: 0;
  }

  #timeline-seed-{{ section.id }} .timeline-image-card {
    overflow: hidden;
    background: {{ section.settings.image_placeholder_bg }};
  }

  #timeline-seed-{{ section.id }} .timeline-image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #timeline-seed-{{ section.id }} .timeline-image-large {
    width:100%;
    border-radius: {{ section.settings.large_image_radius }}px;
  }
  #timeline-seed-{{ section.id }} .timeline-cta-wrap {
    margin-top: {{ section.settings.cta_top }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #timeline-seed-{{ section.id }} .timeline-cta-button {
    {% if section.settings.button_use_gradient %}
      background: linear-gradient(
        135deg,
        {{ section.settings.button_gradient_1 }},
        {{ section.settings.button_gradient_2 }}
      );
      border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_gradient_1 }};
    {% else %}
      background: {{ section.settings.button_bg }};
      border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_bg }};
    {% endif %}

    color: {{ section.settings.button_text_color }};
    min-height: {{ section.settings.button_height }}px;
    max-width: {{ section.settings.button_width }}px;
    width: 100%;
    padding: 12px 32px;
    border-radius: {{ section.settings.button_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.button_font_size }}px;
    line-height: 1.2;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  #timeline-seed-{{ section.id }} .timeline-cta-button:hover {
    background: transparent;

    {% if section.settings.button_use_gradient %}
      color: {{ section.settings.button_gradient_1 }};
      border-color: {{ section.settings.button_gradient_1 }};
    {% else %}
      color: {{ section.settings.button_bg }};
      border-color: {{ section.settings.button_bg }};
    {% endif %}

    transform: translateY(-1px);
  }

  #timeline-seed-{{ section.id }} .timeline-guarantee {
    margin-top: {{ section.settings.guarantee_top }}px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
    font-size: {{ section.settings.guarantee_size }}px;
    line-height: 1.3;
    color: {{ section.settings.guarantee_color }};
    text-align: center;
  }

  #timeline-seed-{{ section.id }} .timeline-guarantee img {
    max-width: {{ section.settings.guarantee_icon_size }}px;
    height: auto;
  }

  @media screen and (min-width: 992px) {
    #timeline-seed-{{ section.id }} .timeline-seed-grid {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: {{ section.settings.desktop_gap }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-left {
      order: {% if section.settings.image_position == 'left' %}2{% else %}1{% endif %};
      flex: 0 1 auto;
      width: auto;
      max-width: {{ section.settings.timeline_max_width }}px;
      margin: 0;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-images {
      order: {% if section.settings.image_position == 'left' %}1{% else %}2{% endif %};
      flex: 0 1 auto;
      width: auto;
      max-width: {{ section.settings.image_collage_max_width }}px;
      height: {{ section.settings.image_collage_height }}px;
      margin: 0;
    }

    #timeline-seed-{{ section.id }} .timeline-image-large {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 991px) {
    #timeline-seed-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-container {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-header {
      margin-bottom: {{ section.settings.mobile_header_bottom }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-heading,
    #timeline-seed-{{ section.id }} .timeline-seed-heading p {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: {{ section.settings.mobile_heading_line_height }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-heading {
      margin-bottom: {{ section.settings.mobile_heading_bottom }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-intro,
    #timeline-seed-{{ section.id }} .timeline-seed-intro p {
      font-size: {{ section.settings.mobile_intro_size }}px;
      line-height: {{ section.settings.mobile_intro_line_height }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-left {
      order: {% if section.settings.mobile_image_first %}2{% else %}1{% endif %};
      max-width: 100%;
      justify-self: stretch;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-images {
      order: {% if section.settings.mobile_image_first %}1{% else %}2{% endif %};
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
      margin: 0 auto;
      justify-self: stretch;
      overflow: visible;
    }

    #timeline-seed-{{ section.id }} .timeline-image-large {
      width: 100%;
      height: auto;
      border-radius: {{ section.settings.mobile_image_radius }}px;
      overflow: hidden;
    }

    #timeline-seed-{{ section.id }} .timeline-image-large img {
      width: 100%;
      height: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: center;
      display: block;
    }

    #timeline-seed-{{ section.id }} .timeline-milestone {
      padding-left: {{ section.settings.mobile_timeline_padding_left }}px;
      padding-bottom: {{ section.settings.mobile_item_gap }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-dot {
      width: {{ section.settings.mobile_dot_size }}px;
      height: {{ section.settings.mobile_dot_size }}px;
      top: {{ section.settings.mobile_dot_top }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-line-base {
      left: {{ section.settings.mobile_line_left }}px;
      top: {{ section.settings.mobile_line_top }}px;
      width: {{ section.settings.mobile_line_width }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-line-progress {
      left: {{ section.settings.mobile_progress_line_left }}px;
      top: {{ section.settings.mobile_line_top }}px;
      width: {{ section.settings.mobile_progress_line_width }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-week-row {
      gap: {{ section.settings.mobile_week_row_gap }}px;
      margin-bottom: {{ section.settings.mobile_row_bottom }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-week-pill {
      padding: {{ section.settings.mobile_pill_padding_y }}px {{ section.settings.mobile_pill_padding_x }}px;
      min-height: {{ section.settings.mobile_pill_height }}px;
      border-radius: {{ section.settings.mobile_pill_radius }}px;
      font-size: {{ section.settings.mobile_pill_size }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-week-title {
      font-size: {{ section.settings.mobile_title_size }}px;
      line-height: {{ section.settings.mobile_title_line_height }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-description-text {
      font-size: {{ section.settings.mobile_description_size }}px;
      line-height: {{ section.settings.mobile_description_line_height }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-how-to-box {
      margin-top: {{ section.settings.mobile_how_to_margin_top }}px;
      border-radius: {{ section.settings.mobile_how_to_radius }}px;
      padding: {{ section.settings.mobile_how_to_padding_y }}px {{ section.settings.mobile_how_to_padding_x }}px;
      gap: {{ section.settings.mobile_how_to_gap }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-how-to-image {
      width: {{ section.settings.mobile_how_to_image_width }}px;
      height: {{ section.settings.mobile_how_to_image_height }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-how-to-title {
      font-size: {{ section.settings.mobile_how_to_title_size }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-how-to-list li {
      font-size: {{ section.settings.mobile_how_to_text_size }}px;
      line-height: {{ section.settings.mobile_how_to_text_line_height }}px;
    }

    #timeline-seed-{{ section.id }} .timeline-cta-button {
      max-width: 100%;
      min-height: {{ section.settings.mobile_button_height }}px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
    }
  }

  @media screen and (max-width: 480px) {
    #timeline-seed-{{ section.id }} .timeline-seed-container {
      padding-left: 16px;
      padding-right: 16px;
    }

    #timeline-seed-{{ section.id }} .timeline-seed-images {
      width: 100%;
      max-width: 100%;
    }

    #timeline-seed-{{ section.id }} .timeline-image-large,
    #timeline-seed-{{ section.id }} .timeline-image-large img {
      width: 100%;
      height: auto;
    }
  }
</style>

<script>
  (function () {
    function initTimelineSeed{{ section.id | replace: '-', '_' }}() {
      var section = document.getElementById('timeline-seed-{{ section.id }}');
      if (!section) return;

      var items = section.querySelectorAll('.timeline-milestone');
      if (!items.length) return;

      function updateItems() {
        var triggerPoint = window.innerHeight * ({{ section.settings.scroll_trigger_point }} / 100);

        items.forEach(function (item) {
          var rect = item.getBoundingClientRect();

          if (rect.top <= triggerPoint) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });

        {% if section.settings.first_item_active %}
          if (items[0]) {
            items[0].classList.add('active');
          }
        {% endif %}
      }

      updateItems();
      window.addEventListener('scroll', updateItems, { passive: true });
      window.addEventListener('resize', updateItems);
    }

    document.addEventListener('DOMContentLoaded', initTimelineSeed{{ section.id | replace: '-', '_' }});
    document.addEventListener('shopify:section:load', initTimelineSeed{{ section.id | replace: '-', '_' }});
    initTimelineSeed{{ section.id | replace: '-', '_' }}();
  })();
</script>

{% schema %}
{
  "name": "Timeline",
  "settings": [
    {
      "type": "header",
      "content": "Header text"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Benefits that <strong>build over time</strong></p>"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Herbans is designed for daily use, working with your body over time to support hair, urinary comfort, and overall wellness.*</p>"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Show image first on mobile",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_large",
      "label": "Large image"
    },
    {
      "type": "text",
      "id": "image_large_alt",
      "label": "Large image alt text"
    },
    {
      "type": "image_picker",
      "id": "image_circle",
      "label": "Circle image"
    },
