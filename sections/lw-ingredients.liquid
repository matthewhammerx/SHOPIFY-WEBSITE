<section class="lw lw-section" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px; --lw-bg: {{ section.settings.bg }}; --lw-fg: {{ section.settings.fg }}; --lw-hl: {{ section.settings.accent }}; --lw-accent: {{ section.settings.accent }};">
  <div class="lw-wrap">
    <div class="lw-head lw-center">
      <h2 class="lw-h lw-h--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lw-sub">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- assign ingr_slider = false -%}{%- if section.settings.mobile_slider or section.settings.desktop_slider -%}{%- assign ingr_slider = true -%}{%- endif -%}
    <div class="lw-ingr__wrap{% if ingr_slider %} lw-slider lw-ingr__slider{% endif %}{% if section.settings.desktop_slider %} lw-ingr__slider--desk{% endif %}{% if section.settings.mobile_slider == false %} lw-ingr__slider--no-m{% endif %}" {% if ingr_slider %}data-lw-slider{% endif %} style="--lw-col-m: 84%; --lw-gap: 14px;">
    <div class="lw-ingr__grid{% if ingr_slider %} lw-slider__track{% endif %}" style="--lw-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="lw-ingr lw-reveal" {{ block.shopify_attributes }}>
          <div class="lw-ingr__img">
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'lw-placeholder' }}{%- endif -%}
            {%- if block.settings.dose != blank -%}<span class="lw-ingr__dose">{{ block.settings.dose }}</span>{%- endif -%}
          </div>
          <div class="lw-ingr__name">{{ block.settings.name }}</div>
          <div class="lw-ingr__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if ingr_slider -%}
      <div class="lw-slider__nav lw-slider__nav--round"><div class="lw-slider__dots" hidden></div><div class="lw-slider__arrows">
        <button type="button" data-lw-prev aria-label="Previous">{% render 'lw-icon', icon: 'arrow-left' %}</button>
        <button type="button" data-lw-next aria-label="Next">{% render 'lw-icon', icon: 'arrow-right' %}</button>
      </div></div>
    {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="lw-center" style="margin-top: 36px;"><a class="lw-btn lw-btn--wide" href="{{ section.settings.button_link | default: '#lw-product' }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LW · Ingredients",
  "tag": "section",
  "class": "lw-section-ingredients",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "6 Active Ingredients <em>Doing Different Jobs</em>",
      "info": "Tip: make words italic to highlight them in the accent color."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "mobile_slider",
      "label": "Swipeable slider on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "desktop_slider",
      "label": "Carousel on desktop",
      "default": false,
      "info": "Shows 'Columns' cards at a time with arrows instead of a grid."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f8f5"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#111511"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent / highlighted words",
      "default": "#009370"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "dose",
          "label": "Dose badge",
          "default": "300mg"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Milk Thistle Extract"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LW · Ingredients",
      "blocks": [
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        }
      ]
    }
  ]
}
{% endschema %}
