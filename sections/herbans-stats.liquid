<section
  class="herbans-stats-{{ section.id }}"
  style="
    --hb-bg: {{ section.settings.background_color }};
    --hb-card: {{ section.settings.card_color }};
    --hb-yellow: {{ section.settings.accent_color }};
    --hb-text: {{ section.settings.text_color }};
    --hb-badge-text: {{ section.settings.badge_text_color }};
    --hb-note: {{ section.settings.note_color }};
  "
>
  <div class="hb-stats-outer">
    <div class="hb-stats-card">

      {% if section.settings.badge_text != blank %}
        <div class="hb-stats-badge">
          {{ section.settings.badge_text }}
        </div>
      {% endif %}

      <div class="hb-stats-grid">
        {% for block in section.blocks %}
          <div class="hb-stat" {{ block.shopify_attributes }}>

            {% if block.settings.show_squiggle %}
              <svg class="hb-squiggle" width="160" height="10" viewBox="0 0 160 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 6C32 3 55 5 78 5C101 5 123 3 156 5" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
              </svg>
            {% endif %}

            <div class="hb-stat-number">
              <span>{{ block.settings.number }}</span>
              {% if block.settings.suffix != blank %}
                <small>{{ block.settings.suffix }}</small>
              {% endif %}
            </div>

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}

          </div>
        {% endfor %}
      </div>

      {% if section.settings.note_text != blank %}
        <p class="hb-stats-note">
          {{ section.settings.note_text }}
        </p>
      {% endif %}

    </div>
  </div>
</section>

<style>
  .herbans-stats-{{ section.id }} {
    background: var(--hb-bg);
    padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px;
  }

  .herbans-stats-{{ section.id }} .hb-stats-outer {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  .herbans-stats-{{ section.id }} .hb-stats-card {
    position: relative;
    width: 100%;
    background: var(--hb-card);
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding_top }}px {{ section.settings.card_padding_side }}px {{ section.settings.card_padding_bottom }}px;
    box-shadow: {% if section.settings.show_shadow %}2px 4px 24px rgba(0, 0, 0, 0.25){% else %}none{% endif %};
  }

  .herbans-stats-{{ section.id }} .hb-stats-badge {
    position: absolute;
    top: -17px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--hb-yellow);
    color: var(--hb-badge-text);
    border-radius: 999px;
    padding: 8px 20px 7px;
    white-space: nowrap;
    z-index: 2;
    font-size: {{ section.settings.badge_size }}px;
    font-weight: {{ section.settings.badge_weight }};
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .herbans-stats-{{ section.id }} .hb-stats-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    column-gap: {{ section.settings.column_gap }}px;
    row-gap: {{ section.settings.row_gap }}px;
  }

  .herbans-stats-{{ section.id }} .hb-stat {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.stat_gap }}px;
  }

  .herbans-stats-{{ section.id }} .hb-squiggle {
    width: {{ section.settings.squiggle_width }}px;
    height: auto;
    color: var(--hb-yellow);
    margin-bottom: 2px;
  }

  .herbans-stats-{{ section.id }} .hb-stat-number {
    color: var(--hb-text);
    display: flex;
    align-items: flex-end;
    gap: 5px;
    line-height: 1.05;
    letter-spacing: -0.05em;
    font-weight: {{ section.settings.number_weight }};
  }

  .herbans-stats-{{ section.id }} .hb-stat-number span {
    font-size: {{ section.settings.number_size }}px;
    line-height: 1;
    font-weight: {{ section.settings.number_weight }};
  }

  .herbans-stats-{{ section.id }} .hb-stat-number small {
    font-size: {{ section.settings.suffix_size }}px;
    line-height: 1;
    font-weight: {{ section.settings.number_weight }};
    margin-bottom: 5px;
  }

  .herbans-stats-{{ section.id }} .hb-stat p {
    color: var(--hb-text);
    font-size: {{ section.settings.text_size }}px;
    line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
    font-weight: {{ section.settings.text_weight }};
    margin: 0;
    max-width: {{ section.settings.text_max_width }}px;
    letter-spacing: -0.02em;
  }

  .herbans-stats-{{ section.id }} .hb-stats-note {
    color: var(--hb-note);
    text-align: center;
    font-size: {{ section.settings.note_size }}px;
    line-height: {{ section.settings.note_line_height | divided_by: 100.0 }};
    font-weight: {{ section.settings.note_weight }};
    margin: {{ section.settings.note_margin_top }}px 0 0;
    letter-spacing: -0.03em;
  }

  @media screen and (max-width: 768px) {
    .herbans-stats-{{ section.id }} {
      padding: {{ section.settings.mobile_section_padding_top }}px 16px {{ section.settings.mobile_section_padding_bottom }}px;
    }

    .herbans-stats-{{ section.id }} .hb-stats-card {
      border-radius: {{ section.settings.mobile_card_radius }}px;
      padding: {{ section.settings.mobile_card_padding_top }}px {{ section.settings.mobile_card_padding_side }}px {{ section.settings.mobile_card_padding_bottom }}px;
    }

    .herbans-stats-{{ section.id }} .hb-stats-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      column-gap: {{ section.settings.mobile_column_gap }}px;
      row-gap: {{ section.settings.mobile_row_gap }}px;
    }

    .herbans-stats-{{ section.id }} .hb-stats-badge {
      font-size: {{ section.settings.mobile_badge_size }}px;
      padding: 7px 14px 6px;
    }

    .herbans-stats-{{ section.id }} .hb-stat {
      gap: {{ section.settings.mobile_stat_gap }}px;
    }

    .herbans-stats-{{ section.id }} .hb-squiggle {
      width: {{ section.settings.mobile_squiggle_width }}px;
    }

    .herbans-stats-{{ section.id }} .hb-stat-number span {
      font-size: {{ section.settings.mobile_number_size }}px;
    }

    .herbans-stats-{{ section.id }} .hb-stat-number small {
      font-size: {{ section.settings.mobile_suffix_size }}px;
      margin-bottom: 3px;
    }

    .herbans-stats-{{ section.id }} .hb-stat p {
      font-size: {{ section.settings.mobile_text_size }}px;
      max-width: {{ section.settings.mobile_text_max_width }}px;
    }

    .herbans-stats-{{ section.id }} .hb-stats-note {
      font-size: {{ section.settings.mobile_note_size }}px;
      margin-top: {{ section.settings.mobile_note_margin_top }}px;
    }
  }
</style>

