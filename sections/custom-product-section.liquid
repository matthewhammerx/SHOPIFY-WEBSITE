{% comment %}
  Custom Product Section
  File name: custom-product-section.liquid
{% endcomment %}

{% assign v = product.selected_or_first_available_variant %}
{% assign sp = section.settings.spid %}

{% if sp == blank and product.selling_plan_groups.size > 0 %}
  {% assign sp = product.selling_plan_groups.first.selling_plans.first.id %}
{% endif %}

<section id="custom-product-{{ section.id }}" class="cps">
  <div class="cps-wrap">

    {% if section.settings.show_eyebrow %}
      <div class="cps-top-badge">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    <div class="cps-main-grid">

      <div class="cps-gallery-col {% if section.settings.sticky_gal %}cps-sticky{% endif %}">
        <div class="cps-gallery cps-thumb-{{ section.settings.thumb_pos }}">
          <div class="cps-g-main">
            <div class="cps-g-track" data-cps-track>
              {% assign g_count = 0 %}

              {% if section.settings.src == 'product' and product.media.size > 0 %}
                {% for media in product.media %}
                  {% if media.media_type == 'image' %}
                    <div class="cps-g-slide" data-cps-slide>
                      <img
                        src="{{ media.preview_image | image_url: width: 1400 }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        loading="{% if g_count == 0 %}eager{% else %}lazy{% endif %}"
                      >
                    </div>
                    {% assign g_count = g_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% else %}
                {% for block in section.blocks %}
                  {% if block.type == 'img' %}
                    <div class="cps-g-slide" data-cps-slide {{ block.shopify_attributes }}>
                      {% if block.settings.d_img != blank %}
                        <picture>
                          {% if block.settings.m_img != blank %}
                            <source media="(max-width: 749px)" srcset="{{ block.settings.m_img | image_url: width: 900 }}">
                          {% endif %}
                          <img
                            src="{{ block.settings.d_img | image_url: width: 1400 }}"
                            alt="{{ block.settings.alt | default: block.settings.d_img.alt | escape }}"
                            loading="{% if g_count == 0 %}eager{% else %}lazy{% endif %}"
                          >
                        </picture>
                      {% elsif product.featured_image != blank %}
                        <img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.title | escape }}">
                      {% else %}
                        <div class="cps-placeholder">
                          {{ 'product-1' | placeholder_svg_tag }}
                        </div>
                      {% endif %}

                      {% if block.settings.badge != blank %}
                        <div class="cps-img-badge">{{ block.settings.badge }}</div>
                      {% endif %}
                    </div>
                    {% assign g_count = g_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              {% if g_count == 0 %}
                <div class="cps-g-slide" data-cps-slide>
                  {% if product.featured_image != blank %}
                    <img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.title | escape }}">
                  {% else %}
                    <div class="cps-placeholder">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            {% if section.settings.show_arrow %}
              <button type="button" class="cps-arrow cps-prev" data-cps-prev aria-label="Previous image">‹</button>
              <button type="button" class="cps-arrow cps-next" data-cps-next aria-label="Next image">›</button>
            {% endif %}
          </div>

          {% if section.settings.show_thumb %}
            <div class="cps-thumbs" data-cps-thumbs>
              {% assign t_count = 0 %}

              {% if section.settings.src == 'product' and product.media.size > 0 %}
                {% for media in product.media %}
                  {% if media.media_type == 'image' %}
                    <button type="button" class="cps-thumb {% if t_count == 0 %}active{% endif %}" data-cps-thumb="{{ t_count }}">
                      <img src="{{ media.preview_image | image_url: width: 180 }}" alt="{{ media.alt | default: product.title | escape }}">
                    </button>
                    {% assign t_count = t_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% else %}
                {% for block in section.blocks %}
                  {% if block.type == 'img' %}
                    <button type="button" class="cps-thumb {% if t_count == 0 %}active{% endif %}" data-cps-thumb="{{ t_count }}">
                      {% if block.settings.thumb != blank %}
                        <img src="{{ block.settings.thumb | image_url: width: 180 }}" alt="{{ block.settings.alt | escape }}">
                      {% elsif block.settings.d_img != blank %}
                        <img src="{{ block.settings.d_img | image_url: width: 180 }}" alt="{{ block.settings.alt | default: block.settings.d_img.alt | escape }}">
                      {% elsif product.featured_image != blank %}
                        <img src="{{ product.featured_image | image_url: width: 180 }}" alt="{{ product.title | escape }}">
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {% endif %}
                    </button>
                    {% assign t_count = t_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="cps-info-col">
        {% if section.settings.review_txt != blank %}
          <a class="cps-reviews" href="{{ section.settings.review_link | default: '#reviews' }}">
            <span class="cps-stars">★★★★★</span>
            <span>{{ section.settings.review_txt }}</span>
          </a>
        {% endif %}

        {% if section.settings.head != blank %}
          <h1 class="cps-title">{{ section.settings.head }}</h1>
        {% endif %}

        {% if section.settings.desc != blank %}
          <div class="cps-desc">{{ section.settings.desc }}</div>
        {% endif %}

        <form method="post" action="/cart/add" class="cps-form" data-cps-form>
          <input type="hidden" name="id" value="{{ v.id }}" data-cps-var>
          <input type="hidden" name="quantity" value="{{ section.settings.def_qty }}" data-cps-qty>
          <input type="hidden" name="selling_plan" value="{{ sp }}" data-cps-plan>

          {% if section.settings.show_vars and product.has_only_default_variant == false %}
            <div class="cps-block cps-variants">
              {% for option in product.options_with_values %}
                {% assign opt_i = option.position | minus: 1 %}
                <div class="cps-opt-group">
                  <div class="cps-label">
                    {{ option.name }}:
                    <span data-cps-opt-title="{{ opt_i }}">{{ option.selected_value }}</span>
                  </div>

                  <div class="cps-opt-values">
                    {% for value in option.values %}
                      <button
                        type="button"
                        class="cps-opt-btn {% if option.selected_value == value %}active{% endif %}"
                        data-cps-opt
                        data-opt-index="{{ opt_i }}"
                        data-opt-value="{{ value | escape }}"
                      >
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.show_qty %}
            <div class="cps-block cps-qty-block">
              <div class="cps-label-row">
                <div class="cps-label">{{ section.settings.qty_label }}</div>
                {% if section.settings.qty_note != blank %}
                  <div class="cps-qty-note">{{ section.settings.qty_note }}</div>
                {% endif %}
              </div>

              <div class="cps-qty-pills">
                <button type="button" class="cps-qty-btn {% if section.settings.def_qty == '1' %}active{% endif %}" data-cps-q="1">1</button>
                <button type="button" class="cps-qty-btn {% if section.settings.def_qty == '2' %}active{% endif %}" data-cps-q="2">2</button>
              </div>
            </div>
          {% endif %}

          <div class="cps-block cps-offers">
            <div class="cps-label">{{ section.settings.offer_label }}</div>

            <button type="button" class="cps-offer-card {% if section.settings.default_offer == 'sub' %}active{% endif %}" data-cps-plan-btn="sub">
              {% if section.settings.sub_top != blank %}
                <div class="cps-offer-top">{{ section.settings.sub_top }}</div>
              {% endif %}

              <div class="cps-offer-inner">
                <div class="cps-radio"></div>

                <div class="cps-offer-left">
                  <div class="cps-offer-title">{{ section.settings.sub_title }}</div>
                  <div class="cps-offer-note">{{ section.settings.sub_note }}</div>

                  <ul class="cps-offer-benefits">
                    {% if section.settings.sub_ben1 != blank %}
                      <li>✓ {{ section.settings.sub_ben1 }}</li>
                    {% endif %}
                    {% if section.settings.sub_ben2 != blank %}
                      <li>✓ {{ section.settings.sub_ben2 }}</li>
                    {% endif %}
                    {% if section.settings.sub_ben3 != blank %}
                      <li>✓ {{ section.settings.sub_ben3 }}</li>
                    {% endif %}
                  </ul>
                </div>

                <div class="cps-offer-price">
                  <div>
                    <strong>{{ section.settings.sub_price }}</strong>
                    {% if section.settings.sub_cmp != blank %}
                      <s>{{ section.settings.sub_cmp }}</s>
                    {% endif %}
                  </div>
                  {% if section.settings.sub_day != blank %}
                    <small>{{ section.settings.sub_day }}</small>
                  {% endif %}
                </div>
              </div>
            </button>

            <button type="button" class="cps-offer-card {% if section.settings.default_offer == 'otp' %}active{% endif %}" data-cps-plan-btn="otp">
              <div class="cps-offer-inner">
                <div class="cps-radio"></div>

                <div class="cps-offer-left">
                  <div class="cps-offer-title">{{ section.settings.otp_title }}</div>
                  <div class="cps-offer-note">{{ section.settings.otp_note }}</div>
                </div>

                <div class="cps-offer-price">
                  <div>
                    <strong>{{ section.settings.otp_price }}</strong>
                    {% if section.settings.otp_cmp != blank %}
                      <s>{{ section.settings.otp_cmp }}</s>
                    {% endif %}
                  </div>
                  {% if section.settings.otp_day != blank %}
                    <small>{{ section.settings.otp_day }}</small>
                  {% endif %}
                </div>
              </div>
            </button>
          </div>

          <button type="submit" class="cps-atc" data-cps-atc>
            {{ section.settings.cta_text }}
          </button>

          {% if section.settings.show_disc and section.settings.disc_txt != blank %}
            <div class="cps-discount">
              {{ section.settings.disc_txt }}
            </div>
          {% endif %}
        </form>

        {% if section.settings.show_trust %}
          <div class="cps-trust-row">
            <div class="cps-trust-item">
              <div class="cps-trust-icon">{{ section.settings.trust1_icon }}</div>
              <div>{{ section.settings.trust1_txt }}</div>
            </div>
            <div class="cps-trust-item">
              <div class="cps-trust-icon">{{ section.settings.trust2_icon }}</div>
              <div>{{ section.settings.trust2_txt }}</div>
            </div>
            <div class="cps-trust-item">
              <div class="cps-trust-icon">{{ section.settings.trust3_icon }}</div>
              <div>{{ section.settings.trust3_txt }}</div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.pack_show %}
      <div class="cps-packed">
        {% if section.settings.pack_head != blank %}
          <h2>{{ section.settings.pack_head }}</h2>
        {% endif %}

        {% if section.settings.pack_sub != blank %}
          <p class="cps-pack-sub">{{ section.settings.pack_sub }}</p>
        {% endif %}

        <div class="cps-ing-grid">
          {% for block in section.blocks %}
            {% if block.type == 'ing' %}
              <div class="cps-ing-item" {{ block.shopify_attributes }}>
                <div class="cps-ing-icon">
                  {% if block.settings.ing_img != blank %}
                    <img src="{{ block.settings.ing_img | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}">
                  {% else %}
                    <span>{{ block.settings.emoji }}</span>
                  {% endif %}
                </div>

                <div>
                  <div class="cps-ing-title">{{ block.settings.title }}</div>
                  {% if block.settings.text != blank %}
                    <div class="cps-ing-text">{{ block.settings.text }}</div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.faq_show %}
      <div class="cps-faq">
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <details class="cps-faq-item" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.q }}</span>
                <span class="cps-plus">+</span>
              </summary>
              <div class="cps-faq-answer">
                {{ block.settings.a }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>

  <script type="application/json" data-cps-vars>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "options": {{ variant.options | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</section>

<style>
  #custom-product-{{ section.id }} {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_col }};
    padding-top: {{ section.settings.pad_top }}px;
    padding-bottom: {{ section.settings.pad_bot }}px;
  }

  #custom-product-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-product-{{ section.id }} .cps-wrap {
    max-width: {{ section.settings.maxw }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #custom-product-{{ section.id }} .cps-top-badge {
    width: fit-content;
    margin: 0 auto 28px;
    background: {{ section.settings.eyebrow_bg }};
    color: {{ section.settings.eyebrow_col }};
    padding: 10px 28px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 15px;
    text-align: center;
  }

  #custom-product-{{ section.id }} .cps-main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 470px;
    gap: {{ section.settings.gap }}px;
    align-items: start;
  }

  #custom-product-{{ section.id }} .cps-sticky {
    position: sticky;
    top: 20px;
  }

  #custom-product-{{ section.id }} .cps-gallery {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  #custom-product-{{ section.id }} .cps-g-main {
    position: relative;
    overflow: hidden;
    border: {{ section.settings.border_w }}px solid {{ section.settings.border_col }};
    border-radius: {{ section.settings.rad }}px;
    background: {{ section.settings.img_bg }};
    aspect-ratio: {{ section.settings.ratio }};
  }

  #custom-product-{{ section.id }} .cps-g-track {
    display: flex;
    height: 100%;
    transition: transform .32s ease;
  }

  #custom-product-{{ section.id }} .cps-g-slide {
    min-width: 100%;
    height: 100%;
    position: relative;
  }

  #custom-product-{{ section.id }} .cps-g-slide img,
  #custom-product-{{ section.id }} .cps-g-slide picture {
    width: 100%;
    height: 100%;
    display: block;
  }

  #custom-product-{{ section.id }} .cps-g-slide img {
    object-fit: {{ section.settings.fit }};
    object-position: center;
  }

  #custom-product-{{ section.id }} .cps-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f6f6f6;
  }

  #custom-product-{{ section.id }} .cps-placeholder svg {
    width: 60%;
    height: 60%;
  }

  #custom-product-{{ section.id }} .cps-img-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: {{ section.settings.eyebrow_bg }};
    color: {{ section.settings.eyebrow_col }};
    padding: 7px 13px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
  }

  #custom-product-{{ section.id }} .cps-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #000;
    background: rgba(255,255,255,.8);
    color: #001f10;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }

  #custom-product-{{ section.id }} .cps-prev {
    left: 12px;
  }

  #custom-product-{{ section.id }} .cps-next {
    right: 12px;
  }

  #custom-product-{{ section.id }} .cps-thumbs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  #custom-product-{{ section.id }} .cps-thumbs::-webkit-scrollbar {
    display: none;
  }

  #custom-product-{{ section.id }} .cps-thumb {
    width: {{ section.settings.thumb_size }}px;
    height: {{ section.settings.thumb_size }}px;
    min-width: {{ section.settings.thumb_size }}px;
    border: 1px solid {{ section.settings.thumb_col }};
    border-radius: {{ section.settings.thumb_rad }}px;
    background: {{ section.settings.thumb_bg }};
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    opacity: .5;
    transition: .2s ease;
  }

  #custom-product-{{ section.id }} .cps-thumb.active,
  #custom-product-{{ section.id }} .cps-thumb:hover {
    opacity: 1;
    border-color: {{ section.settings.thumb_active }};
  }

  #custom-product-{{ section.id }} .cps-thumb img,
  #custom-product-{{ section.id }} .cps-thumb svg {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.thumb_fit }};
    display: block;
  }

  @media screen and (min-width: 990px) {
    #custom-product-{{ section.id }} .cps-thumb-left {
      display: grid;
      grid-template-columns: {{ section.settings.thumb_size }}px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
    }

    #custom-product-{{ section.id }} .cps-thumb-left .cps-thumbs {
      grid-column: 1;
      grid-row: 1;
      flex-direction: column;
      overflow-y: auto;
      overflow-x: hidden;
      max-height: 690px;
    }

    #custom-product-{{ section.id }} .cps-thumb-left .cps-g-main {
      grid-column: 2;
      grid-row: 1;
    }

    #custom-product-{{ section.id }} .cps-thumb-right {
      display: grid;
      grid-template-columns: minmax(0, 1fr) {{ section.settings.thumb_size }}px;
      gap: 14px;
      align-items: start;
    }

    #custom-product-{{ section.id }} .cps-thumb-right .cps-g-main {
      grid-column: 1;
      grid-row: 1;
    }

    #custom-product-{{ section.id }} .cps-thumb-right .cps-thumbs {
      grid-column: 2;
      grid-row: 1;
      flex-direction: column;
      overflow-y: auto;
      overflow-x: hidden;
      max-height: 690px;
    }
  }

  #custom-product-{{ section.id }} .cps-reviews {
    display: flex;
    align-items: center;
    gap: 10px;
    color: {{ section.settings.text_col }};
    text-decoration: underline;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  #custom-product-{{ section.id }} .cps-stars {
    color: {{ section.settings.star_col }};
    letter-spacing: 1px;
  }

  #custom-product-{{ section.id }} .cps-title {
    margin: 0 0 10px;
    color: {{ section.settings.head_col }};
    font-size: 31px;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  #custom-product-{{ section.id }} .cps-desc {
    font-size: 17px;
    line-height: 1.35;
    font-weight: 600;
    margin-bottom: 18px;
    padding-bottom: 16px;
    border-bottom: 1px solid #111;
  }

  #custom-product-{{ section.id }} .cps-desc p {
    margin: 0;
  }

  #custom-product-{{ section.id }} .cps-block {
    border-top: 1px solid #111;
    padding-top: 22px;
    margin-top: 22px;
  }

  #custom-product-{{ section.id }} .cps-label,
  #custom-product-{{ section.id }} .cps-label-row {
    font-size: 15px;
    font-weight: 900;
    margin-bottom: 12px;
  }

  #custom-product-{{ section.id }} .cps-label-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #custom-product-{{ section.id }} .cps-qty-note {
    font-size: 13px;
    color: #777;
    border: 1px dashed #aaa;
    border-radius: 4px;
    padding: 3px 9px;
    font-weight: 600;
  }

  #custom-product-{{ section.id }} .cps-opt-values,
  #custom-product-{{ section.id }} .cps-qty-pills {
    display: flex;
    gap: 12px;
  }

  #custom-product-{{ section.id }} .cps-opt-group + .cps-opt-group {
    margin-top: 14px;
  }

  #custom-product-{{ section.id }} .cps-opt-btn,
  #custom-product-{{ section.id }} .cps-qty-btn {
    flex: 1;
    border: 1px solid #111;
    background: #fff;
    color: #000;
    border-radius: 8px;
    min-height: 42px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  #custom-product-{{ section.id }} .cps-opt-btn.active,
  #custom-product-{{ section.id }} .cps-qty-btn.active {
    background: #daece3;
    font-weight: 900;
  }

  #custom-product-{{ section.id }} .cps-offers {
    border-top: none;
    margin-top: 24px;
    padding-top: 0;
  }

  #custom-product-{{ section.id }} .cps-offer-card {
    position: relative;
    width: 100%;
    display: block;
    text-align: left;
    border: 1px solid #111;
    background: #fff;
    border-radius: 8px;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    margin-bottom: 14px;
    color: #000;
  }

  #custom-product-{{ section.id }} .cps-offer-card.active {
    background: #daece3;
    border-color: #006b36;
  }

  #custom-product-{{ section.id }} .cps-offer-top {
    background: #006b36;
    color: #ffcf2e;
    text-align: center;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    padding: 6px;
  }

  #custom-product-{{ section.id }} .cps-offer-inner {
    display: flex;
    gap: 12px;
    padding: 14px;
  }

  #custom-product-{{ section.id }} .cps-radio {
    width: 18px;
    height: 18px;
    border: 1.5px solid #111;
    border-radius: 50%;
    margin-top: 2px;
    position: relative;
    flex: 0 0 auto;
  }

  #custom-product-{{ section.id }} .cps-offer-card.active .cps-radio:after {
    content: "";
    width: 10px;
    height: 10px;
    background: #006b36;
    border-radius: 50%;
    position: absolute;
    inset: 3px;
  }

  #custom-product-{{ section.id }} .cps-offer-left {
    flex: 1;
  }

  #custom-product-{{ section.id }} .cps-offer-title {
    font-size: 19px;
    line-height: 1.15;
    font-weight: 900;
  }

  #custom-product-{{ section.id }} .cps-offer-note {
    font-size: 14px;
    margin-top: 3px;
  }

  #custom-product-{{ section.id }} .cps-offer-benefits {
    list-style: none;
    padding: 12px 0 0;
    margin: 0;
