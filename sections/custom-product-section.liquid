<script>
  (() => {
    const section = document.querySelector('#custom-product-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('[data-cps-track]');
    const slides = Array.from(section.querySelectorAll('[data-cps-slide]'));
    const thumbs = Array.from(section.querySelectorAll('[data-cps-thumb]'));
    const prev = section.querySelector('[data-cps-prev]');
    const next = section.querySelector('[data-cps-next]');
    let current = 0;

    function goTo(i) {
      if (!track || !slides.length) return;
      current = (i + slides.length) % slides.length;
      track.style.transform = `translateX(-${current * 100}%)`;
      thumbs.forEach((t, index) => t.classList.toggle('active', index === current));
    }

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => goTo(Number(thumb.dataset.cpsThumb)));
    });

    if (prev) prev.addEventListener('click', () => goTo(current - 1));
    if (next) next.addEventListener('click', () => goTo(current + 1));

    let startX = 0;
    let endX = 0;

    if (track) {
      track.addEventListener('touchstart', e => {
        startX = e.touches[0].clientX;
      }, { passive: true });

      track.addEventListener('touchmove', e => {
        endX = e.touches[0].clientX;
      }, { passive: true });

      track.addEventListener('touchend', () => {
        const diff = startX - endX;
        if (Math.abs(diff) > 45) {
          if (diff > 0) goTo(current + 1);
          else goTo(current - 1);
        }
      });
    }

    const form = section.querySelector('[data-cps-form]');
    const varInput = section.querySelector('[data-cps-var]');
    const qtyInput = section.querySelector('[data-cps-qty]');
    const planInput = section.querySelector('[data-cps-plan]');
    const atc = section.querySelector('[data-cps-atc]');
    const planBtns = Array.from(section.querySelectorAll('[data-cps-plan-btn]'));
    const qtyBtns = Array.from(section.querySelectorAll('[data-cps-q]'));
    const optBtns = Array.from(section.querySelectorAll('[data-cps-opt]'));
    const varsEl = section.querySelector('[data-cps-vars]');
    const spid = "{{ sp }}";

    let variants = [];

    try {
      variants = varsEl ? JSON.parse(varsEl.textContent) : [];
    } catch(e) {
      variants = [];
    }

    function setPlan(type) {
      planBtns.forEach(btn => {
        btn.classList.toggle('active', btn.dataset.cpsPlanBtn === type);
      });

      if (!planInput) return;

      if (type === 'sub' && spid && spid !== 'null' && spid !== '') {
        planInput.disabled = false;
        planInput.value = spid;
      } else {
        planInput.value = '';
        planInput.disabled = true;
      }
    }

    planBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        setPlan(btn.dataset.cpsPlanBtn);
      });
    });

    setPlan("{{ section.settings.default_offer }}");

    qtyBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        qtyBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (qtyInput) {
          qtyInput.value = btn.dataset.cpsQ;
        }
      });
    });

    function updateVariant() {
      if (!variants.length || !optBtns.length) return;

      const selected = [];

      optBtns.forEach(btn => {
        if (btn.classList.contains('active')) {
          selected[Number(btn.dataset.optIndex)] = btn.dataset.optValue;
        }
      });

      const matched = variants.find(v => {
        return JSON.stringify(v.options) === JSON.stringify(selected);
      });

      if (!matched) return;

      if (varInput) {
        varInput.value = matched.id;
      }

      if (atc) {
        atc.disabled = !matched.available;
        atc.textContent = matched.available ? "{{ section.settings.cta_text | escape }}" : "Sold Out";
      }
    }

    optBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const index = btn.dataset.optIndex;

        optBtns.forEach(b => {
          if (b.dataset.optIndex === index) {
            b.classList.remove('active');
          }
        });

        btn.classList.add('active');

        const label = section.querySelector(`[data-cps-opt-title="${index}"]`);
        if (label) {
          label.textContent = btn.dataset.optValue;
        }

        updateVariant();
      });
    });

    if (form && atc) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const variantId = varInput ? varInput.value : '';
        const qty = qtyInput ? qtyInput.value : '1';
        const sellingPlan = planInput && !planInput.disabled ? planInput.value : '';

        if (!variantId) {
          alert('Variant missing. Make sure this section is on a product page.');
          return;
        }

        const originalText = atc.textContent;

        atc.disabled = true;
        atc.textContent = 'Adding...';

        const payload = {
          id: Number(variantId),
          quantity: Number(qty || 1)
        };

        if (sellingPlan) {
          payload.selling_plan = Number(sellingPlan);
        }

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (!res.ok) {
            const error = await res.json();
            throw new Error(error.description || 'Could not add to cart.');
          }

          atc.textContent = 'Added ✓';

          document.dispatchEvent(new CustomEvent('cart:refresh'));
          document.dispatchEvent(new CustomEvent('cart:updated'));
          document.dispatchEvent(new CustomEvent('cart:open'));
          window.dispatchEvent(new CustomEvent('cart:refresh'));
          window.dispatchEvent(new CustomEvent('cart:updated'));
          window.dispatchEvent(new CustomEvent('cart:open'));

          setTimeout(() => {
            atc.disabled = false;
            atc.textContent = originalText;
          }, 1200);

        } catch (err) {
          alert(err.message || 'Something went wrong.');
          atc.disabled = false;
          atc.textContent = originalText;
        }
      });
    }

    updateVariant();
    goTo(0);
  })();
</script>

