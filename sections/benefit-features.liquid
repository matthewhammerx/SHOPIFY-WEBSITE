<style>
  .bf-feature {
    background: var(--bf-bg);
    color: var(--bf-ink);
  }

  .bf-feature__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--bf-padding, 32px) 24px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .bf-feature__media {
    width: 100%;
    aspect-ratio: var(--bf-media-ratio, 4 / 5);
    overflow: hidden;
    border-radius: var(--bf-image-radius, 0px);
    background: rgba(0, 0, 0, 0.04);
  }
  .bf-feature__media img,
  .bf-feature__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bf-feature__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .bf-feature__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bf-feature__title {
    margin: 0;
    font-size: 26px;
    line-height: 1.2;
    font-weight: 800;
    color: var(--bf-heading);
    text-wrap: balance;
  }

  .bf-feature__desc {
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.55;
  }
  .bf-feature__desc p {
    margin: 0;
  }

  .bf-badges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  .bf-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--bf-badge-bg, #1e3d2c);
    color: var(--bf-badge-text, #fff);
    border-radius: 999px;
    padding: 10px 18px;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
  }
  .bf-badge__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--bf-badge-text, #fff);
  }
  .bf-badge__icon svg,
  .bf-badge__icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .bf-badges--scroll {
    display: block;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);
  }
  .bf-badges__track {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    gap: 12px;
    animation: bf-scroll var(--bf-scroll-duration, 25s) linear infinite;
  }
  .bf-badges--scroll .bf-badge {
    white-space: nowrap;
  }
  @keyframes bf-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bf-badges__track {
      animation: none;
    }
  }

  .bf-feature__secondary {
    width: 100%;
    aspect-ratio: var(--bf-secondary-ratio, 4 / 3);
    overflow: hidden;
    border-radius: var(--bf-image-radius, 0px);
  }
  .bf-feature__secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bf-secondary--mobile-only {
    display: block;
  }
  .bf-secondary--desktop-only {
    display: none;
  }

  @media (min-width: 860px) {
    .bf-feature__inner {
      flex-direction: var(--bf-media-direction, row);
      align-items: center;
      gap: 56px;
      padding: var(--bf-padding, 56px) 40px;
    }
    .bf-feature__media {
      flex: 0 0 var(--bf-media-width, 44%);
    }
    .bf-feature__text {
      flex: 1 1 0%;
    }
    .bf-feature__title {
      font-size: 34px;
    }
    .bf-feature__secondary {
      flex-basis: 100%;
    }
    .bf-secondary--mobile-only {
      display: none;
    }
    .bf-secondary--desktop-only {
      display: block;
    }
  }
</style>

{%- case section.settings.media_ratio -%}
  {%- when 'square' -%}{%- assign media_ratio = '1 / 1' -%}
  {%- when 'portrait' -%}{%- assign media_ratio = '4 / 5' -%}
  {%- when 'landscape' -%}{%- assign media_ratio = '4 / 3' -%}
  {%- when 'wide' -%}{%- assign media_ratio = '16 / 9' -%}
  {%- when 'original' -%}
    {%- if section.settings.video_poster != blank -%}
      {%- assign media_ratio = section.settings.video_poster.aspect_ratio | append: ' / 1' -%}
    {%- else -%}
      {%- assign media_ratio = '4 / 5' -%}
    {%- endif -%}
  {%- else -%}
    {%- assign media_ratio = '4 / 5' -%}
{%- endcase -%}

{%- case section.settings.secondary_ratio -%}
  {%- when 'square' -%}{%- assign secondary_ratio = '1 / 1' -%}
  {%- when 'portrait' -%}{%- assign secondary_ratio = '4 / 5' -%}
  {%- when 'wide' -%}{%- assign secondary_ratio = '16 / 9' -%}
  {%- when 'original' -%}
    {%- if section.settings.secondary_image != blank -%}
      {%- assign secondary_ratio = section.settings.secondary_image.aspect_ratio | append: ' / 1' -%}
    {%- else -%}
      {%- assign secondary_ratio = '4 / 3' -%}
    {%- endif -%}
  {%- else -%}
    {%- assign secondary_ratio = '4 / 3' -%}
{%- endcase -%}

{%- if section.settings.media_position == 'right' -%}
  {%- assign media_direction = 'row-reverse' -%}
{%- else -%}
  {%- assign media_direction = 'row' -%}
{%- endif -%}

{%- case section.settings.secondary_visibility -%}
  {%- when 'mobile_only' -%}{%- assign secondary_class = 'bf-secondary--mobile-only' -%}
  {%- when 'desktop_only' -%}{%- assign secondary_class = 'bf-secondary--desktop-only' -%}
  {%- else -%}{%- assign secondary_class = '' -%}
{%- endcase -%}

<section class="bf-feature" style="
  --bf-bg: {{ section.settings.bg_color }};
  --bf-heading: {{ section.settings.heading_color }};
  --bf-ink: {{ section.settings.text_color }};
  --bf-badge-bg: {{ section.settings.badge_bg }};
  --bf-badge-text: {{ section.settings.badge_text }};
  --bf-padding: {{ section.settings.section_padding }}px;
  --bf-media-ratio: {{ media_ratio }};
  --bf-secondary-ratio: {{ secondary_ratio }};
  --bf-media-direction: {{ media_direction }};
  --bf-scroll-duration: {{ section.settings.scroll_speed }}s;
  --bf-image-radius: {{ section.settings.image_radius }}px;
  --bf-media-width: {{ section.settings.media_width }}%;
">
  <div class="bf-feature__inner">

    <div class="bf-feature__media">
      {%- if section.settings.video != null -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'bf-feature__video' }}
      {%- elsif section.settings.video_poster != blank -%}
        <img
          src="{{ section.settings.video_poster | image_url: width: 1200 }}"
          srcset="{{ section.settings.video_poster | image_url: width: 600 }} 600w, {{ section.settings.video_poster | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 860px) 50vw, 100vw"
          alt="{{ section.settings.video_poster.alt | default: section.settings.heading | escape }}"
          loading="eager"
          width="{{ section.settings.video_poster.width }}"
          height="{{ section.settings.video_poster.height }}"
        >
      {%- else -%}
        <div class="bf-feature__placeholder">
          {{ 'image' | placeholder_svg_tag: 'bf-feature__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div class="bf-feature__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="bf-feature__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="bf-feature__desc">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- if section.settings.enable_scroll -%}
          <div class="bf-badges bf-badges--scroll">
            <div class="bf-badges__track">
              {%- for i in (1..2) -%}
                {%- for block in section.blocks -%}
                  <div class="bf-badge" {{ block.shopify_attributes }}>
                    <span class="bf-badge__icon">
                      {%- if block.settings.icon != blank -%}
                        <img src="{{ block.settings.icon | image_url: width: 36 }}" alt="" loading="lazy" width="18" height="18">
                      {%- else -%}
                        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- endif -%}
                    </span>
                    <span class="bf-badge__label">{{ block.settings.label }}</span>
                  </div>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div class="bf-badges">
            {%- for block in section.blocks -%}
              <div class="bf-badge" {{ block.shopify_attributes }}>
                <span class="bf-badge__icon">
                  {%- if block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | image_url: width: 36 }}" alt="" loading="lazy" width="18" height="18">
                  {%- else -%}
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- endif -%}
                </span>
                <span class="bf-badge__label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if section.settings.secondary_image != blank -%}
      <div class="bf-feature__secondary {{ secondary_class }}">
        <img
          src="{{ section.settings.secondary_image | image_url: width: 1200 }}"
          srcset="{{ section.settings.secondary_image | image_url: width: 600 }} 600w, {{ section.settings.secondary_image | image_url: width: 1200 }} 1200w, {{ section.settings.secondary_image | image_url: width: 1800 }} 1800w"
          sizes="100vw"
          alt="{{ section.settings.secondary_image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.secondary_image.width }}"
          height="{{ section.settings.secondary_image.height }}"
        >
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Benefit feature",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "1. Complete Joint Support in a Daily Soft Chew"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Wuffes delivers every major hip & joint benefit your senior dog needs - for easier movement and comfortable daily activity.</p>"
    },
    {
      "type": "header",
      "content": "Primary media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional. If left empty, the poster image below is shown instead."
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Poster / fallback image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Vertical (portrait)" },
        { "value": "landscape", "label": "Horizontal (landscape)" },
        { "value": "wide", "label": "Wide" },
        { "value": "original", "label": "Original image proportions" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Media width (desktop)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 44
    },
    {
      "type": "header",
      "content": "Secondary image"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary image",
      "info": "Optional extra image. On mobile it stacks below the badges; use the visibility setting to control where it shows."
    },
    {
      "type": "select",
      "id": "secondary_ratio",
      "label": "Secondary image shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Vertical (portrait)" },
        { "value": "landscape", "label": "Horizontal (landscape)" },
        { "value": "wide", "label": "Wide" },
        { "value": "original", "label": "Original image proportions" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "secondary_visibility",
      "label": "Show secondary image on",
      "options": [
        { "value": "both", "label": "Mobile and desktop" },
        { "value": "mobile_only", "label": "Mobile only" },
        { "value": "desktop_only", "label": "Desktop only" }
      ],
      "default": "mobile_only"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Applies to both the primary media and the secondary image."
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll",
      "label": "Auto-scroll badges",
      "default": false,
      "info": "Turns the badge list into a continuously scrolling strip instead of a static grid."
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 25,
      "visible_if": "{{ section.settings.enable_scroll }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FAF5EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1E3D2C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#1A1A17"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#1E3D2C"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Optional. A checkmark is used if left empty."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Benefit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit feature",
      "blocks": [
        { "type": "badge", "settings": { "label": "Limping Support" } },
        { "type": "badge", "settings": { "label": "Pain & Discomfort Support" } },
        { "type": "badge", "settings": { "label": "Mobility Support" } },
        { "type": "badge", "settings": { "label": "Cartilage Repair & Protection" } },
        { "type": "badge", "settings": { "label": "Flexibility Support" } },
        { "type": "badge", "settings": { "label": "Connective Tissue Strengthening" } },
        { "type": "badge", "settings": { "label": "Anti-Inflammatory Support" } },
        { "type": "badge", "settings": { "label": "Joint Lubrication" } },
        { "type": "badge", "settings": { "label": "Synovial Fluid Production" } },
        { "type": "badge", "settings": { "label": "Bone & Joint Reinforcement" } }
      ]
    }
  ]
}
{% endschema %}