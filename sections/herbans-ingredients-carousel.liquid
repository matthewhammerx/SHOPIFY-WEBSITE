{% comment %}
  herbans-ingredients-carousel
  Desktop: text on top, buttons on the right, carousel underneath.
  Mobile: carousel has no side padding and shows 1.5 cards.
{% endcomment %}

<section id="herbans-ingredients-carousel-{{ section.id }}" class="hic-section">
  <div class="hic-container">
    <div class="hic-layout">
      <div class="hic-header-row">
      <div class="hic-copy">
        {% if section.settings.eyebrow != blank %}
          <div class="hic-eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="hic-heading rte">{{ section.settings.heading }}</div>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="hic-subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>

        {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
          <div class="hic-buttons hic-buttons-header">
            {% if section.settings.button_1_label != blank %}
              <a href="{{ section.settings.button_1_link | default: '#' }}" class="hic-btn hic-btn-primary">
                {{ section.settings.button_1_label }}
              </a>
            {% endif %}

            {% if section.settings.button_2_label != blank %}
              <a href="{{ section.settings.button_2_link | default: '#' }}" class="hic-btn hic-btn-secondary">
                {{ section.settings.button_2_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}

      </div>

      <div class="hic-media-side">
        <div class="hic-carousel-shell">
          <div class="hic-carousel" data-hic-carousel>
            {% for block in section.blocks %}
              <article class="hic-card" {{ block.shopify_attributes }}>
                <div class="hic-card-inner">
                  <div class="hic-media">
                    {% if block.settings.image != blank %}
                      <img
                        class="hic-main-img"
                        src="{{ block.settings.image | image_url: width: 1200 }}"
                        alt="{{ block.settings.image_alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                      >
                      <div class="hic-blur-mask" aria-hidden="true">
                        <img
                          class="hic-blur-img"
                          src="{{ block.settings.image | image_url: width: 1200 }}"
                          alt=""
                          loading="lazy"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                        >
                      </div>
                    {% else %}
                      <div class="hic-placeholder">
                        <span>{{ block.settings.ingredient_name | default: 'Ingredient' }}</span>
                      </div>
                    {% endif %}

                    <div class="hic-top-fade"></div>
                    <div class="hic-bottom-panel"></div>

                    {% if block.settings.ingredient_name != blank %}
                      <div class="hic-ingredient">{{ block.settings.ingredient_name }}</div>
                    {% endif %}

                    {% if block.settings.badge != blank %}
                      <div class="hic-badge">{{ block.settings.badge }}</div>
                    {% endif %}

                    <div class="hic-content">
                      {% if block.settings.title != blank %}
                        <h3>{{ block.settings.title }}</h3>
                      {% endif %}

                      {% if block.settings.text != blank %}
                        <p>{{ block.settings.text }}</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.show_arrows %}
          <div class="hic-arrows">
            <button type="button" class="hic-arrow" data-hic-prev aria-label="Previous slide">&#8592;</button>
            <button type="button" class="hic-arrow" data-hic-next aria-label="Next slide">&#8594;</button>
          </div>
        {% endif %}

        {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
          <div class="hic-buttons hic-buttons-below">
            {% if section.settings.button_1_label != blank %}
              <a href="{{ section.settings.button_1_link | default: '#' }}" class="hic-btn hic-btn-primary">
                {{ section.settings.button_1_label }}
              </a>
            {% endif %}

            {% if section.settings.button_2_label != blank %}
              <a href="{{ section.settings.button_2_link | default: '#' }}" class="hic-btn hic-btn-secondary">
                {{ section.settings.button_2_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% assign hic_panel_alpha = section.settings.panel_opacity | divided_by: 100.0 %}
<style>
  {% unless section.settings.show_on_mobile %}
    @media screen and (max-width: 767px) {
      #herbans-ingredients-carousel-{{ section.id }} {
        display: none !important;
      }
    }
  {% endunless %}

  {% unless section.settings.show_on_desktop %}
    @media screen and (min-width: 768px) {
      #herbans-ingredients-carousel-{{ section.id }} {
        display: none !important;
      }
    }
  {% endunless %}

  #herbans-ingredients-carousel-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    overflow: hidden;
  }

  #herbans-ingredients-carousel-{{ section.id }} * {
    box-sizing: border-box;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-layout {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.column_gap_mobile }}px;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-header-row {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-copy {
    text-align: {{ section.settings.mobile_text_align }};
    color: {{ section.settings.heading_color }};
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-eyebrow {
    margin: 0 0 12px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size_mobile }}px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-heading,
  #herbans-ingredients-carousel-{{ section.id }} .hic-heading p {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: {{ section.settings.heading_line_height_mobile }}px;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-heading strong,
  #herbans-ingredients-carousel-{{ section.id }} .hic-heading b {
    color: {{ section.settings.heading_accent_color }};
    font-weight: inherit;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-heading em,
  #herbans-ingredients-carousel-{{ section.id }} .hic-heading i {
    color: {{ section.settings.heading_accent_color }};
    font-style: italic;
    font-family: Georgia, serif;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-subheading,
  #herbans-ingredients-carousel-{{ section.id }} .hic-subheading p {
    margin: 14px 0 0;
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size_mobile }}px;
    line-height: {{ section.settings.subheading_line_height_mobile }}px;
    font-weight: {{ section.settings.subheading_weight }};
    max-width: 100%;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-media-side {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-carousel-shell {
    width: 100%;
    overflow: hidden;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-carousel {
    --hic-gap: {{ section.settings.card_gap_mobile }}px;
    display: flex;
    gap: var(--hic-gap);
    width: 100%;
    overflow: visible;
    scroll-snap-type: none;
    scroll-behavior: auto;
    -webkit-overflow-scrolling: auto;
    padding-bottom: 8px;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-carousel::-webkit-scrollbar {
    display: none;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-card {
    flex: 0 0 calc((100% - (var(--hic-gap) * 0.5)) / 1.5);
    min-width: 0;
    scroll-snap-align: none;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-card[data-hic-clone="true"] {
    pointer-events: none;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-card-inner {
    position: relative;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.card_ratio }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    background: {{ section.settings.card_bg }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    box-shadow: {{ section.settings.card_shadow }};
    isolation: isolate;
  }

  /* Real top image overlay. This is placed directly on the card/image layer so it always shows. */
  #herbans-ingredients-carousel-{{ section.id }} .hic-media::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 52%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.72) 18%,
      rgba(0, 0, 0, 0.46) 42%,
      rgba(0, 0, 0, 0.18) 70%,
      rgba(0, 0, 0, 0) 100%
    ) !important;
    opacity: {{ section.settings.top_overlay_opacity | divided_by: 100.0 }} !important;
    pointer-events: none;
    z-index: 5;
  }


  #herbans-ingredients-carousel-{{ section.id }} .hic-media .hic-main-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    pointer-events: none;
    z-index: 0;
    transform: scale({{ section.settings.image_zoom | divided_by: 100.0 }});
  }

  /* REAL bottom blur layer.
     The blur is made visible by a duplicated image underneath the gray panel,
     oversized so the blur has room to spread without creating side halos. */
  #herbans-ingredients-carousel-{{ section.id }} .hic-blur-mask {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    border-radius: inherit;
    clip-path: inset(calc(100% - {{ section.settings.bottom_panel_height_mobile }}%) 0 0 0);
    -webkit-clip-path: inset(calc(100% - {{ section.settings.bottom_panel_height_mobile }}%) 0 0 0);
    transform: translateZ(0);
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-blur-mask .hic-blur-img {
    position: absolute;
    inset: -72px;
    width: calc(100% + 144px);
    height: calc(100% + 144px);
    max-width: none;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    opacity: 1;
    filter: blur({{ section.settings.panel_blur_mobile | times: 2 }}px);
    -webkit-filter: blur({{ section.settings.panel_blur_mobile | times: 2 }}px);
    transform: scale({{ section.settings.image_zoom | plus: 14 | divided_by: 100.0 }});
    transform-origin: center;
    pointer-events: none;
    backface-visibility: hidden;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    background: linear-gradient(135deg, {{ section.settings.placeholder_bg_1 }}, {{ section.settings.placeholder_bg_2 }});
    color: {{ section.settings.placeholder_text_color }};
    font-weight: 900;
    font-size: 22px;
    line-height: 1.1;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-top-fade {
    display: none !important;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-bottom-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: {{ section.settings.bottom_panel_height_mobile }}%;
    /* Tint panel + native glass blur. The duplicate blurred image below is the main blur,
       this native blur makes the effect stronger where the browser supports it. */
    background: {{ section.settings.panel_rgb | color_modify: 'alpha', hic_panel_alpha }};
    backdrop-filter: blur({{ section.settings.panel_blur_mobile }}px) saturate(1.05);
    -webkit-backdrop-filter: blur({{ section.settings.panel_blur_mobile }}px) saturate(1.05);
    box-shadow: 0 -18px 44px rgba(0, 0, 0, 0.16);
    z-index: 2;
    pointer-events: none;
    transform: translateZ(0);
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-bottom-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0.10) 100%);
    pointer-events: none;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-ingredient {
    position: absolute;
    top: {{ section.settings.top_label_top_mobile }}px;
    left: {{ section.settings.top_label_side_mobile }}px;
    right: {{ section.settings.top_label_side_mobile }}px;
    max-width: calc(100% - 130px);
    z-index: 10;
    color: {{ section.settings.top_label_color }};
    font-size: {{ section.settings.top_label_size_mobile }}px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    word-break: break-word;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-content {
    position: absolute;
    left: {{ section.settings.card_content_side_mobile }}px;
    right: {{ section.settings.card_content_side_mobile }}px;
    top: calc(100% - {{ section.settings.bottom_panel_height_mobile }}% + {{ section.settings.card_content_bottom_mobile }}px);
    bottom: auto;
    z-index: 6;
    color: {{ section.settings.card_text_color }};
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-badge {
    position: absolute;
    top: {{ section.settings.top_label_top_mobile }}px;
    right: {{ section.settings.top_label_side_mobile }}px;
    z-index: 11;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 7px 11px;
    border-radius: 999px;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_size_mobile }}px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(0,0,0,.14);
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-content h3 {
    margin: 0 0 10px;
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_size_mobile }}px;
    line-height: {{ section.settings.card_title_line_height_mobile }}px;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-content p {
    margin: 0;
    color: {{ section.settings.card_text_color }};
    font-size: {{ section.settings.card_text_size_mobile }}px;
    line-height: {{ section.settings.card_text_line_height_mobile }}px;
    font-weight: {{ section.settings.card_text_weight }};
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-arrows {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-arrow {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid {{ section.settings.arrow_border_color }};
    background: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 18px;
    font-weight: 900;
    line-height: 1;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-buttons {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: {{ section.settings.button_gap }}px;
    margin-top: {{ section.settings.buttons_top_mobile }}px;
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-buttons-header {
    display: none;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-buttons-below {
    display: flex;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-btn {
    width: 100%;
    min-width: {{ section.settings.button_min_width }}px;
    min-height: {{ section.settings.button_height }}px;
    padding: 12px 22px;
    border-radius: {{ section.settings.button_radius }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 900;
    line-height: 1;
    transition: transform .2s ease, opacity .2s ease;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-btn:hover {
    transform: translateY(-1px);
    opacity: .92;
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-btn-primary {
    background: {{ section.settings.button_1_bg }};
    color: {{ section.settings.button_1_color }};
    border: 1px solid {{ section.settings.button_1_border }};
  }

  #herbans-ingredients-carousel-{{ section.id }} .hic-btn-secondary {
    background: {{ section.settings.button_2_bg }};
    color: {{ section.settings.button_2_color }};
    border: 1px solid {{ section.settings.button_2_border }};
  }

  @media screen and (min-width: 768px) {
    #herbans-ingredients-carousel-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-container {
      max-width: none;
      padding-left: 0;
      padding-right: 0;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-layout {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.column_gap_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-header-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      padding-left: {{ section.settings.side_padding_desktop }}px;
      padding-right: {{ section.settings.side_padding_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-copy {
      text-align: {{ section.settings.desktop_text_align }};
      flex: 1 1 auto;
      min-width: 0;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-eyebrow {
      font-size: {{ section.settings.eyebrow_size_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-heading,
    #herbans-ingredients-carousel-{{ section.id }} .hic-heading p {
      font-size: {{ section.settings.heading_size_desktop }}px;
      line-height: {{ section.settings.heading_line_height_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-subheading,
    #herbans-ingredients-carousel-{{ section.id }} .hic-subheading p {
      font-size: {{ section.settings.subheading_size_desktop }}px;
      line-height: {{ section.settings.subheading_line_height_desktop }}px;
      max-width: {{ section.settings.subheading_width }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-carousel {
      --hic-gap: {{ section.settings.card_gap_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-card {
      flex: 0 0 calc((100% - (var(--hic-gap) * 3.25)) / 4.25);
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-blur-mask {
      clip-path: inset(calc(100% - {{ section.settings.bottom_panel_height_desktop }}%) 0 0 0);
      -webkit-clip-path: inset(calc(100% - {{ section.settings.bottom_panel_height_desktop }}%) 0 0 0);
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-blur-mask .hic-blur-img {
      filter: blur({{ section.settings.panel_blur_desktop | times: 2 }}px);
      -webkit-filter: blur({{ section.settings.panel_blur_desktop | times: 2 }}px);
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-top-fade {
      height: calc(100% - {{ section.settings.bottom_panel_height_desktop }}%);
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-bottom-panel {
      height: {{ section.settings.bottom_panel_height_desktop }}%;
      backdrop-filter: blur({{ section.settings.panel_blur_desktop }}px) saturate(1.05);
      -webkit-backdrop-filter: blur({{ section.settings.panel_blur_desktop }}px) saturate(1.05);
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-ingredient {
      top: {{ section.settings.top_label_top_desktop }}px;
      left: {{ section.settings.top_label_side_desktop }}px;
      right: {{ section.settings.top_label_side_desktop }}px;
      font-size: {{ section.settings.top_label_size_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-content {
      left: {{ section.settings.card_content_side_desktop }}px;
      right: {{ section.settings.card_content_side_desktop }}px;
      top: calc(100% - {{ section.settings.bottom_panel_height_desktop }}% + {{ section.settings.card_content_bottom_desktop }}px);
      bottom: auto;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-badge {
      top: {{ section.settings.top_label_top_desktop }}px;
      right: {{ section.settings.top_label_side_desktop }}px;
      font-size: {{ section.settings.badge_size_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-content h3 {
      font-size: {{ section.settings.card_title_size_desktop }}px;
      line-height: {{ section.settings.card_title_line_height_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-content p {
      font-size: {{ section.settings.card_text_size_desktop }}px;
      line-height: {{ section.settings.card_text_line_height_desktop }}px;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-buttons-header {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      flex: 0 0 auto;
      margin-top: 0;
      padding: 0;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-buttons-below {
      display: none;
    }

    #herbans-ingredients-carousel-{{ section.id }} .hic-btn {
      width: auto;
    }
  }
</style>

<script>
  (function() {
    function initCarousel() {
      var section = document.getElementById('herbans-ingredients-carousel-{{ section.id }}');
      if (!section) return;

      var shell = section.querySelector('.hic-carousel-shell');
      var carousel = section.querySelector('[data-hic-carousel]');
      var prev = section.querySelector('[data-hic-prev]');
      var next = section.querySelector('[data-hic-next]');
      if (!shell || !carousel) return;

      if (carousel.dataset.initialized === 'true') return;
      carousel.dataset.initialized = 'true';

      var originalCards = Array.prototype.slice.call(carousel.querySelectorAll('.hic-card'));
      var originalCount = originalCards.length;
      var offset = 0;
      var rafId = null;
      var lastTime = null;
      var isPaused = false;
      var resizeTimer = null;
      var autoplaySeconds = {{ section.settings.autoplay_speed | default: 4 }};
      var autoplayEnabled = {% if section.settings.enable_autoplay %}true{% else %}false{% endif %};

      function cleanClone(clone) {
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('data-hic-clone', 'true');
        clone.removeAttribute('id');

        Array.prototype.slice.call(clone.attributes).forEach(function(attr) {
          if (attr.name.indexOf('data-shopify') === 0 || attr.name === 'shopify_attributes') {
            clone.removeAttribute(attr.name);
          }
        });
      }

      function buildLoop() {
        if (carousel.dataset.loopCloned === 'true' || originalCount < 2) return;

        // Add enough duplicate cards so the track can loop forever without a visible reset.
        for (var round = 0; round < 3; round++) {
          originalCards.forEach(function(card) {
            var clone = card.cloneNode(true);
            cleanClone(clone);
            carousel.appendChild(clone);
          });
        }

        carousel.dataset.loopCloned = 'true';
      }

      function getGap() {
        var styles = window.getComputedStyle(carousel);
        return parseFloat(styles.columnGap || styles.gap || 0) || 0;
      }

      function getStep() {
        var firstCard = carousel.querySelector('.hic-card');
        if (!firstCard) return 320;
        return firstCard.getBoundingClientRect().width + getGap();
      }

      function getLoopWidth() {
        if (originalCount < 2) return 0;
        return getStep() * originalCount;
      }

      function normalizeOffset() {
        var loopWidth = getLoopWidth();
        if (!loopWidth) return;

        while (Math.abs(offset) >= loopWidth) {
          offset += loopWidth;
        }

        while (offset > 0) {
          offset -= loopWidth;
        }
      }

      function applyTransform() {
        carousel.style.transform = 'translate3d(' + offset + 'px, 0, 0)';
      }

      function animate(time) {
        if (!lastTime) lastTime = time;
        var delta = time - lastTime;
        lastTime = time;

        if (autoplayEnabled && !isPaused && originalCount > 1) {
          var step = getStep();
          var speed = step / (autoplaySeconds * 1000); // one card every autoplaySeconds
          offset -= speed * delta;
          normalizeOffset();
          applyTransform();
        }

        rafId = window.requestAnimationFrame(animate);
      }

      function nudge(direction) {
        if (originalCount < 2) return;

        var step = getStep();
        var loopWidth = getLoopWidth();
        isPaused = true;

        // If moving backward from the first visual card, jump to the identical cloned set first.
        // This makes the arrow feel infinite instead of snapping back.
        if (direction < 0 && loopWidth && offset + step > 0) {
          carousel.style.transition = 'none';
          offset -= loopWidth;
          applyTransform();
          carousel.offsetHeight; // force the browser to apply the invisible reset
        }

        carousel.style.transition = 'transform 420ms ease';
        offset -= step * direction;
        normalizeOffset();
        applyTransform();

        window.setTimeout(function() {
          carousel.style.transition = 'none';
          isPaused = false;
          lastTime = null;
        }, 430);
      }

      buildLoop();
      carousel.style.transition = 'none';
      applyTransform();

      if (prev) {
        prev.addEventListener('click', function() {
          nudge(-1);
        });
      }

      if (next) {
        next.addEventListener('click', function() {
          nudge(1);
        });
      }

      // Keep the carousel moving continuously, but pause when the customer touches it.
      carousel.addEventListener('touchstart', function() {
        isPaused = true;
      }, { passive: true });

      carousel.addEventListener('touchend', function() {
        isPaused = false;
        lastTime = null;
      }, { passive: true });

      window.addEventListener('resize', function() {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(function() {
          normalizeOffset();
          applyTransform();
          lastTime = null;
        }, 150);
      });

      rafId = window.requestAnimationFrame(animate);

      document.addEventListener('shopify:section:unload', function(event) {
        if (!event || !event.target || !event.target.contains(section)) return;
        if (rafId) window.cancelAnimationFrame(rafId);
      });
    }

    document.addEventListener('DOMContentLoaded', initCarousel);
    document.addEventListener('shopify:section:load', initCarousel);
    initCarousel();
  })();
</script>

