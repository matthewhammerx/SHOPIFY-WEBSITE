<section class="lw lw-section lw-glass" style="--lw-pt: {{ section.settings.padding_top }}px; --lw-pb: {{ section.settings.padding_bottom }}px; --lw-fg: {{ section.settings.fg }}; --lw-gold: {{ section.settings.accent }}; --lw-bg-grad: linear-gradient(160deg, {{ section.settings.bg }} 0%, {{ section.settings.bg_2 }} 100%); --lw-side-d: {{ section.settings.side_desktop }}px; --lw-side-m: {{ section.settings.side_mobile }}px;">
  {%- if section.settings.bg_video != blank -%}
    <div class="lw-glass__bgimg" style="--lw-dark: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">{{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' }}</div>
  {%- elsif section.settings.bg_image != blank -%}
    <div class="lw-glass__bgimg" style="--lw-dark: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">{{ section.settings.bg_image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2400', alt: '' }}</div>
  {%- endif -%}
  {%- if section.settings.bg_video != blank or section.settings.bg_image != blank -%}
    <div class="lw-glass__overlay" style="background: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}
  {%- liquid
    assign img = section.settings.image
    if img == blank and product
      assign img = product.featured_image
    endif
  -%}
  <div class="lw-wrap lw-glass__wrap">
    <div class="lw-glass__layout{% if img != blank and section.settings.show_image %} lw-glass__layout--img lw-glass__layout--{{ section.settings.image_position }}{% endif %}">
      <div class="lw-glass__main">
        <div class="lw-head lw-glass__head">
          {%- if section.settings.eyebrow != blank -%}<span class="lw-glass__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="lw-h lw-h--lg">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<div class="lw-sub lw-rte">{{ section.settings.text }}</div>{%- endif -%}
          {%- if section.settings.button_label != blank -%}<a class="lw-btn lw-glass__btn" href="{{ section.settings.button_link | default: '#lw-product' }}">{{ section.settings.button_label }}</a>{%- endif -%}
        </div>
        <div class="lw-glass__grid" style="--lw-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
          {%- for block in section.blocks -%}
            <div class="lw-glass__card lw-reveal" {{ block.shopify_attributes }}>
              <h3 class="lw-glass__title">{{ block.settings.title }}</h3>
              <div class="lw-glass__value">
                {%- if block.settings.value != blank -%}
                  <span {% if section.settings.animate_numbers %}data-lw-count="{{ block.settings.value }}"{% endif %} data-suffix="{{ block.settings.suffix | escape }}">{{ block.settings.value }}{{ block.settings.suffix }}</span>
                {%- else -%}
                  {% render 'lw-icon', icon: block.settings.icon %}
                {%- endif -%}
              </div>
              <p class="lw-glass__text">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.footnote != blank -%}<div class="lw-glass__foot lw-rte">{{ section.settings.footnote }}</div>{%- endif -%}
      </div>
      {%- if img != blank and section.settings.show_image -%}
        <div class="lw-glass__visual">
          {%- if section.settings.show_rings -%}<div class="lw-bprod__rings" aria-hidden="true"><span></span><span></span><span></span></div>{%- endif -%}
          {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 40vw, 90vw', widths: '400, 600, 800, 1200', alt: img.alt }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
