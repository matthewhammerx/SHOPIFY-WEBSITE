{% style %}
  #shopify-section-{{ section.id }} {
    position: relative;
    /* FIX: lowered from 30 to 1. The mobile menu drawer (#menu-drawer)
       has z-index: 10 in the theme's base.css. This section was set
       higher than that, so it always painted on top of the drawer
       when open. Dropping this below 10 lets the drawer render above
       the sale bar instead. */
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar {
    width: 100%;
    box-sizing: border-box;
    background: linear-gradient(
      {{ section.settings.gradient_angle }}deg,
      {{ section.settings.background_start }} 0%,
      {{ section.settings.background_end }} 100%
    );
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    min-height: {{ section.settings.desktop_height }}px;
    margin: 0 auto;
    padding: {{ section.settings.desktop_padding_vertical }}px 12px;
    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.desktop_gap }}px;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__link {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex-shrink: 1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__headline,
  #shopify-section-{{ section.id }} .mg-sale-bar__subtext {
    margin: 0;
    padding: 0;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__headline {
    color: {{ section.settings.headline_color }};
    font-family: inherit;
    font-size: {{ section.settings.headline_size }}px;
    font-weight: {{ section.settings.headline_weight }};
    line-height: 1.12;
    letter-spacing: {{ section.settings.headline_spacing | divided_by: 100.0 }}em;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__subtext {
    margin-top: {{ section.settings.text_gap }}px;
    color: {{ section.settings.subtext_color }};
    font-family: inherit;
    font-size: {{ section.settings.subtext_size }}px;
    font-weight: {{ section.settings.subtext_weight }};
    line-height: 1.12;
    letter-spacing: {{ section.settings.subtext_spacing | divided_by: 100.0 }}em;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__link:hover .mg-sale-bar__headline,
  #shopify-section-{{ section.id }} .mg-sale-bar__link:hover .mg-sale-bar__subtext {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__timer {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    flex-shrink: 0;

    padding:
      {{ section.settings.timer_padding_vertical }}px
      {{ section.settings.timer_padding_horizontal }}px;

    background: {{ section.settings.timer_background }};
    color: {{ section.settings.timer_text_color }};

    border:
      {{ section.settings.timer_border_width }}px
      solid
      {{ section.settings.timer_border_color }};

    border-radius: {{ section.settings.timer_radius }}px;

    box-shadow:
      0 2px 7px
      rgba(0, 0, 0, {{ section.settings.timer_shadow | divided_by: 100.0 }});
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__unit {
    width: {{ section.settings.timer_unit_width }}px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__digits {
    display: block;
    color: inherit;
    font-family: inherit;
    font-size: {{ section.settings.digit_size }}px;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__label {
    display: block;
    margin-top: 2px;
    color: inherit;
    font-family: inherit;
    font-size: {{ section.settings.label_size }}px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .mg-sale-bar__colon {
    display: block;
    padding: 0 1px;
    color: inherit;
    font-family: inherit;
    font-size: {{ section.settings.colon_size }}px;
    font-weight: 800;
    line-height: {{ section.settings.digit_size }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mg-sale-bar__inner {
      min-height: {{ section.settings.mobile_height }}px;
      padding:
        {{ section.settings.mobile_padding_vertical }}px
        5px;
      gap: {{ section.settings.mobile_gap }}px;
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__headline {
      font-size: {{ section.settings.mobile_headline_size }}px;
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__subtext {
      font-size: {{ section.settings.mobile_subtext_size }}px;
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__timer {
      padding:
        {{ section.settings.mobile_timer_padding_vertical }}px
        {{ section.settings.mobile_timer_padding_horizontal }}px;
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__unit {
      width: {{ section.settings.mobile_timer_unit_width }}px;
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__digits {
      font-size: {{ section.settings.mobile_digit_size }}px;
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__label {
      font-size: {{ section.settings.mobile_label_size }}px;
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__colon {
      font-size: {{ section.settings.mobile_colon_size }}px;
      line-height: {{ section.settings.mobile_digit_size }}px;
    }
  }

  @media screen and (max-width: 380px) {
    #shopify-section-{{ section.id }} .mg-sale-bar__inner {
      gap: 5px;
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__headline {
      font-size: calc({{ section.settings.mobile_headline_size }}px - 1px);
    }

    #shopify-section-{{ section.id }} .mg-sale-bar__subtext {
      font-size: calc({{ section.settings.mobile_subtext_size }}px - 1px);
    }
  }
{% endstyle %}

<div
  class="mg-sale-bar"
  data-mg-countdown
  data-mode="{{ section.settings.schedule_mode }}"
  data-fixed-date="{{ section.settings.fixed_date | escape }}"
  data-reset-hour="{{ section.settings.reset_hour }}"
  data-reset-minute="{{ section.settings.reset_minute }}"
  data-reset-weekday="{{ section.settings.reset_weekday }}"
>
  <div class="mg-sale-bar__inner">

    {% if section.settings.link != blank %}
      <a
        class="mg-sale-bar__link"
        href="{{ section.settings.link }}"
        aria-label="{{ section.settings.headline | escape }}"
      >
    {% endif %}

    <div class="mg-sale-bar__copy">
      {% if section.settings.headline != blank %}
        <p class="mg-sale-bar__headline">
          {{ section.settings.headline }}
        </p>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="mg-sale-bar__subtext">
          {{ section.settings.subtext }}
        </p>
      {% endif %}
    </div>

    {% if section.settings.link != blank %}
      </a>
    {% endif %}

    {% if section.settings.show_timer %}
      <div
        class="mg-sale-bar__timer"
        role="timer"
        aria-label="Sale countdown timer"
      >
        <div class="mg-sale-bar__unit">
          <span class="mg-sale-bar__digits" data-hours>00</span>
          <span class="mg-sale-bar__label">Hrs</span>
        </div>

        <span class="mg-sale-bar__colon">:</span>

        <div class="mg-sale-bar__unit">
          <span class="mg-sale-bar__digits" data-minutes>00</span>
          <span class="mg-sale-bar__label">Min</span>
        </div>

        <span class="mg-sale-bar__colon">:</span>

        <div class="mg-sale-bar__unit">
          <span class="mg-sale-bar__digits" data-seconds>00</span>
          <span class="mg-sale-bar__label">Sec</span>
        </div>
      </div>
    {% endif %}

  </div>
</div>

<script>
  (() => {
    const sectionRoot = document.getElementById(
      'shopify-section-{{ section.id }}'
    );

    if (!sectionRoot) return;

    const countdown = sectionRoot.querySelector('[data-mg-countdown]');

    if (!countdown || countdown.dataset.initialized === 'true') return;

    countdown.dataset.initialized = 'true';

    const hoursElement = countdown.querySelector('[data-hours]');
    const minutesElement = countdown.querySelector('[data-minutes]');
    const secondsElement = countdown.querySelector('[data-seconds]');

    if (!hoursElement || !minutesElement || !secondsElement) return;

    const mode = countdown.dataset.mode || 'reset_daily';
    const fixedDateValue = countdown.dataset.fixedDate || '';

    const resetHour =
      Number.parseInt(countdown.dataset.resetHour, 10) || 0;

    const resetMinute =
      Number.parseInt(countdown.dataset.resetMinute, 10) || 0;

    const resetWeekday =
      Number.parseInt(countdown.dataset.resetWeekday, 10) || 0;

    let timerInterval = null;

    function getDailyTarget() {
      const now = new Date();

      const target = new Date(
        now.getFullYear(),
        now.getMonth(),
        now.getDate(),
        resetHour,
        resetMinute,
        0,
        0
      );

      if (target.getTime() <= now.getTime()) {
        target.setDate(target.getDate() + 1);
      }

      return target.getTime();
    }

    function getWeeklyTarget() {
      const now = new Date();

      const target = new Date(
        now.getFullYear(),
        now.getMonth(),
        now.getDate(),
        resetHour,
        resetMinute,
        0,
        0
      );

      let daysUntilReset =
        (resetWeekday - now.getDay() + 7) % 7;

      if (
        daysUntilReset === 0 &&
        target.getTime() <= now.getTime()
      ) {
        daysUntilReset = 7;
      }

      target.setDate(target.getDate() + daysUntilReset);

      return target.getTime();
    }

    function getFixedTarget() {
      const parsedDate = new Date(fixedDateValue).getTime();

      return Number.isNaN(parsedDate)
        ? Date.now()
        : parsedDate;
    }

    function getTargetTime() {
      if (mode === 'fixed_date') {
        return getFixedTarget();
      }

      if (mode === 'reset_weekly') {
        return getWeeklyTarget();
      }

      return getDailyTarget();
    }

    function renderTime(milliseconds) {
      const safeMilliseconds = Math.max(0, milliseconds);

      const hours = Math.floor(
        safeMilliseconds / 3600000
      );

      const minutes = Math.floor(
        (safeMilliseconds % 3600000) / 60000
      );

      const seconds = Math.floor(
        (safeMilliseconds % 60000) / 1000
      );

      hoursElement.textContent =
        String(hours).padStart(2, '0');

      minutesElement.textContent =
        String(minutes).padStart(2, '0');

      secondsElement.textContent =
        String(seconds).padStart(2, '0');
    }

    function updateCountdown() {
      const difference = getTargetTime() - Date.now();

      if (mode === 'fixed_date' && difference <= 0) {
        renderTime(0);

        if (timerInterval) {
          window.clearInterval(timerInterval);
        }

        return;
      }

      renderTime(difference);
    }

    updateCountdown();

    timerInterval = window.setInterval(
      updateCountdown,
      1000
    );

    document.addEventListener(
      'shopify:section:unload',
      (event) => {
        if (event.detail.sectionId !== '{{ section.id }}') {
          return;
        }

        if (timerInterval) {
          window.clearInterval(timerInterval);
        }
      },
      { once: true }
    );
  })();
</script>

{% schema %}
{
  "name": "Sale countdown bar",
  "tag": "section",
  "class": "sale-countdown-bar-section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Top text",
      "default": "☀️ SUMMER SALE ☀️"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Bottom text",
      "default": "UP TO 61% OFF + FREE GIFTS"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Top text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Bottom text color",
      "default": "#FFF200"
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Desktop top text size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Desktop bottom text size",
      "min": 8,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_headline_size",
      "label": "Mobile top text size",
      "min": 7,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_subtext_size",
      "label": "Mobile bottom text size",
      "min": 7,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "range",
      "id": "headline_weight",
      "label": "Top text weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "default": 800
    },
    {
      "type": "range",
      "id": "subtext_weight",
      "label": "Bottom text weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "default": 800
    },
    {
      "type": "range",
      "id": "headline_spacing",
