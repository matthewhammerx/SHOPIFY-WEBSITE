{% comment %}
  Meowgical — Testimonial Carousel
  Layout reference: Wuffes "What Customers Have to Say" slider.
  Rebuilt generalized (any product, any number of reviews) in the
  Meowgical brand system, with a real working prev/next + dot carousel.
{% endcomment %}

<section id="mg-testimonials-{{ section.id }}" class="mg-testimonials">
  <div class="mg-testimonials__wrap">

    {% if section.settings.heading != blank %}
      <h2 class="mg-testimonials__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="mg-testimonials__carousel" data-mg-carousel>
        <div class="mg-testimonials__track" data-mg-track>
          {% for block in section.blocks %}
            <div class="mg-testimonials__card" data-mg-card {{ block.shopify_attributes }}>
              <div class="mg-testimonials__stars" aria-hidden="true">
                {% for i in (1..5) %}
                  <svg viewBox="0 0 20 20" class="mg-testimonials__star{% if i > block.settings.rating %} is-empty{% endif %}">
                    <path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/>
                  </svg>
                {% endfor %}
              </div>

              {% if block.settings.title != blank %}
                <h3 class="mg-testimonials__title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.review_text != blank %}
                <p class="mg-testimonials__text">{{ block.settings.review_text }}</p>
              {% endif %}

              <div class="mg-testimonials__footer">
                <div class="mg-testimonials__author">
                  {% if block.settings.verified %}
                    <span class="mg-testimonials__verified" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M9 12.5 11 14.5 15.5 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.4"/>
                      </svg>
                    </span>
                  {% endif %}
                  <span>{{ block.settings.reviewer_name }}</span>
                </div>

                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 120 }}"
                    alt=""
                    class="mg-testimonials__image"
                    loading="lazy"
                    width="44"
                    height="44"
                  >
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="mg-testimonials__controls">
          <div class="mg-testimonials__dots" data-mg-dots>
            {% for block in section.blocks %}
              <button type="button" class="mg-testimonials__dot{% if forloop.first %} is-active{% endif %}" data-mg-dot="{{ forloop.index0 }}" aria-label="Go to review {{ forloop.index }}"></button>
            {% endfor %}
          </div>

          <div class="mg-testimonials__nav">
            <button type="button" class="mg-testimonials__arrow" data-mg-prev aria-label="Previous review">
              <svg viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="mg-testimonials__arrow" data-mg-next aria-label="Next review">
              <svg viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="mg-testimonials__cta">
        <a href="{{ section.settings.button_link | default: '#' }}" class="mg-testimonials__button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  #mg-testimonials-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
  }

  #mg-testimonials-{{ section.id }} * {
    box-sizing: border-box;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__heading {
    margin: 0 0 {{ section.settings.heading_gap }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -.02em;
    text-align: center;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__track {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__card {
    flex: 0 0 auto;
    width: min(84vw, 340px);
    scroll-snap-align: center;
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 24px;
    text-align: center;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__stars {
    display: flex;
    justify-content: center;
    gap: 3px;
    margin-bottom: 12px;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__star {
    width: 18px;
    height: 18px;
    fill: {{ section.settings.star_color }};
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__star.is-empty {
    fill: {{ section.settings.star_empty_color }};
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__title {
    margin: 0 0 8px;
    color: {{ section.settings.title_color }};
    font-size: 18px;
    font-weight: 800;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__text {
    margin: 0 0 18px;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    line-height: 1.5;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__author {
    display: flex;
    align-items: center;
    gap: 6px;
    color: {{ section.settings.author_color }};
    font-size: 14px;
    font-weight: 700;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__verified {
    display: inline-flex;
    color: {{ section.settings.accent_color }};
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__verified svg {
    width: 16px;
    height: 16px;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__image {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    object-fit: cover;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__dots {
    display: flex;
    gap: 8px;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: {{ section.settings.dot_color }};
    opacity: .4;
    cursor: pointer;
    transition: opacity .2s ease, transform .2s ease;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__dot.is-active {
    opacity: 1;
    transform: scale(1.2);
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__nav {
    display: flex;
    gap: 10px;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1.5px solid {{ section.settings.accent_color }};
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.accent_color }};
    cursor: pointer;
    transition: transform .15s ease;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__arrow:hover {
    transform: translateY(-1px);
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__arrow svg {
    width: 18px;
    height: 18px;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__arrow:disabled {
    opacity: .35;
    cursor: default;
    transform: none;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__cta {
    margin-top: 32px;
    text-align: center;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 14px 32px;
    border-radius: 999px;
    background: {{ section.settings.accent_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 15px;
    font-weight: 800;
    letter-spacing: .02em;
    text-decoration: none;
    transition: transform .2s ease;
  }

  #mg-testimonials-{{ section.id }} .mg-testimonials__button:hover {
    transform: translateY(-1px);
  }

  @media screen and (min-width: 750px) {
    #mg-testimonials-{{ section.id }} {
      padding: {{ section.settings.padding_top_desktop }}px 40px {{ section.settings.padding_bottom_desktop }}px;
    }

    #mg-testimonials-{{ section.id }} .mg-testimonials__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #mg-testimonials-{{ section.id }} .mg-testimonials__card {
      width: 320px;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('mg-testimonials-{{ section.id }}');
    if (!root) return;

    const track = root.querySelector('[data-mg-track]');
    const cards = [...root.querySelectorAll('[data-mg-card]')];
    const dots = [...root.querySelectorAll('[data-mg-dot]')];
    const prevBtn = root.querySelector('[data-mg-prev]');
    const nextBtn = root.querySelector('[data-mg-next]');
    if (!track || cards.length === 0) return;

    let activeIndex = 0;

    const scrollToIndex = (index) => {
      const clamped = Math.max(0, Math.min(index, cards.length - 1));
      const card = cards[clamped];
      track.scrollTo({
        left: card.offsetLeft - track.offsetLeft,
        behavior: 'smooth'
      });
    };

    const setActive = (index) => {
      activeIndex = index;
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === cards.length - 1;
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-mg-dot'), 10);
        scrollToIndex(index);
        setActive(index);
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const next = Math.max(0, activeIndex - 1);
        scrollToIndex(next);
        setActive(next);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const next = Math.min(cards.length - 1, activeIndex + 1);
        scrollToIndex(next);
        setActive(next);
      });
    }

    let scrollTimeout;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        let closest = 0;
        let closestDist = Infinity;
        cards.forEach((card, i) => {
          const dist = Math.abs((card.offsetLeft - track.offsetLeft) - track.scrollLeft);
          if (dist < closestDist) {
            closestDist = dist;
            closest = i;
          }
        });
        setActive(closest);
      }, 100);
    });

    setActive(0);
  })();
</script>

