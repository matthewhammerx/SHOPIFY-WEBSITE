{% comment %}
  Herbans 50/50 Stats Section
{% endcomment %}

<section id="herbans-stats-{{ section.id }}" class="herbans-stats">
  <div class="hs-outer">
    <div class="hs-card">
      <div class="hs-content">
        {% if section.settings.heading != blank %}
          <div class="hs-heading">{{ section.settings.heading }}</div>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="hs-text">{{ section.settings.text }}</div>
        {% endif %}

        <div class="hs-stats-row">
          {% for block in section.blocks %}
            <div class="hs-main-stat" {{ block.shopify_attributes }}>
              <div class="hs-main-number">{{ block.settings.number }}</div>
              <div class="hs-main-label">{{ block.settings.label }}</div>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.button_text != blank %}
          <div class="hs-button-wrap">
            <a href="{{ section.settings.button_link | default: '#' }}" class="hs-button">
              {{ section.settings.button_text }}
            </a>

            {% if section.settings.sources_text != blank %}
              <div class="hs-sources">{{ section.settings.sources_text }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if section.settings.image != blank %}
        <div class="hs-image-wrap">
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image_alt | escape }}"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #herbans-stats-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_side_padding }}px {{ section.settings.mobile_padding_bottom }}px;
  }

  #herbans-stats-{{ section.id }} * {
    box-sizing: border-box;
  }

  #herbans-stats-{{ section.id }} .hs-outer {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #herbans-stats-{{ section.id }} .hs-card {
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: {{ section.settings.card_shadow }};
  }

  #herbans-stats-{{ section.id }} .hs-content {
    padding: {{ section.settings.mobile_content_padding }}px;
    text-align: center;
    order: 2;
  }

  #herbans-stats-{{ section.id }} .hs-image-wrap {
    order: 1;
    min-height: {{ section.settings.mobile_image_height }}px;
    background: #eee;
  }

  #herbans-stats-{{ section.id }} .hs-image-wrap img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #herbans-stats-{{ section.id }} .hs-heading,
  #herbans-stats-{{ section.id }} .hs-heading p {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.mobile_heading_size }}px;
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  #herbans-stats-{{ section.id }} .hs-heading strong {
    color: {{ section.settings.heading_accent }};
    font-weight: inherit;
  }

  #herbans-stats-{{ section.id }} .hs-text,
  #herbans-stats-{{ section.id }} .hs-text p {
    margin: 14px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.mobile_text_size }}px;
    line-height: 1.4;
    font-weight: 500;
  }

  #herbans-stats-{{ section.id }} .hs-stats-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
    margin-top: 30px;
  }

  #herbans-stats-{{ section.id }} .hs-main-number {
    color: {{ section.settings.stat_color }};
    font-size: {{ section.settings.mobile_main_stat_size }}px;
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  #herbans-stats-{{ section.id }} .hs-main-label {
    margin-top: 10px;
    color: {{ section.settings.stat_text_color }};
    font-size: {{ section.settings.mobile_stat_label_size }}px;
    line-height: 1.25;
    font-weight: 700;
  }

  #herbans-stats-{{ section.id }} .hs-button-wrap {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  #herbans-stats-{{ section.id }} .hs-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: {{ section.settings.button_width }}px;
    min-height: {{ section.settings.mobile_button_height }}px;
    padding: 12px 34px;
    border-radius: 999px;
    text-decoration: none;
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.mobile_button_size }}px;
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
    transition: all .25s ease;

    {% if section.settings.button_use_gradient %}
      background: linear-gradient(135deg, {{ section.settings.button_gradient_1 }}, {{ section.settings.button_gradient_2 }});
      border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_gradient_1 }};
    {% else %}
      background: {{ section.settings.button_bg }};
      border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_bg }};
    {% endif %}
  }

  #herbans-stats-{{ section.id }} .hs-button:hover {
    background: transparent;

    {% if section.settings.button_use_gradient %}
      color: {{ section.settings.button_gradient_1 }};
      border-color: {{ section.settings.button_gradient_1 }};
    {% else %}
      color: {{ section.settings.button_bg }};
      border-color: {{ section.settings.button_bg }};
    {% endif %}

    transform: translateY(-1px);
  }

  #herbans-stats-{{ section.id }} .hs-sources {
    color: {{ section.settings.sources_color }};
    font-size: 13px;
    text-decoration: underline;
  }

  @media screen and (min-width: 768px) {
    #herbans-stats-{{ section.id }} {
      padding: {{ section.settings.desktop_padding_top }}px {{ section.settings.desktop_side_padding }}px {{ section.settings.desktop_padding_bottom }}px;
    }

    #herbans-stats-{{ section.id }} .hs-card {
      flex-direction: row;
      align-items: stretch;
      min-height: {{ section.settings.desktop_image_height }}px;
    }

    #herbans-stats-{{ section.id }} .hs-content {
      width: 50%;
      order: 1;
      padding: {{ section.settings.desktop_content_padding }}px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    #herbans-stats-{{ section.id }} .hs-image-wrap {
      width: 50%;
      order: 2;
      min-height: {{ section.settings.desktop_image_height }}px;
    }

    #herbans-stats-{{ section.id }} .hs-heading,
    #herbans-stats-{{ section.id }} .hs-heading p {
      font-size: {{ section.settings.desktop_heading_size }}px;
    }

    #herbans-stats-{{ section.id }} .hs-text,
    #herbans-stats-{{ section.id }} .hs-text p {
      font-size: {{ section.settings.desktop_text_size }}px;
      margin-top: 22px;
    }

    #herbans-stats-{{ section.id }} .hs-stats-row {
      gap: 50px;
      margin-top: 54px;
    }

    #herbans-stats-{{ section.id }} .hs-main-number {
      font-size: {{ section.settings.desktop_main_stat_size }}px;
    }

    #herbans-stats-{{ section.id }} .hs-main-label {
      font-size: {{ section.settings.desktop_stat_label_size }}px;
    }

    #herbans-stats-{{ section.id }} .hs-button-wrap {
      margin-top: 48px;
    }

    #herbans-stats-{{ section.id }} .hs-button {
      min-height: {{ section.settings.desktop_button_height }}px;
      font-size: {{ section.settings.desktop_button_size }}px;
    }
  }
</style>

