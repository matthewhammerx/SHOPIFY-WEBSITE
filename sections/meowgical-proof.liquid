{% comment %}
  Meowgical Image Proof Carousel
  Built for real customer-style images now, with optional product tab per card.
{% endcomment %}

<section id="mg-proof-{{ section.id }}" class="mg-proof">
  <div class="mg-proof__inner">
    <header class="mg-proof__header">
      {% if section.settings.eyebrow != blank %}<div class="mg-proof__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="mg-proof__heading">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.subheading != blank %}<div class="mg-proof__subheading rte">{{ section.settings.subheading }}</div>{% endif %}
    </header>

    <div class="mg-proof__viewport">
      <div class="mg-proof__track" data-mg-proof-track>
        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            <article class="mg-proof__card" data-mg-proof-card {{ block.shopify_attributes }}>
              <div class="mg-proof__media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'mg-proof__image', loading: 'lazy', widths: '360, 540, 720, 900, 1200', sizes: '(min-width: 990px) 31vw, (min-width: 750px) 46vw, 84vw', alt: block.settings.image_alt }}
                {% else %}
                  <div class="mg-proof__placeholder">Add image</div>
                {% endif %}
                {% if block.settings.badge_text != blank %}<div class="mg-proof__badge">{{ block.settings.badge_text }}</div>{% endif %}
              </div>

              {% if block.settings.show_product_tab %}
                <div class="mg-proof__product-tab">
                  {% if block.settings.product_image != blank %}
                    {{ block.settings.product_image | image_url: width: 180 | image_tag: class: 'mg-proof__product-image', loading: 'lazy', widths: '72, 108, 144, 180', sizes: '72px', alt: block.settings.product_title }}
                  {% endif %}
                  <div class="mg-proof__product-copy">
                    {% if block.settings.product_title != blank %}<div class="mg-proof__product-title">{{ block.settings.product_title }}</div>{% endif %}
                    {% if block.settings.product_subtext != blank %}<div class="mg-proof__product-subtext">{{ block.settings.product_subtext }}</div>{% endif %}
                  </div>
                  {% if block.settings.product_link != blank %}<a class="mg-proof__product-link" href="{{ block.settings.product_link }}" aria-label="{{ block.settings.product_title | escape }}"></a>{% endif %}
                </div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="mg-proof__controls">
      <div class="mg-proof__dots" data-mg-proof-dots></div>
      <div class="mg-proof__arrows">
        <button type="button" class="mg-proof__arrow" data-mg-proof-prev aria-label="Previous slide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg></button>
        <button type="button" class="mg-proof__arrow" data-mg-proof-next aria-label="Next slide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
      </div>
    </div>

    {% if section.settings.button_text != blank %}
      <div class="mg-proof__cta-wrap">
        <a href="{{ section.settings.button_link | default: '#MainProduct' }}" class="mg-proof__cta">{{ section.settings.button_text }}</a>
        {% if section.settings.guarantee_text != blank %}
          <div class="mg-proof__guarantee">
            {% if section.settings.guarantee_icon != blank %}<img src="{{ section.settings.guarantee_icon | image_url: width: 100 }}" alt="" class="mg-proof__guarantee-icon" loading="lazy">{% endif %}
            <span>{{ section.settings.guarantee_text }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
#mg-proof-{{ section.id }}{--bg:{{ section.settings.section_bg }};--card:{{ section.settings.card_bg }};--tab:{{ section.settings.tab_bg }};--heading:{{ section.settings.heading_color }};--text:{{ section.settings.text_color }};--accent:{{ section.settings.accent_color }};--soft:{{ section.settings.soft_accent }};--border:{{ section.settings.border_color }};overflow:hidden;background:var(--bg);padding:{{ section.settings.padding_top_mobile }}px {{ section.settings.padding_side_mobile }}px {{ section.settings.padding_bottom_mobile }}px}
#mg-proof-{{ section.id }} *{box-sizing:border-box}
#mg-proof-{{ section.id }} .mg-proof__inner{max-width:{{ section.settings.max_width }}px;margin:0 auto}
#mg-proof-{{ section.id }} .mg-proof__header{max-width:820px;margin:0 auto;text-align:{{ section.settings.heading_alignment_mobile }}}
#mg-proof-{{ section.id }} .mg-proof__eyebrow{display:inline-flex;padding:8px 14px;border-radius:999px;background:var(--soft);color:var(--accent);font-size:12px;line-height:1;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
#mg-proof-{{ section.id }} .mg-proof__heading{margin:14px 0 0;color:var(--heading);font-size:{{ section.settings.heading_size_mobile }}px;line-height:1.05;font-weight:900;letter-spacing:-.04em}
#mg-proof-{{ section.id }} .mg-proof__subheading{margin-top:14px;color:var(--text);font-size:{{ section.settings.subheading_size_mobile }}px;line-height:1.55}
#mg-proof-{{ section.id }} .mg-proof__subheading p{margin:0}
#mg-proof-{{ section.id }} .mg-proof__viewport{overflow:visible;margin-top:{{ section.settings.carousel_gap_mobile }}px}
#mg-proof-{{ section.id }} .mg-proof__track{display:flex;gap:{{ section.settings.card_gap_mobile }}px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding:2px 0 6px}
#mg-proof-{{ section.id }} .mg-proof__track::-webkit-scrollbar{display:none}
#mg-proof-{{ section.id }} .mg-proof__card{position:relative;flex:0 0 {{ section.settings.card_width_mobile }}%;overflow:hidden;scroll-snap-align:start;border:{{ section.settings.card_border_width }}px solid var(--border);border-radius:{{ section.settings.card_radius }}px;background:var(--card);box-shadow:{{ section.settings.card_shadow }}}
#mg-proof-{{ section.id }} .mg-proof__media{position:relative;overflow:hidden;aspect-ratio:{{ section.settings.image_ratio }};background:var(--soft)}
#mg-proof-{{ section.id }} .mg-proof__image{display:block;width:100%;height:100%;object-fit:cover}
#mg-proof-{{ section.id }} .mg-proof__placeholder{display:grid;place-items:center;width:100%;height:100%;color:var(--accent);font-weight:800}
#mg-proof-{{ section.id }} .mg-proof__badge{position:absolute;top:14px;left:14px;max-width:calc(100% - 28px);padding:8px 12px;border-radius:999px;background:{{ section.settings.badge_bg }};color:{{ section.settings.badge_text_color }};font-size:12px;line-height:1;font-weight:800}
#mg-proof-{{ section.id }} .mg-proof__product-tab{position:relative;display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center;min-height:{{ section.settings.tab_height_mobile }}px;padding:{{ section.settings.tab_padding_mobile }}px;border-top:{{ section.settings.tab_border_width }}px solid var(--border);background:var(--tab)}
#mg-proof-{{ section.id }} .mg-proof__product-image{width:{{ section.settings.product_image_size_mobile }}px;height:{{ section.settings.product_image_size_mobile }}px;object-fit:contain}
#mg-proof-{{ section.id }} .mg-proof__product-title{color:var(--heading);font-size:{{ section.settings.product_title_size_mobile }}px;line-height:1.15;font-weight:800}
#mg-proof-{{ section.id }} .mg-proof__product-subtext{margin-top:4px;color:var(--text);font-size:{{ section.settings.product_subtext_size_mobile }}px;line-height:1.35}
#mg-proof-{{ section.id }} .mg-proof__product-link{position:absolute;inset:0;z-index:2}
#mg-proof-{{ section.id }} .mg-proof__controls{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:{{ section.settings.controls_gap_mobile }}px}
#mg-proof-{{ section.id }} .mg-proof__dots{display:flex;flex-wrap:wrap;gap:8px}
#mg-proof-{{ section.id }} .mg-proof__dot{width:8px;height:8px;padding:0;border:0;border-radius:999px;background:{{ section.settings.dot_inactive }};cursor:pointer;transition:width .2s ease,background .2s ease}
#mg-proof-{{ section.id }} .mg-proof__dot.is-active{width:28px;background:var(--accent)}
#mg-proof-{{ section.id }} .mg-proof__arrows{display:flex;gap:10px}
#mg-proof-{{ section.id }} .mg-proof__arrow{display:grid;place-items:center;width:{{ section.settings.arrow_size_mobile }}px;height:{{ section.settings.arrow_size_mobile }}px;padding:0;border:1px solid var(--accent);border-radius:999px;background:var(--card);color:var(--accent);cursor:pointer}
#mg-proof-{{ section.id }} .mg-proof__arrow svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#mg-proof-{{ section.id }} .mg-proof__cta-wrap{margin-top:{{ section.settings.cta_gap_mobile }}px;text-align:center}
#mg-proof-{{ section.id }} .mg-proof__cta{display:inline-flex;align-items:center;justify-content:center;width:min(100%,{{ section.settings.button_width_mobile }}px);min-height:{{ section.settings.button_height_mobile }}px;padding:14px 28px;border:{{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};border-radius:{{ section.settings.button_radius }}px;{% if section.settings.button_use_gradient %}background:linear-gradient({{ section.settings.button_gradient_angle }}deg,{{ section.settings.button_gradient_1 }},{{ section.settings.button_gradient_2 }});{% else %}background:{{ section.settings.button_bg }};{% endif %}box-shadow:{{ section.settings.button_shadow }};color:{{ section.settings.button_text_color }};font-size:{{ section.settings.button_text_size_mobile }}px;line-height:1;font-weight:900;text-decoration:none}
#mg-proof-{{ section.id }} .mg-proof__guarantee{display:flex;align-items:center;justify-content:center;gap:{{ section.settings.guarantee_icon_gap }}px;width:min(100%,{{ section.settings.button_width_mobile }}px);margin:{{ section.settings.guarantee_gap_mobile }}px auto 0;color:{{ section.settings.guarantee_color }};font-size:{{ section.settings.guarantee_size_mobile }}px;line-height:1.25;font-weight:600}
#mg-proof-{{ section.id }} .mg-proof__guarantee-icon{width:{{ section.settings.guarantee_icon_size_mobile }}px;height:{{ section.settings.guarantee_icon_size_mobile }}px;object-fit:contain}
@media(min-width:750px){#mg-proof-{{ section.id }}{padding:{{ section.settings.padding_top_desktop }}px {{ section.settings.padding_side_desktop }}px {{ section.settings.padding_bottom_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__header{text-align:{{ section.settings.heading_alignment_desktop }}}#mg-proof-{{ section.id }} .mg-proof__heading{font-size:{{ section.settings.heading_size_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__subheading{font-size:{{ section.settings.subheading_size_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__viewport{margin-top:{{ section.settings.carousel_gap_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__track{gap:{{ section.settings.card_gap_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__card{flex-basis:calc((100% - {{ section.settings.card_gap_desktop }}px)/2)}#mg-proof-{{ section.id }} .mg-proof__product-tab{min-height:{{ section.settings.tab_height_desktop }}px;padding:{{ section.settings.tab_padding_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__product-image{width:{{ section.settings.product_image_size_desktop }}px;height:{{ section.settings.product_image_size_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__product-title{font-size:{{ section.settings.product_title_size_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__product-subtext{font-size:{{ section.settings.product_subtext_size_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__controls{margin-top:{{ section.settings.controls_gap_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__arrow{width:{{ section.settings.arrow_size_desktop }}px;height:{{ section.settings.arrow_size_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__cta-wrap{margin-top:{{ section.settings.cta_gap_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__cta{width:min(100%,{{ section.settings.button_width_desktop }}px);min-height:{{ section.settings.button_height_desktop }}px;font-size:{{ section.settings.button_text_size_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__guarantee{width:min(100%,{{ section.settings.button_width_desktop }}px);margin-top:{{ section.settings.guarantee_gap_desktop }}px;font-size:{{ section.settings.guarantee_size_desktop }}px}#mg-proof-{{ section.id }} .mg-proof__guarantee-icon{width:{{ section.settings.guarantee_icon_size_desktop }}px;height:{{ section.settings.guarantee_icon_size_desktop }}px}}
@media(min-width:990px){#mg-proof-{{ section.id }} .mg-proof__card{flex-basis:calc((100% - ({{ section.settings.card_gap_desktop }}px * 2))/3)}}
</style>

<script>
(()=>{const s=document.getElementById('mg-proof-{{ section.id }}');if(!s)return;const t=s.querySelector('[data-mg-proof-track]'),c=[...s.querySelectorAll('[data-mg-proof-card]')],p=s.querySelector('[data-mg-proof-prev]'),n=s.querySelector('[data-mg-proof-next]'),d=s.querySelector('[data-mg-proof-dots]');if(!t||!c.length)return;const step=()=>c[0].getBoundingClientRect().width+parseFloat(getComputedStyle(t).gap||0);const go=i=>t.scrollTo({left:step()*i,behavior:'smooth'});c.forEach((_,i)=>{const b=document.createElement('button');b.type='button';b.className='mg-proof__dot';b.setAttribute('aria-label',`Go to slide ${i+1}`);b.addEventListener('click',()=>go(i));d.appendChild(b)});const dots=[...d.children];const update=()=>{const i=Math.round(t.scrollLeft/step());dots.forEach((x,j)=>x.classList.toggle('is-active',j===i))};p?.addEventListener('click',()=>t.scrollBy({left:-step(),behavior:'smooth'}));n?.addEventListener('click',()=>t.scrollBy({left:step(),behavior:'smooth'}));t.addEventListener('scroll',()=>requestAnimationFrame(update),{passive:true});update()})();
</script>

{% schema %}
{
  "name": "Meowgical Image Proof",
  "tag": "section",
  "class": "section-meowgical-image-proof",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Meowgical community"},
    {"type":"text","id":"heading","label":"Heading","default":"Real Cats. Real Routines. Real Peace of Mind."},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>See how cat parents make SuperTaurine part of their everyday feeding routine.</p>"},
    {"type":"select","id":"heading_alignment_mobile","label":"Heading alignment mobile","default":"center","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}]},
    {"type":"select","id":"heading_alignment_desktop","label":"Heading alignment desktop","default":"center","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}]},
    {"type":"range","id":"max_width","label":"Max width","min":900,"max":1500,"step":20,"unit":"px","default":1180},
    {"type":"range","id":"carousel_gap_mobile","label":"Header to carousel mobile","min":20,"max":70,"step":2,"unit":"px","default":30},
    {"type":"range","id":"carousel_gap_desktop","label":"Header to carousel desktop","min":24,"max":90,"step":2,"unit":"px","default":42},
    {"type":"range","id":"card_width_mobile","label":"Card width mobile","min":72,"max":94,"step":1,"unit":"%","default":84},
    {"type":"range","id":"card_gap_mobile","label":"Card gap mobile","min":10,"max":30,"step":2,"unit":"px","default":14},
    {"type":"range","id":"card_gap_desktop","label":"Card gap desktop","min":14,"max":40,"step":2,"unit":"px","default":24},
    {"type":"select","id":"image_ratio","label":"Image ratio","default":"4 / 5","options":[{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"},{"value":"3 / 4","label":"Tall portrait"}]},
    {"type":"range","id":"card_radius","label":"Card radius","min":8,"max":32,"step":1,"unit":"px","default":20},
    {"type":"range","id":"card_border_width","label":"Card border width","min":0,"max":3,"step":1,"unit":"px","default":1},
    {"type":"text","id":"card_shadow","label":"Card shadow CSS","default":"0 14px 34px rgba(31, 67, 160, 0.08)"},
    {"type":"range","id":"tab_height_mobile","label":"Tab minimum height mobile","min":64,"max":120,"step":2,"unit":"px","default":82},
    {"type":"range","id":"tab_height_desktop","label":"Tab minimum height desktop","min":70,"max":140,"step":2,"unit":"px","default":92},
    {"type":"range","id":"tab_padding_mobile","label":"Tab padding mobile","min":10,"max":28,"step":2,"unit":"px","default":14},
    {"type":"range","id":"tab_padding_desktop","label":"Tab padding desktop","min":12,"max":34,"step":2,"unit":"px","default":16},
    {"type":"range","id":"tab_border_width","label":"Tab border width","min":0,"max":3,"step":1,"unit":"px","default":1},
    {"type":"range","id":"product_image_size_mobile","label":"Product image mobile","min":44,"max":90,"step":2,"unit":"px","default":62},
    {"type":"range","id":"product_image_size_desktop","label":"Product image desktop","min":50,"max":110,"step":2,"unit":"px","default":72},
    {"type":"range","id":"product_title_size_mobile","label":"Product title mobile","min":14,"max":24,"step":1,"unit":"px","default":17},
    {"type":"range","id":"product_title_size_desktop","label":"Product title desktop","min":15,"max":28,"step":1,"unit":"px","default":18},
    {"type":"range","id":"product_subtext_size_mobile","label":"Product subtext mobile","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"product_subtext_size_desktop","label":"Product subtext desktop","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"controls_gap_mobile","label":"Controls spacing mobile","min":12,"max":50,"step":2,"unit":"px","default":20},
    {"type":"range","id":"controls_gap_desktop","label":"Controls spacing desktop","min":16,"max":60,"step":2,"unit":"px","default":24},
    {"type":"range","id":"arrow_size_mobile","label":"Arrow size mobile","min":34,"max":58,"step":2,"unit":"px","default":44},
    {"type":"range","id":"arrow_size_desktop","label":"Arrow size desktop","min":38,"max":66,"step":2,"unit":"px","default":48},
    {"type":"text","id":"button_text","label":"Button text","default":"PROTECT MY CAT TODAY"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"image_picker","id":"guarantee_icon","label":"Guarantee icon"},
    {"type":"text","id":"guarantee_text","label":"Guarantee text","default":"60-day risk-free guarantee"},
    {"type":"checkbox","id":"button_use_gradient","label":"Use gradient button","default":true},
    {"type":"color","id":"button_gradient_1","label":"Gradient color 1","default":"#3E50DC"},
    {"type":"color","id":"button_gradient_2","label":"Gradient color 2","default":"#6695DE"},
    {"type":"range","id":"button_gradient_angle","label":"Gradient angle","min":0,"max":180,"step":5,"unit":"deg","default":135},
    {"type":"color","id":"button_bg","label":"Solid button background","default":"#3E50DC"},
    {"type":"color","id":"button_border_color","label":"Button border","default":"#173FAE"},
    {"type":"range","id":"button_border_width","label":"Button border width","min":0,"max":4,"step":1,"unit":"px","default":1},
    {"type":"range","id":"button_radius","label":"Button radius","min":10,"max":100,"step":1,"unit":"px","default":100},
    {"type":"range","id":"button_width_mobile","label":"Button width mobile","min":220,"max":420,"step":10,"unit":"px","default":330},
    {"type":"range","id":"button_width_desktop","label":"Button width desktop","min":280,"max":720,"step":10,"unit":"px","default":520},
    {"type":"range","id":"button_height_mobile","label":"Button height mobile","min":48,"max":80,"step":2,"unit":"px","default":58},
    {"type":"range","id":"button_height_desktop","label":"Button height desktop","min":52,"max":88,"step":2,"unit":"px","default":64},
    {"type":"range","id":"button_text_size_mobile","label":"Button text mobile","min":14,"max":24,"step":1,"unit":"px","default":18},
    {"type":"range","id":"button_text_size_desktop","label":"Button text desktop","min":16,"max":28,"step":1,"unit":"px","default":20},
    {"type":"text","id":"button_shadow","label":"Button shadow CSS","default":"0 10px 24px rgba(47, 126, 216, 0.24)"},
    {"type":"range","id":"cta_gap_mobile","label":"CTA spacing mobile","min":16,"max":60,"step":2,"unit":"px","default":30},
    {"type":"range","id":"cta_gap_desktop","label":"CTA spacing desktop","min":20,"max":80,"step":2,"unit":"px","default":40},
    {"type":"range","id":"guarantee_gap_mobile","label":"Guarantee spacing mobile","min":4,"max":40,"step":1,"unit":"px","default":12},
    {"type":"range","id":"guarantee_gap_desktop","label":"Guarantee spacing desktop","min":4,"max":50,"step":1,"unit":"px","default":14},
    {"type":"range","id":"guarantee_size_mobile","label":"Guarantee text mobile","min":10,"max":22,"step":1,"unit":"px","default":13},
    {"type":"range","id":"guarantee_size_desktop","label":"Guarantee text desktop","min":11,"max":24,"step":1,"unit":"px","default":14},
    {"type":"range","id":"guarantee_icon_size_mobile","label":"Guarantee icon mobile","min":12,"max":36,"step":1,"unit":"px","default":19},
    {"type":"range","id":"guarantee_icon_size_desktop","label":"Guarantee icon desktop","min":14,"max":42,"step":1,"unit":"px","default":21},
    {"type":"range","id":"guarantee_icon_gap","label":"Guarantee icon gap","min":2,"max":20,"step":1,"unit":"px","default":8},
    {"type":"range","id":"heading_size_mobile","label":"Heading mobile","min":28,"max":56,"step":1,"unit":"px","default":38},
    {"type":"range","id":"heading_size_desktop","label":"Heading desktop","min":38,"max":76,"step":1,"unit":"px","default":54},
    {"type":"range","id":"subheading_size_mobile","label":"Subheading mobile","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"subheading_size_desktop","label":"Subheading desktop","min":14,"max":24,"step":1,"unit":"px","default":18},
    {"type":"range","id":"padding_top_mobile","label":"Top padding mobile","min":20,"max":140,"step":4,"unit":"px","default":48},
    {"type":"range","id":"padding_bottom_mobile","label":"Bottom padding mobile","min":20,"max":140,"step":4,"unit":"px","default":48},
    {"type":"range","id":"padding_side_mobile","label":"Side padding mobile","min":10,"max":30,"step":2,"unit":"px","default":14},
    {"type":"range","id":"padding_top_desktop","label":"Top padding desktop","min":32,"max":180,"step":4,"unit":"px","default":72},
    {"type":"range","id":"padding_bottom_desktop","label":"Bottom padding desktop","min":32,"max":180,"step":4,"unit":"px","default":72},
    {"type":"range","id":"padding_side_desktop","label":"Side padding desktop","min":20,"max":80,"step":4,"unit":"px","default":40},
    {"type":"color","id":"section_bg","label":"Section background","default":"#FBF9F7"},
    {"type":"color","id":"card_bg","label":"Card background","default":"#FFFFFF"},
    {"type":"color","id":"tab_bg","label":"Product tab background","default":"#F1F6FF"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#1C2E66"},
    {"type":"color","id":"text_color","label":"Text","default":"#5E6882"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#3E50DC"},
    {"type":"color","id":"soft_accent","label":"Soft accent","default":"#EDF2FF"},
    {"type":"color","id":"border_color","label":"Border","default":"#C9D5F5"},
    {"type":"color","id":"badge_bg","label":"Badge background","default":"#D8F44C"},
    {"type":"color","id":"badge_text_color","label":"Badge text","default":"#18311F"},
    {"type":"color","id":"dot_inactive","label":"Inactive dots","default":"#D6D6D6"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},
    {"type":"color","id":"guarantee_color","label":"Guarantee","default":"#6A78B8"}
  ],
  "blocks": [
    {"type":"card","name":"Image card","settings":[
      {"type":"image_picker","id":"image","label":"Main image"},
      {"type":"text","id":"image_alt","label":"Image alt text","default":"Cat parent using SuperTaurine"},
      {"type":"text","id":"badge_text","label":"Top badge","default":"Meowgical Member"},
      {"type":"checkbox","id":"show_product_tab","label":"Show product tab","default":true},
      {"type":"image_picker","id":"product_image","label":"Product image"},
      {"type":"text","id":"product_title","label":"Product title","default":"SuperTaurine"},
      {"type":"text","id":"product_subtext","label":"Product subtext","default":"Daily Taurine Support for Cats"},
